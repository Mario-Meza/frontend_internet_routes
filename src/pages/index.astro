---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Rutas">

    <main class="min-h-screen bg-slate-50/60 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- MENSAJE DE NOTIFICACIÓN -->
            <div
                    id="message"
                    class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"
            ></div>

            <!-- CABECERA PRINCIPAL -->
            <header class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="flex h-2.5 w-2.5 rounded-full bg-orange-500 animate-pulse"></span>
                        <span class="text-xs font-bold uppercase tracking-wider text-orange-600">Panel de Control</span>
                    </div>
                    <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Rutas digitales
                    </h1>
                    <p class="mt-1 text-sm text-slate-500">
                        Administra y monitorea el avance de las asignacionese.
                    </p>
                </div>

            </header>

            <!-- TARJETAS RÁPIDAS DE RESUMEN (MÉTRICAS INTUITIVAS) -->
            <div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Rutas</span>
                        <span class="rounded-xl bg-orange-50 p-2 text-orange-600">🗺️</span>
                    </div>
                    <div id="stat-total" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>

                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Asignadas</span>
                        <span class="rounded-xl bg-blue-50 p-2 text-blue-600">📌</span>
                    </div>
                    <div id="stat-assigned" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>

                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">En Proceso</span>
                        <span class="rounded-xl bg-amber-50 p-2 text-amber-600">⚡</span>
                    </div>
                    <div id="stat-progress" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>

                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Completadas</span>
                        <span class="rounded-xl bg-emerald-50 p-2 text-emerald-600">✅</span>
                    </div>
                    <div id="stat-completed" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>
            </div>

            <!-- FILTROS Y BÚSQUEDA -->
            <div class="mb-6 grid gap-4 rounded-2xl bg-white p-4 shadow-sm border border-slate-200/80 md:grid-cols-2">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input
                            id="search"
                            type="search"
                            placeholder="Buscar por técnico o fecha..."
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-3 pl-10 pr-4 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20"
                    />
                </div>

                <div class="relative">
                    <select
                            id="status-filter"
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20"
                    >
                        <option value="">Todos los estados</option>
                        <option value="assigned">Asignadas</option>
                        <option value="in_progress">En proceso</option>
                        <option value="completed">Completadas</option>
                        <option value="canceled">Canceladas</option>
                    </select>
                </div>
            </div>

            <!-- TABLA PRINCIPAL -->
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm border border-slate-200/80">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50/75">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Fecha Programada
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Técnico Asignado
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Servicios
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Estado
                            </th>
                            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">
                                Acciones
                            </th>
                        </tr>
                        </thead>
                        <tbody
                                id="routes-body"
                                class="divide-y divide-slate-100 bg-white"
                        >
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ESTADO VACÍO AMIGABLE -->
            <div
                    id="empty"
                    class="mt-6 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-sm"
            >
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-orange-50 text-3xl shadow-inner">
                    🗺️
                </div>
                <h3 class="mt-4 text-lg font-bold text-slate-900">
                    No encontramos ninguna ruta
                </h3>
                <p class="mt-1 text-sm text-slate-500">
                    Intenta cambiar los términos de búsqueda o ajustar el filtro de estado.
                </p>
            </div>

        </section>

    </main>


    <script>
        import {
            getRoutes,
            getTechnicians,
            updateRouteStatus,
            deleteRoute,
        } from "../services/api";

        import type { Route } from "../types/route";
        import type { Technician } from "../types/technician";

        const routesBody = document.querySelector<HTMLTableSectionElement>("#routes-body");
        const searchInput = document.querySelector<HTMLInputElement>("#search");
        const statusFilter = document.querySelector<HTMLSelectElement>("#status-filter");
        const emptyMessage = document.querySelector<HTMLDivElement>("#empty");
        const message = document.querySelector<HTMLDivElement>("#message");

        // Elementos de Estadísticas
        const statTotal = document.getElementById("stat-total");
        const statAssigned = document.getElementById("stat-assigned");
        const statProgress = document.getElementById("stat-progress");
        const statCompleted = document.getElementById("stat-completed");

        let routes: Route[] = [];
        let technicians: Technician[] = [];

        function escapeHtml(value: string): string {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        function updateStats() {
            if (statTotal) statTotal.textContent = String(routes.length);
            if (statAssigned) statAssigned.textContent = String(routes.filter(r => r.status === "assigned").length);
            if (statProgress) statProgress.textContent = String(routes.filter(r => r.status === "in_progress").length);
            if (statCompleted) statCompleted.textContent = String(routes.filter(r => r.status === "completed").length);
        }

        async function loadData() {
            try {
                const [routesResponse, techniciansResponse] = await Promise.all([
                    getRoutes(),
                    getTechnicians(),
                ]);
                routes = routesResponse;
                technicians = techniciansResponse;
                updateStats();
                renderRoutes();
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudieron cargar las rutas.",
                    true,
                );
            }
        }

        function renderRoutes() {
            if (!routesBody || !emptyMessage) return;

            const query = searchInput?.value.trim().toLowerCase() ?? "";
            const selectedStatus = statusFilter?.value ?? "";

            const filtered = routes.filter((route) => {
                const technician = technicians.find((item) => item.id === route.technician_id);
                const technicianName = technician?.name.toLowerCase() ?? "";
                const formattedDate = formatDate(route.route_date).toLowerCase();
                const technicalDate = route.route_date.toLowerCase();

                const matchesSearch =
                    !query ||
                    technicianName.includes(query) ||
                    formattedDate.includes(query) ||
                    technicalDate.includes(query);

                const matchesStatus = !selectedStatus || route.status === selectedStatus;

                return matchesSearch && matchesStatus;
            });

            routesBody.innerHTML = "";

            if (filtered.length === 0) {
                emptyMessage.classList.remove("hidden");
                return;
            }

            emptyMessage.classList.add("hidden");
            routesBody.innerHTML = filtered.map((route) => routeRow(route)).join("");
            addEvents();
        }

        function routeRow(route: Route): string {
            const technician = technicians.find((item) => item.id === route.technician_id);
            const technicianName = technician?.name ?? "Técnico no encontrado";
            const servicesCount = route.services.length;

            return `
                <tr class="transition-colors hover:bg-slate-50/80">
                    <!-- FECHA -->
                    <td class="px-6 py-4">
 
                        <div class="mt-0.5 text-xs font-medium text-slate-400 tabular-nums">
                            ${escapeHtml(route.route_date)}
                        </div>
                    </td>

                    <!-- TÉCNICO -->
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-xs font-black text-orange-700 shadow-sm ring-1 ring-orange-200">
                                ${escapeHtml(getInitials(technicianName))}
                            </span>
                            <span class="font-semibold text-slate-800">
                                ${escapeHtml(technicianName)}
                            </span>
                        </div>
                    </td>

                    <!-- SERVICIOS -->
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-700">
                            <span class="tabular-nums text-slate-900">${servicesCount}</span>
                            <span>${servicesCount === 1 ? "servicio" : "servicios"}</span>
                        </span>
                    </td>

                    <!-- ESTADO -->
                    <td class="px-6 py-4">
                        ${renderStatus(route.status)}
                    </td>

                    <!-- ACCIONES -->
                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-1.5">
                            <a
                                href="/routes/detail?id=${route.id}"
                                class="inline-flex items-center justify-center gap-1 rounded-xl bg-orange-50 px-3 py-1.5 text-xs font-bold text-orange-700 transition-all hover:bg-orange-100 active:scale-95"
                                title="Ver detalles"
                            >
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <span>Ver</span>
                            </a>

                            ${
                route.status === "assigned"
                    ? `
                                        <a
                                            href="/routes/edit?id=${route.id}"
                                            class="inline-flex items-center justify-center gap-1 rounded-xl bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700 transition-all hover:bg-blue-100 active:scale-95"
                                            title="Editar ruta"
                                        >
                                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                            <span>Editar</span>
                                        </a>
                                    `
                    : ""
            }

                            ${
                route.status === "assigned" || route.status === "in_progress"
                    ? `
                                        <button
                                            type="button"
                                            data-action="cancel"
                                            data-id="${route.id}"
                                            class="inline-flex items-center justify-center gap-1 rounded-xl bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700 transition-all hover:bg-amber-100 active:scale-95"
                                            title="Cancelar ruta"
                                        >
                                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                            </svg>
                                            <span>Cancelar</span>
                                        </button>
                                    `
                    : ""
            }

                            ${
                route.status === "assigned"
                    ? `
                                        <button
                                            type="button"
                                            data-action="delete"
                                            data-id="${route.id}"
                                            class="inline-flex items-center justify-center gap-1 rounded-xl bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 transition-all hover:bg-red-100 active:scale-95"
                                            title="Eliminar registro"
                                        >
                                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                            <span>Eliminar</span>
                                        </button>
                                    `
                    : ""
            }
                        </div>
                    </td>
                </tr>
            `;
        }

        function renderStatus(status: string): string {
            const config: Record<string, { label: string; classes: string }> = {
                assigned: {
                    label: "Asignada",
                    classes: "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20",
                },
                in_progress: {
                    label: "En proceso",
                    classes: "bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20",
                },
                completed: {
                    label: "Completada",
                    classes: "bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20",
                },
                canceled: {
                    label: "Cancelada",
                    classes: "bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20",
                },
            };

            const current = config[status] ?? {
                label: status,
                classes: "bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-500/20",
            };

            return `
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-extrabold whitespace-nowrap ${current.classes}">
                    ${current.label}
                </span>
            `;
        }

        function addEvents() {
            document.querySelectorAll<HTMLButtonElement>("[data-action='cancel']").forEach((button) => {
                button.addEventListener("click", () => cancelRoute(button.dataset.id));
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () => removeRoute(button.dataset.id));
            });
        }

        async function cancelRoute(routeId?: string) {
            if (!routeId) return;

            const confirmed = window.confirm("¿Seguro que deseas cancelar esta ruta?");
            if (!confirmed) return;

            try {
                await updateRouteStatus(routeId, "canceled");
                routes = routes.map((route) => (route.id === routeId ? { ...route, status: "canceled" } : route));
                updateStats();
                renderRoutes();
                showMessage("Ruta cancelada correctamente.", false);
            } catch (error) {
                showMessage(error instanceof Error ? error.message : "No se pudo cancelar la ruta.", true);
            }
        }

        async function removeRoute(routeId?: string) {
            if (!routeId) return;

            const confirmed = window.confirm(
                "¿Seguro que deseas eliminar esta ruta?\n\nEsta acción no se puede deshacer.",
            );
            if (!confirmed) return;

            try {
                await deleteRoute(routeId);
                routes = routes.filter((route) => route.id !== routeId);
                updateStats();
                renderRoutes();
                showMessage("Ruta eliminada correctamente.", false);
            } catch (error) {
                showMessage(error instanceof Error ? error.message : "No se pudo eliminar la ruta.", true);
            }
        }

        function showMessage(text: string, isError: boolean) {
            if (!message) return;
            message.textContent = text;
            message.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-700 shadow-sm";
            message.classList.remove("hidden");
        }

        function formatDate(value: string): string {
            const [year, month, day] = value.split("-");
            const date = new Date(Number(year), Number(month) - 1, Number(day));
            return date.toLocaleDateString("es-MX", {
                day: "2-digit",
                month: "long",
                year: "numeric",
            });
        }

        searchInput?.addEventListener("input", () => {
            renderRoutes();
        });

        statusFilter?.addEventListener("change", () => {
            renderRoutes();
        });

        loadData();
    </script>

</Layout>