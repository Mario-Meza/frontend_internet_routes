---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard - Rutas">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- MENSAJE DE NOTIFICACIÓN TOAST -->
            <div
                    id="message"
                    class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"
            ></div>

            <!-- CABECERA PRINCIPAL -->
            <header class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-orange-500"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-orange-600">Panel de Control</span>
                    </div>
                    <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Rutas digitales
                    </h1>
                    <p class="mt-2 text-base text-slate-500 max-w-xl">
                        Administra, asigna y monitorea el progreso del equipo en campo en tiempo real.
                    </p>
                </div>

                <!-- CONTENEDOR DINÁMICO DE BOTONES -->
                <div id="header-actions" class="flex flex-wrap items-center gap-3">
                    <!-- Los botones se inyectarán aquí mediante JavaScript -->
                </div>
            </header>

            <!-- TARJETAS RÁPIDAS DE RESUMEN -->
            <div class="mb-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                <!-- Tarjeta: Total -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-indigo-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Rutas</span>
                        <div class="flex h-12 w-16 items-center justify-center rounded-xl bg-indigo-50 ring-1 ring-inset ring-indigo-100 overflow-hidden">
                            <svg class="h-11 w-14 overflow-visible" viewBox="0 0 64 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <!-- Ondas de radar de fondo expandiéndose -->
                                <circle cx="32" cy="24" r="14" stroke="#c7d2fe" stroke-width="1.2" fill="none">
                                    <animate attributeName="r" values="4;22;4" dur="2s" repeatCount="indefinite" />
                                    <animate attributeName="opacity" values="0.8;0;0.8" dur="2s" repeatCount="indefinite" />
                                </circle>
                                <circle cx="32" cy="24" r="8" stroke="#a5b4fc" stroke-width="1.2" fill="none">
                                    <animate attributeName="r" values="2;16;2" dur="1.5s" repeatCount="indefinite" />
                                    <animate attributeName="opacity" values="0.9;0;0.9" dur="1.5s" repeatCount="indefinite" />
                                </circle>

                                <!-- Líneas de conexión de rutas parpadeantes -->
                                <g stroke="#818cf8" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 3">
                                    <line x1="32" y1="24" x2="16" y2="14" />
                                    <line x1="32" y1="24" x2="48" y2="14" />
                                    <line x1="32" y1="24" x2="18" y2="36" />
                                    <line x1="32" y1="24" x2="46" y2="36" />
                                </g>

                                <!-- Puntos de destino (Destinos en el mapa) -->
                                <circle cx="16" cy="14" r="3" fill="#6366f1">
                                    <animate attributeName="transform" type="scale" values="1;1.4;1" dur="1s" repeatCount="indefinite" additive="sum" />
                                </circle>
                                <circle cx="48" cy="14" r="2.5" fill="#818cf8" />
                                <circle cx="18" cy="36" r="2.5" fill="#818cf8" />
                                <circle cx="46" cy="36" r="3" fill="#6366f1">
                                    <animate attributeName="transform" type="scale" values="1;1.4;1" dur="1.2s" repeatCount="indefinite" additive="sum" />
                                </circle>

                                <!-- Engranaje central caricaturesco girando (Control/Sistema) -->
                                <g transform="translate(32, 24)">
                                    <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="4s" repeatCount="indefinite" additive="sum" />
                                    <!-- Cuerpo del engranaje -->
                                    <circle cx="0" cy="0" r="7.5" fill="#4f46e5" stroke="#312e81" stroke-width="1.2" />
                                    <!-- Dientes del engranaje -->
                                    <rect x="-1.5" y="-10" width="3" height="3" rx="0.5" fill="#4f46e5" />
                                    <rect x="-1.5" y="7" width="3" height="3" rx="0.5" fill="#4f46e5" />
                                    <rect x="-10" y="-1.5" width="3" height="3" rx="0.5" fill="#4f46e5" />
                                    <rect x="7" y="-1.5" width="3" height="3" rx="0.5" fill="#4f46e5" />
                                    <rect x="-7.5" y="-7.5" width="3" height="3" rx="0.5" fill="#4f46e5" transform="rotate(45)" />
                                    <rect x="4.5" y="-7.5" width="3" height="3" rx="0.5" fill="#4f46e5" transform="rotate(45)" />
                                    <!-- Centro hueco del engranaje -->
                                    <circle cx="0" cy="0" r="3" fill="#ffffff" />
                                </g>
                            </svg>
                        </div>
                    </div>
                    <div id="stat-total" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Asignadas -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-blue-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Asignadas</span>
                        <div class="flex h-12 w-16 items-center justify-center rounded-xl bg-blue-50 ring-1 ring-inset ring-blue-100 overflow-hidden">
                            <svg class="h-11 w-14 overflow-visible" viewBox="0 0 64 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <!-- Destellos de nueva asignación -->
                                <g>
                                    <animate attributeName="opacity" values="0.2;1;0.2" dur="1s" repeatCount="indefinite" />
                                    <circle cx="10" cy="12" r="1.5" fill="#60a5fa" />
                                    <path d="M54 8 L55 10.5 L57.5 11.5 L55 12.5 L54 15 L53 12.5 L50.5 11.5 L53 10.5 Z" fill="#3b82f6" />
                                </g>

                                <!-- Calendario / Tabla de Asignación con flotación suave -->
                                <g>
                                    <animateTransform attributeName="transform" type="translate" values="0,0; 0,-1.5; 0,0" dur="1.2s" repeatCount="indefinite" />

                                    <!-- Sombra inferior del calendario -->
                                    <rect x="13" y="10" width="34" height="33" rx="6" fill="#1e3a8a" opacity="0.15" />

                                    <!-- Cuerpo del calendario -->
                                    <rect x="12" y="8" width="34" height="33" rx="5.5" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" />

                                    <!-- Cabecera azul del calendario -->
                                    <path d="M12 13.5 C12 10.5 14.5 8 17.5 8 L40.5 8 C43.5 8 46 10.5 46 13.5 L46 17 L12 17 Z" fill="#2563eb" />

                                    <!-- Argollas superiores del calendario -->
                                    <rect x="19" y="4.5" width="3.5" height="6.5" rx="1.7" fill="#1e293b" stroke="#ffffff" stroke-width="1" />
                                    <rect x="35.5" y="4.5" width="3.5" height="6.5" rx="1.7" fill="#1e293b" stroke="#ffffff" stroke-width="1" />

                                    <!-- Ícono de check + líneas de servicios programados -->
                                    <circle cx="18.5" cy="23" r="2" fill="#3b82f6" />
                                    <line x1="23" y1="23" x2="35" y2="23" stroke="#93c5fd" stroke-width="2.2" stroke-linecap="round">
                                        <animate attributeName="x2" values="26;35;26" dur="1.2s" repeatCount="indefinite" />
                                    </line>

                                    <circle cx="18.5" cy="29.5" r="2" fill="#3b82f6" />
                                    <line x1="23" y1="29.5" x2="32" y2="29.5" stroke="#bfdbfe" stroke-width="2.2" stroke-linecap="round" />

                                    <circle cx="18.5" cy="36" r="2" fill="#dbeafe" />
                                    <line x1="23" y1="36" x2="29" y2="36" stroke="#dbeafe" stroke-width="2.2" stroke-linecap="round" />
                                </g>

                                <!-- Onda de radar en el punto de entrega -->
                                <ellipse cx="44" cy="38" rx="5" ry="2" stroke="#3b82f6" stroke-width="1.2" fill="none">
                                    <animate attributeName="rx" values="2;7;2" dur="1s" repeatCount="indefinite" />
                                    <animate attributeName="opacity" values="1;0;1" dur="1s" repeatCount="indefinite" />
                                </ellipse>

                                <!-- Pin GPS de Ruta Asignada (Rebotando) -->
                                <g>
                                    <animateTransform attributeName="transform" type="translate" values="0,0; 0,-4; 0,0" dur="0.7s" repeatCount="indefinite" />
                                    <path d="M44 17 C39.5 17 36 20.5 36 25 C36 30.2 44 37.5 44 37.5 C44 37.5 52 30.2 52 25 C52 20.5 48.5 17 44 17 Z" fill="#2563eb" stroke="#1e40af" stroke-width="1.3" stroke-linejoin="round" />
                                    <circle cx="44" cy="24.5" r="3.2" fill="#ffffff" />
                                </g>
                            </svg>
                        </div>
                    </div>
                    <div id="stat-assigned" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: En Proceso -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-orange-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">En Proceso</span>
                        <div class="flex h-12 w-16 items-center justify-center rounded-xl bg-orange-50 ring-1 ring-inset ring-orange-100 overflow-hidden">
                            <svg class="h-10 w-14 overflow-visible" viewBox="0 0 64 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <!-- Carretera en movimiento -->
                                <line x1="2" y1="31" x2="62" y2="31" stroke="#fed7aa" stroke-width="2" stroke-linecap="round" />
                                <line x1="2" y1="31" x2="62" y2="31" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-dasharray="6 6">
                                    <animate attributeName="stroke-dashoffset" from="0" to="24" dur="0.35s" repeatCount="indefinite" />
                                </line>

                                <!-- Líneas de viento / velocidad -->
                                <g stroke="#fb923c" stroke-width="1.6" stroke-linecap="round">
                                    <line x1="2" y1="16" x2="8" y2="16">
                                        <animate attributeName="x1" values="7;1;7" dur="0.45s" repeatCount="indefinite" />
                                        <animate attributeName="x2" values="12;5;12" dur="0.45s" repeatCount="indefinite" />
                                        <animate attributeName="opacity" values="0.2;1;0.2" dur="0.45s" repeatCount="indefinite" />
                                    </line>
                                    <line x1="4" y1="22" x2="9" y2="22">
                                        <animate attributeName="x1" values="9;2;9" dur="0.35s" repeatCount="indefinite" />
                                        <animate attributeName="x2" values="14;6;14" dur="0.35s" repeatCount="indefinite" />
                                        <animate attributeName="opacity" values="1;0.2;1" dur="0.35s" repeatCount="indefinite" />
                                    </line>
                                </g>

                                <!-- Unidad tipo March con escalera avanzando -->
                                <g>
                                    <animateTransform attributeName="transform" type="translate" values="-2,0; 3,0; -2,0" dur="1.1s" repeatCount="indefinite" />

                                    <!-- Carrocería + Escalera (rebote de suspensión) -->
                                    <g>
                                        <animateTransform attributeName="transform" type="translate" values="0,0; 0,-1.8; 0,0; 0,-1.2; 0,0" dur="0.4s" repeatCount="indefinite" />

                                        <!-- Soportes del portaequipajes -->
                                        <rect x="21" y="9" width="2" height="4" fill="#475569" />
                                        <rect x="36" y="9" width="2" height="4" fill="#475569" />

                                        <!-- Escalera telescópica en el techo -->
                                        <rect x="12" y="4.5" width="35" height="4.5" rx="1" fill="#fef08a" stroke="#ca8a04" stroke-width="1.2" />
                                        <line x1="17" y1="4.5" x2="17" y2="9" stroke="#ca8a04" stroke-width="1.2" />
                                        <line x1="22" y1="4.5" x2="22" y2="9" stroke="#ca8a04" stroke-width="1.2" />
                                        <line x1="27" y1="4.5" x2="27" y2="9" stroke="#ca8a04" stroke-width="1.2" />
                                        <line x1="32" y1="4.5" x2="32" y2="9" stroke="#ca8a04" stroke-width="1.2" />
                                        <line x1="37" y1="4.5" x2="37" y2="9" stroke="#ca8a04" stroke-width="1.2" />
                                        <line x1="42" y1="4.5" x2="42" y2="9" stroke="#ca8a04" stroke-width="1.2" />
                                        <!-- Banderola roja trasera -->
                                        <polygon points="12,5 8,7 12,9" fill="#ef4444" />

                                        <!-- Carrocería Hatchback tipo March -->
                                        <path d="M14 25 L14.5 18.5 C15.2 14.5 18 12 22.5 12 L35 12 C39 12 42 14.5 44.5 18 L50.5 19.2 C52.8 19.7 54 21.2 54 23.2 L54 25 C54 25.8 53.3 26.5 52.5 26.5 L15.5 26.5 C14.7 26.5 14 25.8 14 25 Z" fill="#ea580c" stroke="#9a3412" stroke-width="1.3" stroke-linejoin="round" />

                                        <!-- Ventanas -->
                                        <path d="M21.5 14 L29.5 14 L29.5 18.5 L17.5 18.5 C18.2 15.8 19.6 14 21.5 14 Z" fill="#fff7ed" />
                                        <path d="M31.5 14 L35.5 14 C38 14 40.2 15.8 41.8 18.5 L31.5 18.5 Z" fill="#fff7ed" />

                                        <!-- Faro delantero y luz de freno -->
                                        <path d="M51 20.2 L53.8 20.8 L53.8 23 L51 22.5 Z" fill="#fde047" />
                                        <rect x="14" y="19.5" width="2" height="3" rx="0.5" fill="#dc2626" />
                                    </g>

                                    <!-- Llanta Trasera girando -->
                                    <g transform="translate(22, 26.5)">
                                        <circle cx="0" cy="0" r="4.2" fill="#1e293b" />
                                        <circle cx="0" cy="0" r="1.8" fill="#cbd5e1" />
                                        <line x1="-2" y1="0" x2="2" y2="0" stroke="#475569" stroke-width="1.2">
                                            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="0.3s" repeatCount="indefinite" />
                                        </line>
                                    </g>

                                    <!-- Llanta Delantera girando -->
                                    <g transform="translate(45, 26.5)">
                                        <circle cx="0" cy="0" r="4.2" fill="#1e293b" />
                                        <circle cx="0" cy="0" r="1.8" fill="#cbd5e1" />
                                        <line x1="-2" y1="0" x2="2" y2="0" stroke="#475569" stroke-width="1.2">
                                            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="0.3s" repeatCount="indefinite" />
                                        </line>
                                    </g>
                                </g>
                            </svg>
                        </div>
                    </div>
                    <div id="stat-progress" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Completadas -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-green-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Completadas</span>
                        <div class="flex h-12 w-16 items-center justify-center rounded-xl bg-green-50 ring-1 ring-inset ring-green-100 overflow-hidden">
                            <svg class="h-11 w-14 overflow-visible" viewBox="0 0 64 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <!-- Destello verde de "Like" -->
                                <g>
                                    <animate attributeName="opacity" values="0.2;1;0.2" dur="0.9s" repeatCount="indefinite" />
                                    <path d="M53 11 L54 14 L57 15 L54 16 L53 19 L52 16 L49 15 L52 14 Z" fill="#10b981" />
                                    <circle cx="46" cy="11" r="1.3" fill="#34d399" />
                                </g>

                                <!-- Cuerpo / Sudadera negra tipo Inedus -->
                                <path d="M11 47 C11 37.5 16.5 34 26 34 C35.5 34 41 37.5 41 47 Z" fill="#0f172a" stroke="#1e293b" stroke-width="1.2" />
                                <!-- Cuello de la capucha -->
                                <path d="M18 35 Q26 39.5 34 35" stroke="#334155" stroke-width="1.3" fill="none" stroke-linecap="round" />
                                <!-- Detalle de logo blanco en el pecho -->
                                <circle cx="21" cy="41.5" r="1.3" fill="#f8fafc" />
                                <circle cx="23.2" cy="43" r="1.1" fill="#f8fafc" />
                                <line x1="26" y1="42.5" x2="33" y2="42.5" stroke="#f8fafc" stroke-width="1.8" stroke-linecap="round" />

                                <!-- Cabeza del zorrito con animación de asentimiento -->
                                <g>
                                    <animateTransform attributeName="transform" type="translate" values="0,0; 0,-1.4; 0,0" dur="0.9s" repeatCount="indefinite" />

                                    <!-- Orejas puntiagudas -->
                                    <path d="M13 20 L10 5.5 C10 4 11.8 3.5 13 4.8 L21 13.5 Z" fill="#ea580c" stroke="#9a3412" stroke-width="1.2" stroke-linejoin="round" />
                                    <path d="M13.5 17 L12 7.5 L18.5 14 Z" fill="#fdba74" />
                                    <path d="M39 20 L42 5.5 C42 4 40.2 3.5 39 4.8 L31 13.5 Z" fill="#ea580c" stroke="#9a3412" stroke-width="1.2" stroke-linejoin="round" />
                                    <path d="M38.5 17 L40 7.5 L33.5 14 Z" fill="#fdba74" />

                                    <!-- Diadema de los audífonos -->
                                    <path d="M10.5 22 C10.5 9.5 41.5 9.5 41.5 22" stroke="#1e293b" stroke-width="3" stroke-linecap="round" />
                                    <path d="M19 12.2 Q26 10.2 33 12.2" stroke="#10b981" stroke-width="1.8" stroke-linecap="round" />

                                    <!-- Rostro del zorrito -->
                                    <rect x="13" y="13.5" width="26" height="21" rx="10" fill="#f97316" stroke="#c2410c" stroke-width="1.2" />
                                    <!-- Mejillas / Hocico claro -->
                                    <path d="M13.5 25.5 C13.5 21.5 38.5 21.5 38.5 25.5 C38.5 31.5 33 34.5 26 34.5 C19 34.5 13.5 31.5 13.5 25.5 Z" fill="#fed7aa" />

                                    <!-- Auriculares laterales -->
                                    <rect x="8" y="18.5" width="5" height="9.5" rx="2.5" fill="#0f172a" stroke="#334155" stroke-width="1.2" />
                                    <line x1="10" y1="21" x2="10" y2="25.5" stroke="#10b981" stroke-width="1.2" stroke-linecap="round" />
                                    <rect x="39" y="18.5" width="5" height="9.5" rx="2.5" fill="#0f172a" stroke="#334155" stroke-width="1.2" />
                                    <line x1="42" y1="21" x2="42" y2="25.5" stroke="#10b981" stroke-width="1.2" stroke-linecap="round" />

                                    <!-- Visor VR negro -->
                                    <path d="M12 21.5 C12 18 14.5 16.5 17.5 16.5 L34.5 16.5 C37.5 16.5 40 18 40 21.5 L40 23.5 C40 26.2 37.8 27.8 35 27.8 L29.5 27.8 C28 27.8 27.2 26 26 26 C24.8 26 24 27.8 22.5 27.8 L17 27.8 C14.2 27.8 12 26.2 12 23.5 Z" fill="#0f172a" stroke="#475569" stroke-width="1.4" />
                                    <!-- Reflejo neón en el visor -->
                                    <path d="M15.5 18.5 L21.5 18.5 L18.5 25.5 L14 25.5 Z" fill="#10b981" opacity="0.35" />
                                    <line x1="23" y1="19" x2="21" y2="24" stroke="#34d399" stroke-width="1.2" stroke-linecap="round" opacity="0.5" />

                                    <!-- Nariz y sonrisa -->
                                    <ellipse cx="26" cy="28.2" rx="2.8" ry="1.9" fill="#0f172a" />
                                    <path d="M21.5 30.5 Q26 33.5 30.5 30.5" stroke="#9a3412" stroke-width="1.4" stroke-linecap="round" fill="none" />

                                    <!-- Micrófono boom -->
                                    <path d="M41.5 27 Q39.5 32.5 31.5 32.5" stroke="#1e293b" stroke-width="1.6" stroke-linecap="round" fill="none" />
                                    <ellipse cx="31" cy="32.5" rx="2.2" ry="1.4" fill="#0f172a" />
                                </g>

                                <!-- Brazo y mano dando Like (animación de pulgar arriba) -->
                                <g>
                                    <animateTransform attributeName="transform" type="rotate" values="0 43 39; -9 43 39; 0 43 39; -5 43 39; 0 43 39" dur="0.9s" repeatCount="indefinite" />
                                    <!-- Manga de la sudadera -->
                                    <path d="M38 43 L45 36 L49 41 L41 47 Z" fill="#0f172a" stroke="#1e293b" stroke-width="1.1" />
                                    <!-- Pulgar arriba -->
                                    <path d="M46.5 31 L46.5 24 C46.5 22 50 22 50 24 L50 30 Z" fill="#f97316" stroke="#c2410c" stroke-width="1.2" stroke-linejoin="round" />
                                    <!-- Puño del zorrito -->
                                    <rect x="46.5" y="29" width="9" height="8.5" rx="3.2" fill="#f97316" stroke="#c2410c" stroke-width="1.2" />
                                    <!-- Dedos doblados -->
                                    <line x1="51.5" y1="31.8" x2="55" y2="31.8" stroke="#c2410c" stroke-width="1.1" stroke-linecap="round" />
                                    <line x1="51.5" y1="34.6" x2="55" y2="34.6" stroke="#c2410c" stroke-width="1.1" stroke-linecap="round" />
                                </g>
                            </svg>
                        </div>
                    </div>
                    <div id="stat-completed" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>
            </div>

            <!-- FILTROS Y BÚSQUEDA -->
            <div class="mb-6 flex flex-col gap-4 sm:flex-row">
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input
                            id="search"
                            type="search"
                            placeholder="Buscar por técnico o fecha..."
                            class="w-full rounded-xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 text-sm font-medium text-slate-800 placeholder-slate-400 shadow-sm outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                    />
                </div>

                <div class="relative sm:w-64 shrink-0">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                    </span>
                    <select
                            id="status-filter"
                            class="w-full appearance-none rounded-xl border border-slate-300 bg-white py-3.5 pl-11 pr-10 text-sm font-medium text-slate-700 shadow-sm outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 cursor-pointer"
                    >
                        <option value="">Todos los estados</option>
                        <option value="assigned">Asignadas</option>
                        <option value="in_progress">En proceso</option>
                        <option value="completed">Completadas</option>
                        <option value="canceled">Canceladas</option>
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </div>
            </div>

            <!-- TABLA PRINCIPAL (Optimizada para Móvil) -->
            <div class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="hidden bg-slate-50 border-b border-slate-200 md:table-header-group">
                        <tr>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Fecha Programada
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Técnico Asignado
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Servicios
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Estado
                            </th>
                            <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Acciones
                            </th>
                        </tr>
                        </thead>
                        <tbody
                                id="routes-body"
                                class="block divide-y divide-slate-100 bg-white md:table-row-group"
                        >
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ESTADO VACÍO AMIGABLE -->
            <div
                    id="empty"
                    class="mt-8 hidden rounded-2xl border-2 border-dashed border-slate-200 bg-white p-12 text-center shadow-sm sm:p-16"
            >
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                    <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">
                    No encontramos ninguna ruta
                </h3>
                <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                    Intenta cambiar los términos de búsqueda, ajustar los filtros o crear una nueva asignación para tu equipo.
                </p>
                <button onclick="document.getElementById('search').value=''; document.getElementById('search').dispatchEvent(new Event('input'))" class="mt-6 inline-flex items-center text-sm font-semibold text-orange-600 hover:text-orange-700 transition-colors">
                    Limpiar filtros <span aria-hidden="true" class="ml-1">→</span>
                </button>
            </div>

        </section>

        <!-- ============================================== -->
        <!-- MODALES DE CONFIRMACIÓN (Tailwind)             -->
        <!-- ============================================== -->

        <!-- MODAL DE CANCELAR RUTA -->
        <div id="cancel-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4 backdrop-blur-sm transition-opacity">
            <div class="w-full max-w-sm overflow-hidden rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-slate-200/50 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-50 text-amber-500 ring-8 ring-amber-50/50">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-black tracking-tight text-slate-900">¿Suspender ruta?</h3>
                <p class="mt-2 text-sm font-medium text-slate-500 leading-relaxed">
                    Al confirmar, el técnico ya no podrá realizar ni terminar ninguna instalación de esta asignación.
                </p>
                <div class="mt-8 flex flex-col gap-3">
                    <button id="confirm-cancel-btn" class="flex w-full items-center justify-center rounded-xl bg-amber-500 px-5 py-3.5 text-sm font-bold text-white shadow-md shadow-amber-500/20 transition hover:bg-amber-600 active:scale-95">
                        Sí, suspender
                    </button>
                    <button id="close-cancel-btn" class="flex w-full items-center justify-center rounded-xl bg-slate-100 px-5 py-3.5 text-sm font-bold text-slate-700 transition hover:bg-slate-200 active:scale-95">
                        Volver
                    </button>
                </div>
            </div>
        </div>

        <!-- MODAL DE ELIMINAR RUTA -->
        <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4 backdrop-blur-sm transition-opacity">
            <div class="w-full max-w-sm overflow-hidden rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-slate-200/50 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-50 text-red-500 ring-8 ring-red-50/50">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-black tracking-tight text-slate-900">¿Eliminar registro?</h3>
                <p class="mt-2 text-sm font-medium text-slate-500 leading-relaxed">
                    Esta acción borrará la ruta permanentemente de la base de datos y no se podrá deshacer.
                </p>
                <div class="mt-8 flex flex-col gap-3">
                    <button id="confirm-delete-btn" class="flex w-full items-center justify-center rounded-xl bg-red-600 px-5 py-3.5 text-sm font-bold text-white shadow-md shadow-red-500/20 transition hover:bg-red-700 active:scale-95">
                        Eliminar permanentemente
                    </button>
                    <button id="close-delete-btn" class="flex w-full items-center justify-center rounded-xl bg-slate-100 px-5 py-3.5 text-sm font-bold text-slate-700 transition hover:bg-slate-200 active:scale-95">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>

    </main>

    <script>
        import {
            getRoutes,
            getTechnicians,
            updateRouteStatus,
            deleteRoute,
        } from "../services/api";

        import type { Route } from "../types/route";
        import type { Technician } from "../types/technician";

        const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000/api/v1";
        const currentToken = localStorage.getItem("auth_token");

        // ELEMENTOS DOM PARA MODALES
        const headerActions = document.getElementById("header-actions");
        const confirmLogoutBtn = document.getElementById("confirm-logout-btn");

        const cancelModal = document.getElementById("cancel-modal");
        const confirmCancelBtn = document.getElementById("confirm-cancel-btn");
        const closeCancelBtn = document.getElementById("close-cancel-btn");

        const deleteModal = document.getElementById("delete-modal");
        const confirmDeleteBtn = document.getElementById("confirm-delete-btn");
        const closeDeleteBtn = document.getElementById("close-delete-btn");

        let routeIdToActOn: string | null = null;

        function renderHeaderButtons() {
            if (!headerActions) return;

            if (currentToken) {
                headerActions.innerHTML = `
                    <a href="/routes/new" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95 sm:w-auto sm:py-2.5">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Nueva Asignación
                    </a>
                `;

                confirmLogoutBtn?.addEventListener("click", () => {
                    localStorage.removeItem("auth_token");
                    localStorage.removeItem("user_role");
                    window.location.href = "/login";
                });
            } else {
                window.location.href = "/login";
            }
        }

        renderHeaderButtons();


        // LOGICA TABLA Y DATOS
        const routesBody = document.querySelector<HTMLTableSectionElement>("#routes-body");
        const searchInput = document.querySelector<HTMLInputElement>("#search");
        const statusFilter = document.querySelector<HTMLSelectElement>("#status-filter");
        const emptyMessage = document.querySelector<HTMLDivElement>("#empty");
        const message = document.querySelector<HTMLDivElement>("#message");

        const statTotal = document.getElementById("stat-total");
        const statAssigned = document.getElementById("stat-assigned");
        const statProgress = document.getElementById("stat-progress");
        const statCompleted = document.getElementById("stat-completed");

        let routes: Route[] = [];
        let technicians: Technician[] = [];

        function escapeHtml(value: string): string {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        function getAvatarColor(name: string): string {
            const colors = [
                'bg-blue-100 text-blue-700', 'bg-indigo-100 text-indigo-700',
                'bg-violet-100 text-violet-700', 'bg-fuchsia-100 text-fuchsia-700',
                'bg-pink-100 text-pink-700', 'bg-rose-100 text-rose-700'
            ];
            const charCode = name.charCodeAt(0) || 0;
            return colors[charCode % colors.length];
        }

        function updateStats() {
            if (statTotal) statTotal.textContent = String(routes.length);
            if (statAssigned) statAssigned.textContent = String(routes.filter(r => r.status === "assigned").length);
            if (statProgress) statProgress.textContent = String(routes.filter(r => r.status === "in_progress").length);
            if (statCompleted) statCompleted.textContent = String(routes.filter(r => r.status === "completed").length);
        }

        async function loadData() {
            try {
                const [routesResponse, techniciansResponse] = await Promise.all([
                    getRoutes(),
                    getTechnicians(),
                ]);
                routes = routesResponse;
                technicians = techniciansResponse;
                updateStats();
                renderRoutes();
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudieron cargar las rutas.",
                    true,
                );
            }
        }

        function renderRoutes() {
            if (!routesBody || !emptyMessage) return;

            const query = searchInput?.value.trim().toLowerCase() ?? "";
            const selectedStatus = statusFilter?.value ?? "";

            const filtered = routes.filter((route) => {
                const technician = technicians.find((item) => item.id === route.technician_id);
                const technicianName = technician?.name.toLowerCase() ?? "";
                const formattedDate = formatDate(route.route_date).toLowerCase();
                const technicalDate = route.route_date.toLowerCase();

                const matchesSearch =
                    !query ||
                    technicianName.includes(query) ||
                    formattedDate.includes(query) ||
                    technicalDate.includes(query);

                const matchesStatus = !selectedStatus || route.status === selectedStatus;

                return matchesSearch && matchesStatus;
            });

            routesBody.innerHTML = "";

            if (filtered.length === 0) {
                emptyMessage.classList.remove("hidden");
                return;
            }

            emptyMessage.classList.add("hidden");
            routesBody.innerHTML = filtered.map((route) => routeRow(route)).join("");
            addTableEvents();
        }

        function routeRow(route: Route): string {
            const technician = technicians.find((item) => item.id === route.technician_id) as Technician & { photo_url?: string | null; photo?: string | null } | undefined;
            const technicianName = technician?.name ?? "Técnico no encontrado";
            const servicesCount = route.services.length;
            const avatarColor = getAvatarColor(technicianName);

            let avatarHtml = '';
            if (technician) {
                const photoUrl = technician.photo_url || technician.photo || `${API_URL}/technicians/${technician.id}/photo`;
                avatarHtml = `
                    <img
                        src="${escapeHtml(photoUrl)}"
                        alt="${escapeHtml(technicianName)}"
                        class="h-10 w-10 shrink-0 rounded-full object-cover ring-2 ring-white shadow-sm"
                        onerror="this.onerror=null; this.replaceWith(Object.assign(document.createElement('span'), {className: 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white', textContent: '${getInitials(technicianName)}'}));"
                    />
                `;
            } else {
                avatarHtml = `
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white">
                        ${escapeHtml(getInitials(technicianName))}
                    </span>
                 `;
            }

            // OBTENER ARREGLO DE ESPECIALIDADES
            const specialtiesArray = technician?.specialties && technician.specialties.length > 0
                ? technician.specialties
                : ["General"];

            // CREAR BADGES
            const badgesHtml = specialtiesArray.map(spec => `
                <div class="inline-flex items-center gap-1 rounded-md bg-orange-50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-orange-600 ring-1 ring-inset ring-orange-600/20">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    ${escapeHtml(spec)}
                </div>
            `).join('');

            return `
                <tr class="group block border-b border-slate-100 p-4 transition-colors hover:bg-slate-50 md:table-row md:border-b-0 md:p-0">
                    
                    <td data-label="Fecha" class="flex items-center justify-between py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                        <div class="flex items-center gap-3">
                            <div class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500 md:flex">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <span class="text-sm font-semibold text-slate-700 tabular-nums">
                                ${escapeHtml(formatDate(route.route_date))}
                            </span>
                        </div>
                    </td>

                    <td data-label="Técnico" class="flex items-center justify-between py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                        <div class="flex items-center gap-4">
                            ${avatarHtml}
                            <div>
                                <div class="text-sm font-bold text-slate-800">
                                    ${escapeHtml(technicianName)}
                                </div>
                                <div class="mt-1.5 flex flex-wrap gap-1.5">
                                    ${badgesHtml}
                                </div>
                            </div>
                        </div>
                    </td>

                    <td data-label="Servicios" class="flex items-center justify-between py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                        <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-200">
                            <span class="text-slate-900">${servicesCount}</span>
                            <span>${servicesCount === 1 ? "Visita" : "Visitas"}</span>
                        </span>
                    </td>

                    <td data-label="Estado" class="flex items-center justify-between py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                        ${renderStatus(route.status)}
                    </td>

                    <td class="mt-4 flex justify-end border-t border-slate-100 pt-4 md:mt-0 md:table-cell md:border-0 md:px-6 md:py-5 md:pt-5">
                        <div class="flex items-center gap-2 transition-opacity md:opacity-80 md:group-hover:opacity-100">
                            <a
                                href="/routes/detail?id=${route.id}"
                                class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-indigo-600 active:scale-95 md:p-2"
                                title="Ver detalles completos"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </a>

                            ${
                route.status === "assigned"
                    ? `
                                        <a
                                            href="/routes/edit?id=${route.id}"
                                            class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-blue-600 active:scale-95 md:p-2"
                                            title="Editar asignación"
                                        >
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </a>
                                    `
                    : ""
            }

                            ${
                route.status === "assigned" || route.status === "in_progress"
                    ? `
                                        <button
                                            type="button"
                                            data-action="cancel"
                                            data-id="${route.id}"
                                            class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-amber-600 active:scale-95 md:p-2"
                                            title="Suspender/Cancelar ruta"
                                        >
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                            </svg>
                                        </button>
                                    `
                    : ""
            }

                            ${
                route.status === "assigned"
                    ? `
                                        <button
                                            type="button"
                                            data-action="delete"
                                            data-id="${route.id}"
                                            class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-red-50 hover:text-red-600 hover:ring-red-200 active:scale-95 md:p-2"
                                            title="Eliminar permanentemente"
                                        >
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    `
                    : ""
            }
                        </div>
                    </td>
                </tr>
            `;
        }

        function renderStatus(status: string): string {


            if (status === "completed") {
                return `
                    <span class="inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1 text-[10px] font-bold text-green-700 ring-1 ring-inset ring-green-600/20 md:text-xs">
                        
                        <span>Completada</span>
                    </span>
                `;
            }

            const config: Record<string, { label: string; bg: string; dot: string; text: string; border: string }> = {
                canceled: { label: "Cancelada", bg: "bg-red-50", dot: "bg-red-500", text: "text-red-700", border: "ring-red-600/20" },
            };
            const current = config[status] ?? { label: status, bg: "bg-slate-100", dot: "bg-slate-400", text: "text-slate-600", border: "ring-slate-500/20" };

            return `
                <span class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[10px] font-bold md:text-xs ${current.bg} ${current.text} ring-1 ring-inset ${current.border}">
                    <span class="h-1.5 w-1.5 rounded-full ${current.dot}"></span>
                    ${current.label}
                </span>
            `;
        }


        // ==============================================
        // LÓGICA DE EVENTOS DE BOTONES Y MODALES DE LA TABLA
        // ==============================================
        function addTableEvents() {
            document.querySelectorAll<HTMLButtonElement>("[data-action='cancel']").forEach((button) => {
                button.addEventListener("click", () => {
                    routeIdToActOn = button.dataset.id || null;
                    cancelModal?.classList.remove("hidden");
                });
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () => {
                    routeIdToActOn = button.dataset.id || null;
                    deleteModal?.classList.remove("hidden");
                });
            });
        }

        // Eventos para ocultar modales
        closeCancelBtn?.addEventListener("click", () => cancelModal?.classList.add("hidden"));
        closeDeleteBtn?.addEventListener("click", () => deleteModal?.classList.add("hidden"));

        // Evento: Confirmar Cancelar
        confirmCancelBtn?.addEventListener("click", async () => {
            if (!routeIdToActOn) return;
            cancelModal?.classList.add("hidden");

            try {
                await updateRouteStatus(routeIdToActOn, "canceled");
                routes = routes.map((route) => (route.id === routeIdToActOn ? { ...route, status: "canceled" } : route));
                updateStats();
                renderRoutes();
                showMessage("Ruta suspendida correctamente.", false);
            } catch (error) {
                showMessage(error instanceof Error ? error.message : "No se pudo cancelar la ruta.", true);
            }
        });

        // Evento: Confirmar Eliminar
        confirmDeleteBtn?.addEventListener("click", async () => {
            if (!routeIdToActOn) return;
            deleteModal?.classList.add("hidden");

            try {
                await deleteRoute(routeIdToActOn);
                routes = routes.filter((route) => route.id !== routeIdToActOn);
                updateStats();
                renderRoutes();
                showMessage("Asignación eliminada permanentemente.", false);
            } catch (error) {
                showMessage(error instanceof Error ? error.message : "Error al intentar eliminar.", true);
            }
        });

        function showMessage(text: string, isError: boolean) {
            if (!message) return;
            message.innerHTML = `
                <div class="flex items-center gap-3">
                    ${isError
                ? `<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                : `<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            }
                    <p>${text}</p>
                </div>
            `;
            message.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800 shadow-sm";
            message.classList.remove("hidden");

            setTimeout(() => {
                message.classList.add("hidden");
            }, 4000);
        }

        function formatDate(value: string): string {
            const [year, month, day] = value.split("-");
            const date = new Date(Number(year), Number(month) - 1, Number(day));
            return date.toLocaleDateString("es-MX", { day: "2-digit", month: "short" }).replace('.', '');
        }

        searchInput?.addEventListener("input", () => renderRoutes());
        statusFilter?.addEventListener("change", () => renderRoutes());

        if (currentToken) loadData();
    </script>
</Layout>