---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Dashboard - Rutas">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- MENSAJE DE NOTIFICACIÓN -->
            <div
                    id="message"
                    class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"
            ></div>

            <!-- CABECERA PRINCIPAL -->
            <header class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-orange-500"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-orange-600">Panel de Control</span>
                    </div>
                    <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Rutas digitales
                    </h1>
                    <p class="mt-2 text-base text-slate-500 max-w-xl">
                        Administra, asigna y monitorea el progreso del equipo en campo en tiempo real.
                    </p>
                </div>

                <!-- CONTENEDOR DINÁMICO DE BOTONES -->
                <div id="header-actions" class="flex flex-wrap items-center gap-3">
                    <!-- Los botones se inyectarán aquí mediante JavaScript -->
                </div>
            </header>

            <!-- TARJETAS RÁPIDAS DE RESUMEN (MÉTRICAS INTUITIVAS) -->
            <div class="mb-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                <!-- Tarjeta: Total -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Rutas</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-inset ring-indigo-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-total" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Asignadas -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Asignadas</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 ring-1 ring-inset ring-blue-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-assigned" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: En Proceso -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg hover:ring-orange-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">En Proceso</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-50 text-orange-600 ring-1 ring-inset ring-orange-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-progress" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Completadas -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg hover:ring-green-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Completadas</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-50 text-green-600 ring-1 ring-inset ring-green-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-completed" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>
            </div>

            <!-- FILTROS Y BÚSQUEDA -->
            <div class="mb-6 flex flex-col gap-4 sm:flex-row">
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input
                            id="search"
                            type="search"
                            placeholder="Buscar por técnico o fecha (Ej. Mario o 2026)..."
                            class="w-full rounded-xl border border-slate-200 bg-white py-3.5 pl-11 pr-4 text-sm text-slate-800 placeholder-slate-400 shadow-sm outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                    />
                </div>

                <div class="relative sm:w-64 shrink-0">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                    </span>
                    <select
                            id="status-filter"
                            class="w-full appearance-none rounded-xl border border-slate-200 bg-white py-3.5 pl-11 pr-10 text-sm font-medium text-slate-700 shadow-sm outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 cursor-pointer"
                    >
                        <option value="">Todos los estados</option>
                        <option value="assigned">Asignadas</option>
                        <option value="in_progress">En proceso</option>
                        <option value="completed">Completadas</option>
                        <option value="canceled">Canceladas</option>
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-slate-400">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </div>
            </div>

            <!-- TABLA PRINCIPAL -->
            <div class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] ring-1 ring-slate-200/50">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Fecha Programada
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Técnico Asignado
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Servicios
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Estado
                            </th>
                            <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Acciones
                            </th>
                        </tr>
                        </thead>
                        <tbody
                                id="routes-body"
                                class="divide-y divide-slate-100 bg-white"
                        >
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ESTADO VACÍO AMIGABLE -->
            <div
                    id="empty"
                    class="mt-8 hidden rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center shadow-sm"
            >
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                    <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">
                    No encontramos ninguna ruta
                </h3>
                <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                    Intenta cambiar los términos de búsqueda, ajustar los filtros o crear una nueva asignación para tu equipo.
                </p>
                <button onclick="document.getElementById('search').focus()" class="mt-6 inline-flex items-center text-sm font-semibold text-orange-600 hover:text-orange-700">
                    Limpiar filtros <span aria-hidden="true" class="ml-1">→</span>
                </button>
            </div>

        </section>

    </main>


    <script>
        import {
            getRoutes,
            getTechnicians,
            updateRouteStatus,
            deleteRoute,
        } from "../services/api";

        import type { Route } from "../types/route";
        import type { Technician } from "../types/technician";

        // LÓGICA DE BOTONES DINÁMICOS EN HEADER
        const headerActions = document.getElementById("header-actions");
        const currentToken = localStorage.getItem("auth_token");

        function renderHeaderButtons() {
            if (!headerActions) return;

            if (currentToken) {
                // SI HAY SESIÓN: Mostrar botones de admin
                headerActions.innerHTML = `
                    <button id="btn-logout" class="flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-slate-600 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-red-50 hover:text-red-600 hover:ring-red-200" title="Cerrar sesión">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        <span>Cerrar sesión</span>
                    </button>

                    <a href="/routes/new" class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                        Crear Asignación
                    </a>
                `;

                // Asignar evento de cerrar sesión
                document.getElementById("btn-logout")?.addEventListener("click", () => {
                    localStorage.removeItem("auth_token");
                    localStorage.removeItem("user_role");
                    window.location.href = "/login";
                });
            } else {
                window.location.href = "/login";
            }
        }

        renderHeaderButtons();


        const routesBody = document.querySelector<HTMLTableSectionElement>("#routes-body");
        const searchInput = document.querySelector<HTMLInputElement>("#search");
        const statusFilter = document.querySelector<HTMLSelectElement>("#status-filter");
        const emptyMessage = document.querySelector<HTMLDivElement>("#empty");
        const message = document.querySelector<HTMLDivElement>("#message");

        // Elementos de Estadísticas
        const statTotal = document.getElementById("stat-total");
        const statAssigned = document.getElementById("stat-assigned");
        const statProgress = document.getElementById("stat-progress");
        const statCompleted = document.getElementById("stat-completed");

        let routes: Route[] = [];
        let technicians: Technician[] = [];

        function escapeHtml(value: string): string {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        function getAvatarColor(name: string): string {
            const colors = [
                'bg-blue-100 text-blue-700',
                'bg-indigo-100 text-indigo-700',
                'bg-violet-100 text-violet-700',
                'bg-fuchsia-100 text-fuchsia-700',
                'bg-pink-100 text-pink-700',
                'bg-rose-100 text-rose-700'
            ];
            // Lógica simple para que siempre le toque el mismo color al mismo técnico basado en la primera letra
            const charCode = name.charCodeAt(0) || 0;
            return colors[charCode % colors.length];
        }

        function updateStats() {
            if (statTotal) statTotal.textContent = String(routes.length);
            if (statAssigned) statAssigned.textContent = String(routes.filter(r => r.status === "assigned").length);
            if (statProgress) statProgress.textContent = String(routes.filter(r => r.status === "in_progress").length);
            if (statCompleted) statCompleted.textContent = String(routes.filter(r => r.status === "completed").length);
        }

        async function loadData() {
            try {
                const [routesResponse, techniciansResponse] = await Promise.all([
                    getRoutes(),
                    getTechnicians(),
                ]);
                routes = routesResponse;
                technicians = techniciansResponse;
                updateStats();
                renderRoutes();
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudieron cargar las rutas.",
                    true,
                );
            }
        }

        function renderRoutes() {
            if (!routesBody || !emptyMessage) return;

            const query = searchInput?.value.trim().toLowerCase() ?? "";
            const selectedStatus = statusFilter?.value ?? "";

            const filtered = routes.filter((route) => {
                const technician = technicians.find((item) => item.id === route.technician_id);
                const technicianName = technician?.name.toLowerCase() ?? "";
                const formattedDate = formatDate(route.route_date).toLowerCase();
                const technicalDate = route.route_date.toLowerCase();

                const matchesSearch =
                    !query ||
                    technicianName.includes(query) ||
                    formattedDate.includes(query) ||
                    technicalDate.includes(query);

                const matchesStatus = !selectedStatus || route.status === selectedStatus;

                return matchesSearch && matchesStatus;
            });

            routesBody.innerHTML = "";

            if (filtered.length === 0) {
                emptyMessage.classList.remove("hidden");
                return;
            }

            emptyMessage.classList.add("hidden");
            routesBody.innerHTML = filtered.map((route) => routeRow(route)).join("");
            addEvents();
        }

        function routeRow(route: Route): string {
            const technician = technicians.find((item) => item.id === route.technician_id);
            const technicianName = technician?.name ?? "Técnico no encontrado";
            const servicesCount = route.services.length;
            const avatarColor = getAvatarColor(technicianName);

            return `
                <tr class="group transition-colors hover:bg-slate-50">
                    <!-- FECHA -->
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <span class="text-sm font-semibold text-slate-700 tabular-nums">
                                ${escapeHtml(formatDate(route.route_date))}
                            </span>
                        </div>
                    </td>

                    <!-- TÉCNICO -->
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white">
                                ${escapeHtml(getInitials(technicianName))}
                            </span>
                            <span class="text-sm font-bold text-slate-800">
                                ${escapeHtml(technicianName)}
                            </span>
                        </div>
                    </td>

                    <!-- SERVICIOS -->
                    <td class="px-6 py-5">
                        <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-200">
                            <span class="text-slate-900">${servicesCount}</span>
                            <span>${servicesCount === 1 ? "Visita" : "Visitas"}</span>
                        </span>
                    </td>

                    <!-- ESTADO -->
                    <td class="px-6 py-5">
                        ${renderStatus(route.status)}
                    </td>

                    <!-- ACCIONES -->
                    <td class="px-6 py-5">
                        <div class="flex items-center justify-end gap-2 opacity-80 transition-opacity group-hover:opacity-100">
                            <a
                                href="/routes/detail?id=${route.id}"
                                class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-indigo-600 active:scale-95"
                                title="Ver detalles completos"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </a>

                            ${
                route.status === "assigned"
                    ? `
                                        <a
                                            href="/routes/edit?id=${route.id}"
                                            class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-blue-600 active:scale-95"
                                            title="Editar asignación"
                                        >
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </a>
                                    `
                    : ""
            }

                            ${
                route.status === "assigned" || route.status === "in_progress"
                    ? `
                                        <button
                                            type="button"
                                            data-action="cancel"
                                            data-id="${route.id}"
                                            class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-amber-600 active:scale-95"
                                            title="Suspender/Cancelar ruta"
                                        >
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                            </svg>
                                        </button>
                                    `
                    : ""
            }

                            ${
                route.status === "assigned"
                    ? `
                                        <button
                                            type="button"
                                            data-action="delete"
                                            data-id="${route.id}"
                                            class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-red-50 hover:text-red-600 hover:ring-red-200 active:scale-95"
                                            title="Eliminar permanentemente"
                                        >
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    `
                    : ""
            }
                        </div>
                    </td>
                </tr>
            `;
        }

        function renderStatus(status: string): string {
            const config: Record<string, { label: string; bg: string; dot: string; text: string; border: string }> = {
                assigned: {
                    label: "Asignada",
                    bg: "bg-blue-50",
                    dot: "bg-blue-500",
                    text: "text-blue-700",
                    border: "ring-blue-600/20"
                },
                in_progress: {
                    label: "En proceso",
                    bg: "bg-orange-50",
                    dot: "bg-orange-500 animate-pulse",
                    text: "text-orange-700",
                    border: "ring-orange-600/20"
                },
                completed: {
                    label: "Completada",
                    bg: "bg-green-50",
                    dot: "bg-green-500",
                    text: "text-green-700",
                    border: "ring-green-600/20"
                },
                canceled: {
                    label: "Cancelada",
                    bg: "bg-red-50",
                    dot: "bg-red-500",
                    text: "text-red-700",
                    border: "ring-red-600/20"
                },
            };

            const current = config[status] ?? {
                label: status,
                bg: "bg-slate-100",
                dot: "bg-slate-400",
                text: "text-slate-600",
                border: "ring-slate-500/20"
            };

            return `
                <span class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-bold ${current.bg} ${current.text} ring-1 ring-inset ${current.border}">
                    <span class="h-1.5 w-1.5 rounded-full ${current.dot}"></span>
                    ${current.label}
                </span>
            `;
        }

        function addEvents() {
            document.querySelectorAll<HTMLButtonElement>("[data-action='cancel']").forEach((button) => {
                button.addEventListener("click", () => cancelRoute(button.dataset.id));
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () => removeRoute(button.dataset.id));
            });
        }

        async function cancelRoute(routeId?: string) {
            if (!routeId) return;

            const confirmed = window.confirm("¿Seguro que deseas cancelar esta asignación?\n\nEl técnico ya no podrá trabajar en ella.");
            if (!confirmed) return;

            try {
                await updateRouteStatus(routeId, "canceled");
                routes = routes.map((route) => (route.id === routeId ? { ...route, status: "canceled" } : route));
                updateStats();
                renderRoutes();
                showMessage("Ruta suspendida correctamente.", false);
            } catch (error) {
                showMessage(error instanceof Error ? error.message : "No se pudo cancelar la ruta.", true);
            }
        }

        async function removeRoute(routeId?: string) {
            if (!routeId) return;

            const confirmed = window.confirm(
                "¿Estás completamente seguro de eliminar este registro?\n\nEsta acción es destructiva y no se puede recuperar la información.",
            );
            if (!confirmed) return;

            try {
                await deleteRoute(routeId);
                routes = routes.filter((route) => route.id !== routeId);
                updateStats();
                renderRoutes();
                showMessage("Asignación eliminada de la base de datos.", false);
            } catch (error) {
                showMessage(error instanceof Error ? error.message : "Error al intentar eliminar.", true);
            }
        }

        function showMessage(text: string, isError: boolean) {
            if (!message) return;
            message.innerHTML = `
                <div class="flex items-center gap-3">
                    ${isError
                ? `<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                : `<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            }
                    <p>${text}</p>
                </div>
            `;
            message.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800 shadow-sm";
            message.classList.remove("hidden");

            // Ocultar mensaje automáticamente después de 4 segundos
            setTimeout(() => {
                message.classList.add("hidden");
            }, 4000);
        }

        function formatDate(value: string): string {
            const [year, month, day] = value.split("-");
            const date = new Date(Number(year), Number(month) - 1, Number(day));
            // Formateamos corto para la tabla (ej. 24 Oct)
            return date.toLocaleDateString("es-MX", {
                day: "2-digit",
                month: "short",
            }).replace('.', ''); // Quitar punto si abrevia el mes
        }

        searchInput?.addEventListener("input", () => {
            renderRoutes();
        });

        statusFilter?.addEventListener("change", () => {
            renderRoutes();
        });

        // Aseguramos que la tabla solo se llene si hay token de admin
        if (currentToken) {
            loadData();
        }
    </script>

</Layout>