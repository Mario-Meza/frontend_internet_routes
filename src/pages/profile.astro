---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mi Perfil - Administrador">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- CABECERA HOMOLOGADA -->
            <header class="mb-8">
                <div class="flex items-center gap-2 mb-2">
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-orange-500"></span>
                    </span>
                    <span class="text-xs font-bold uppercase tracking-widest text-orange-600">Cuenta Administrativa</span>
                </div>

                <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                    Configuración de cuenta
                </h1>
                <p class="mt-2 text-base text-slate-500 max-w-xl">
                    Administra tu información personal, credenciales de acceso y parámetros de seguridad.
                </p>
            </header>

            <!-- MENSAJES DE NOTIFICACIÓN -->
            <div id="error-message" class="mb-6 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700 shadow-sm"></div>
            <div id="success-message" class="mb-6 hidden rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-700 shadow-sm"></div>

            <!-- FORMULARIO -->
            <form
                    id="profile-form"
                    class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50"
            >
                <!-- SECCIÓN 1: DATOS PERSONALES -->
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-5">
                    <div class="flex items-center gap-3">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-orange-600">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                            </svg>
                        </span>
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">
                                1. Información Básica
                            </h2>
                            <p class="text-xs font-medium text-slate-500">
                                Datos principales de identificación del administrador.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="grid gap-6 px-6 py-8 md:grid-cols-2 border-b border-slate-100">
                    <div>
                        <label for="name" class="mb-2 block text-sm font-bold text-slate-700">
                            Nombre del Administrador
                        </label>
                        <input
                                id="name"
                                type="text"
                                required
                                maxlength="100"
                                placeholder="Tu nombre..."
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                        />
                    </div>

                    <div>
                        <label for="email" class="mb-2 block text-sm font-bold text-slate-700">
                            Correo Electrónico (Usuario de acceso)
                        </label>
                        <input
                                id="email"
                                type="email"
                                required
                                placeholder="admin@rutasdigitales.com"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                        />
                    </div>
                </div>

                <!-- SECCIÓN 2: SEGURIDAD Y CONTRASEÑA -->
                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-5">
                    <div class="flex items-center gap-3">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </span>
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">
                                2. Seguridad y Contraseña
                            </h2>
                            <p class="text-xs font-medium text-slate-500">
                                Deja los campos de nueva contraseña en blanco si no deseas cambiarla.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="grid gap-6 px-6 py-8 md:grid-cols-2">
                    <div class="md:col-span-2">
                        <label for="current-password" class="mb-2 block text-sm font-bold text-slate-700">
                            Contraseña Actual <span class="font-normal text-slate-400">(Requerida para autorizar cambios)</span>
                        </label>
                        <input
                                id="current-password"
                                type="password"
                                required
                                placeholder="••••••••"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                        />
                    </div>

                    <div>
                        <label for="new-password" class="mb-2 block text-sm font-bold text-slate-700">
                            Nueva Contraseña
                        </label>
                        <input
                                id="new-password"
                                type="password"
                                minlength="6"
                                placeholder="Opcional (mínimo 6 caracteres)"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                        />
                    </div>

                    <div>
                        <label for="confirm-password" class="mb-2 block text-sm font-bold text-slate-700">
                            Confirmar Nueva Contraseña
                        </label>
                        <input
                                id="confirm-password"
                                type="password"
                                minlength="6"
                                placeholder="Opcional"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm text-slate-900 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                        />
                    </div>
                </div>

                <!-- FOOTER / BOTONES DE ACCIÓN -->
                <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-5 sm:flex sm:items-center sm:justify-end sm:gap-3 sm:px-8">
                    <a
                            href="/"
                            class="mb-3 inline-flex w-full items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.98] sm:mb-0 sm:w-auto"
                    >
                        Cancelar
                    </a>

                    <button
                            id="save-btn"
                            type="submit"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                    >
                        Guardar cambios
                    </button>
                </div>

            </form>

        </section>

    </main>

    <script>
        import { getAdminProfile, updateAdminProfile } from "../services/api";

        const form = document.querySelector<HTMLFormElement>("#profile-form");
        const nameInput = document.querySelector<HTMLInputElement>("#name");
        const emailInput = document.querySelector<HTMLInputElement>("#email");

        const currentPasswordInput = document.querySelector<HTMLInputElement>("#current-password");
        const newPasswordInput = document.querySelector<HTMLInputElement>("#new-password");
        const confirmPasswordInput = document.querySelector<HTMLInputElement>("#confirm-password");

        const saveBtn = document.querySelector<HTMLButtonElement>("#save-btn");

        const errorMessage = document.querySelector<HTMLDivElement>("#error-message");
        const successMessage = document.querySelector<HTMLDivElement>("#success-message");

        function showError(message: string) {
            if (!errorMessage) return;
            errorMessage.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <p>${message}</p>
                </div>
            `;
            errorMessage.classList.remove("hidden");
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function showSuccess(message: string) {
            if (!successMessage) return;
            successMessage.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <p>${message}</p>
                </div>
            `;
            successMessage.classList.remove("hidden");

            setTimeout(() => {
                successMessage.classList.add("hidden");
            }, 4000);

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hideMessages() {
            errorMessage?.classList.add("hidden");
            successMessage?.classList.add("hidden");
        }

        async function loadProfile() {
            try {
                const profile = await getAdminProfile();

                if (nameInput) nameInput.value = profile.name || "";
                if (emailInput) emailInput.value = profile.email || "";

            } catch (error) {
                showError("No se pudieron cargar tus datos. Revisa tu conexión.");
                if (saveBtn) saveBtn.disabled = true;
            }
        }

        form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            hideMessages();

            const name = nameInput?.value.trim() || "";
            const email = emailInput?.value.trim() || "";
            const currentPassword = currentPasswordInput?.value || "";
            const newPassword = newPasswordInput?.value || "";
            const confirmPassword = confirmPasswordInput?.value || "";

            if (!name || !email || !currentPassword) {
                showError("El nombre, correo y tu contraseña actual son obligatorios.");
                return;
            }

            if (newPassword || confirmPassword) {
                if (newPassword.length < 6) {
                    showError("La nueva contraseña debe tener al menos 6 caracteres.");
                    return;
                }
                if (newPassword !== confirmPassword) {
                    showError("La nueva contraseña y la confirmación no coinciden.");
                    return;
                }
            }

            try {
                if (saveBtn) {
                    saveBtn.disabled = true;
                    saveBtn.innerHTML = `
                        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Guardando...
                    `;
                }

                const updateData: any = {
                    name,
                    email,
                    current_password: currentPassword
                };

                if (newPassword) {
                    updateData.new_password = newPassword;
                }

                await updateAdminProfile(updateData);

                if (currentPasswordInput) currentPasswordInput.value = "";
                if (newPasswordInput) newPasswordInput.value = "";
                if (confirmPasswordInput) confirmPasswordInput.value = "";

                showSuccess("¡Tu perfil se ha actualizado correctamente!");

            } catch (error) {
                showError(error instanceof Error ? error.message : "Contraseña actual incorrecta o error al actualizar.");
            } finally {
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.textContent = "Guardar cambios";
                }
            }
        });

        loadProfile();
    </script>

</Layout>