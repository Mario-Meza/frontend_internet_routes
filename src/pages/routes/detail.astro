---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Detalle de asignación">

    <main id="route-page" class="min-h-screen bg-slate-50/50 pb-16">

        <!-- ============================================== -->
        <!-- MODAL EDITAR SERVICIO (Estilo Tailwind)        -->
        <!-- ============================================== -->
        <div
                id="edit-service-modal"
                class="fixed inset-0 z-50 hidden flex items-end justify-center bg-slate-900/60 p-4 backdrop-blur-sm sm:items-center sm:p-0 transition-opacity"
                role="dialog"
                aria-modal="true"
        >
            <div class="relative w-full max-w-lg transform overflow-hidden rounded-3xl bg-white p-6 shadow-2xl transition-all sm:p-8">

                <!-- CABECERA DEL MODAL -->
                <div class="mb-6 flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-4">
                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange-50 text-orange-500 ring-4 ring-orange-50/50">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl font-black tracking-tight text-slate-900">
                                Editar servicio
                            </h2>
                            <p class="mt-0.5 text-sm font-medium text-slate-500">
                                Modifica el cliente o el tipo de servicio.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- ERROR -->
                <div
                        id="edit-service-error"
                        role="alert"
                        class="mb-5 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800"
                ></div>

                <!-- FORMULARIO -->
                <div class="space-y-6">
                    <!-- CLIENTE -->
                    <div>
                        <label for="edit-service-customer" class="mb-2 block text-xs font-bold uppercase tracking-widest text-slate-500">
                            Cliente Destino
                        </label>
                        <select
                                id="edit-service-customer"
                                class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3.5 text-sm font-medium text-slate-900 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 disabled:cursor-not-allowed"
                        >
                        </select>
                        <p id="edit-service-customer-empty" class="mt-3 hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-800 flex gap-2">
                            <svg class="h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                            <span>No hay clientes activos disponibles para reasignar.</span>
                        </p>
                    </div>

                    <!-- TIPO -->
                    <div>
                        <label for="edit-service-type" class="mb-2 block text-xs font-bold uppercase tracking-widest text-slate-500">
                            Tipo de Trabajo
                        </label>
                        <select
                                id="edit-service-type"
                                class="w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3.5 text-sm font-medium text-slate-900 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20"
                        >
                            <option value="S">S — Servicio</option>
                            <option value="R">R — Reconexión</option>
                            <option value="A">A — Alinear</option>
                            <option value="CF">CF — Cambio a fibra</option>
                        </select>
                    </div>
                </div>

                <!-- ACCIONES -->
                <div class="mt-8 flex flex-col gap-3 sm:flex-row-reverse">
                    <button
                            id="save-edit-service"
                            type="button"
                            class="flex w-full items-center justify-center rounded-xl bg-orange-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition hover:bg-orange-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
                    >
                        Guardar cambios
                    </button>
                    <button
                            id="cancel-edit-service"
                            type="button"
                            class="flex w-full items-center justify-center rounded-xl bg-slate-100 px-6 py-3.5 text-sm font-bold text-slate-700 transition hover:bg-slate-200 active:scale-95 sm:w-auto"
                    >
                        Cancelar
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- CONTENIDO PRINCIPAL DE LA PÁGINA               -->
        <!-- ============================================== -->
        <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:py-10">

            <!-- CABECERA AL ESTILO DASHBOARD -->
            <header class="mb-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <a href="/routes" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-orange-600 transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Volver a rutas
                    </a>

                    <div class="flex items-center gap-3">
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 shadow-sm ring-1 ring-inset ring-indigo-200">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                            </svg>
                        </div>
                        <div>
                            <h1 id="route-title" class="text-3xl font-black tracking-tight text-slate-900">
                                Asignación
                            </h1>
                            <p id="route-technician" class="mt-1 text-sm font-medium text-slate-500">
                                Cargando información de la ruta...
                            </p>
                        </div>
                    </div>
                </div>

                <!-- BADGE DE ESTATUS -->
                <div id="route-status-container" class="flex items-center h-full sm:pb-2">
                    <div
                            id="route-status"
                            class="inline-flex w-fit rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-500 ring-1 ring-inset ring-slate-200"
                    >
                        Cargando...
                    </div>
                </div>
            </header>

            <!-- ERROR TOAST -->
            <div
                    id="error-message"
                    role="alert"
                    class="mb-6 hidden rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 shadow-sm"
            ></div>

            <!-- TARJETAS DE RESUMEN DE SERVICIOS (IGUALADAS AL DASHBOARD) -->
            <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-6">
                <!-- Tarjeta: Total -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-indigo-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Visitas Totales</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 ring-1 ring-inset ring-indigo-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                            </svg>
                        </div>
                    </div>
                    <p id="total-services" class="mt-4 text-4xl font-black text-slate-900 tabular-nums">0</p>
                </div>

                <!-- Tarjeta: Terminados -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-emerald-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Terminados</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <p id="completed-services" class="mt-4 text-4xl font-black text-emerald-600 tabular-nums">0</p>
                </div>

                <!-- Tarjeta: Pendientes -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200/60 transition-transform hover:-translate-y-1 hover:shadow-lg hover:ring-orange-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Pendientes</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-50 text-orange-600 ring-1 ring-inset ring-orange-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                    <p id="pending-services" class="mt-4 text-4xl font-black text-orange-600 tabular-nums">0</p>
                </div>
            </div>

            <!-- TABLA/LISTADO DE SERVICIOS -->
            <section class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50" aria-labelledby="services-heading">

                <!-- ENCABEZADO DE LA SECCIÓN DE SERVICIOS -->
                <div class="flex flex-col gap-4 border-b border-slate-100 bg-slate-50/50 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-center gap-3">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-orange-600">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </span>
                        <div>
                            <h2 id="services-heading" class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                1. Servicios Asignados
                            </h2>
                            <p class="text-sm font-medium text-slate-500">
                                Clientes que el técnico debe visitar en esta ruta.
                            </p>
                        </div>
                    </div>

                    <button
                            id="add-service"
                            type="button"
                            class="hidden inline-flex items-center justify-center gap-2 rounded-xl bg-orange-100 px-5 py-2.5 text-sm font-bold text-orange-700 shadow-sm transition hover:bg-orange-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-600 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                        Añadir Visita
                    </button>
                </div>

                <!-- CONTENEDOR DE LA LISTA DE SERVICIOS -->
                <div id="services-container" class="p-6 sm:p-8" aria-live="polite">

                    <!-- SKELETON DE CARGA INICIAL -->
                    <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 p-10 text-center">
                        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-slate-200 text-slate-400">
                            <svg class="h-6 w-6 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </div>
                        <p class="text-sm font-bold text-slate-700">
                            Descargando detalles de la ruta...
                        </p>
                    </div>

                </div>

            </section>

        </div> <!-- Cierre correcto del contenedor principal -->

    </main>

    <!-- Cargamos el script original tal cual lo tenías (preserva tu lógica) -->
    <script src="../../scripts/route-detail.ts"></script>

</Layout>