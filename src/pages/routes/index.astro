---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Rutas">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- CABECERA -->
            <header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-orange-500"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-orange-600">Gestión de Campo</span>
                    </div>
                    <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Listado de Rutas
                    </h1>
                    <p class="mt-2 text-base text-slate-500 max-w-xl">
                        Consulta y administra todas las rutas programadas y sus técnicos asignados.
                    </p>
                </div>

                <a
                        href="/routes/new"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 shrink-0"
                >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    <span>Nueva asignación</span>
                </a>
            </header>


            <!-- Loading (skeleton) -->
            <div
                    id="loading"
                    role="status"
                    aria-live="polite"
                    class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50"
            >
                <span class="sr-only">Cargando rutas...</span>
                <div class="animate-pulse divide-y divide-slate-100" aria-hidden="true">
                    {Array.from({ length: 5 }).map(() => (
                            <div class="flex flex-col gap-4 px-6 py-5 md:flex-row md:items-center md:justify-between">
                                <div class="h-4 w-28 rounded-md bg-slate-200"></div>
                                <div class="flex items-center gap-3">
                                    <div class="h-10 w-10 rounded-full bg-slate-200"></div>
                                    <div class="h-4 w-32 rounded-md bg-slate-200"></div>
                                </div>
                                <div class="h-6 w-24 rounded-full bg-slate-200"></div>
                                <div class="h-6 w-24 rounded-full bg-slate-200"></div>
                                <div class="h-9 w-9 rounded-xl bg-slate-200"></div>
                            </div>
                    ))}
                </div>
            </div>


            <!-- Error -->
            <div
                    id="error"
                    role="alert"
                    class="hidden rounded-2xl border border-red-200 bg-red-50 p-5 text-sm font-medium text-red-700 shadow-sm"
            >
            </div>


            <!-- Tabla -->
            <div
                    id="routes-container"
                    class="hidden overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] ring-1 ring-slate-200/50"
            >
                <table class="min-w-full divide-y divide-slate-200">
                    <caption class="sr-only">Listado de rutas</caption>
                    <thead class="hidden bg-slate-50 border-b border-slate-200 md:table-header-group">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                            Fecha
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                            Técnico
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                            Servicios
                        </th>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                            Estado
                        </th>
                        <th scope="col" class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-500">
                            <span class="sr-only">Acciones</span>
                        </th>
                    </tr>
                    </thead>
                    <tbody
                            id="routes-body"
                            class="block divide-y divide-slate-100 md:table-row-group bg-white"
                    >
                    </tbody>
                </table>
            </div>


            <!-- Empty State -->
            <div
                    id="empty"
                    class="hidden rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center shadow-sm"
            >
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                    <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">
                    Aún no hay rutas programadas
                </h3>
                <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                    Crea la primera asignación para organizar las visitas y el trabajo de tu equipo de técnicos.
                </p>
                <div class="mt-8">
                    <a
                            href="/routes/new"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95"
                    >
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                        Crear primera ruta
                    </a>
                </div>
            </div>

        </section>

    </main>


    <script>
        import { getRoutes, getTechnicians } from "../../services/api";

        const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000/api/v1";

        const loading = document.getElementById("loading");
        const error = document.getElementById("error");
        const container = document.getElementById("routes-container");
        const empty = document.getElementById("empty");
        const routesBody = document.getElementById("routes-body");

        function escapeHtml(value: unknown): string {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        // Formato de fecha agradable
        function formatDate(value: string): string {
            const [year, month, day] = value.split("-");
            const date = new Date(Number(year), Number(month) - 1, Number(day));
            return date.toLocaleDateString("es-MX", {
                day: "2-digit",
                month: "short",
                year: "numeric"
            }).replace('.', '');
        }

        // Color dinámico para avatar
        function getAvatarColor(name: string): string {
            const colors = [
                'bg-blue-100 text-blue-700', 'bg-indigo-100 text-indigo-700',
                'bg-violet-100 text-violet-700', 'bg-fuchsia-100 text-fuchsia-700',
                'bg-pink-100 text-pink-700', 'bg-rose-100 text-rose-700'
            ];
            const charCode = name.charCodeAt(0) || 0;
            return colors[charCode % colors.length];
        }

        // Renderizado de status con puntos
        function renderStatus(status: string): string {
            const config: Record<string, { label: string; bg: string; dot: string; text: string; border: string }> = {
                assigned: { label: "Asignada", bg: "bg-blue-50", dot: "bg-blue-500", text: "text-blue-700", border: "ring-blue-600/20" },
                in_progress: { label: "En proceso", bg: "bg-orange-50", dot: "bg-orange-500 animate-pulse", text: "text-orange-700", border: "ring-orange-600/20" },
                completed: { label: "Completada", bg: "bg-green-50", dot: "bg-green-500", text: "text-green-700", border: "ring-green-600/20" },
                canceled: { label: "Cancelada", bg: "bg-red-50", dot: "bg-red-500", text: "text-red-700", border: "ring-red-600/20" },
            };

            const current = config[status] ?? { label: status, bg: "bg-slate-100", dot: "bg-slate-400", text: "text-slate-600", border: "ring-slate-500/20" };

            return `
                <span class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-bold ${current.bg} ${current.text} ring-1 ring-inset ${current.border}">
                    <span class="h-1.5 w-1.5 rounded-full ${current.dot}"></span>
                    ${current.label}
                </span>
            `;
        }

        async function loadRoutes() {
            try {
                const [routes, technicians] = await Promise.all([
                    getRoutes(),
                    getTechnicians(),
                ]);

                loading?.classList.add("hidden");

                if (routes.length === 0) {
                    empty?.classList.remove("hidden");
                    return;
                }

                container?.classList.remove("hidden");

                // CAMBIO: Ahora guardamos el objeto completo del técnico, no solo su nombre
                const technicianMap = new Map(
                    technicians.map((technician) => [technician.id, technician])
                );

                if (routesBody) {
                    routesBody.innerHTML = routes
                        .map((route) => {
                            const technician = technicianMap.get(route.technician_id) as any;
                            const technicianName = technician?.name ?? "Técnico desconocido";
                            const serviceCount = route.services.length;
                            const serviceLabel = serviceCount === 1 ? "Visita" : "Visitas";
                            const avatarColor = getAvatarColor(technicianName);

                            // LÓGICA DE AVATAR / FOTO
                            let avatarHtml = '';
                            if (technician) {
                                const photoUrl = technician.photo_url || technician.photo || `${API_URL}/technicians/${technician.id}/photo`;
                                avatarHtml = `
                                    <img
                                        src="${escapeHtml(photoUrl)}"
                                        alt="${escapeHtml(technicianName)}"
                                        class="h-10 w-10 shrink-0 rounded-full object-cover ring-2 ring-white shadow-sm"
                                        onerror="this.onerror=null; this.replaceWith(Object.assign(document.createElement('span'), {className: 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white', textContent: '${getInitials(technicianName)}'}));"
                                    />
                                `;
                            } else {
                                avatarHtml = `
                                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white">
                                        ${escapeHtml(getInitials(technicianName))}
                                    </span>
                                `;
                            }

                            return `
                                <tr class="group block px-4 py-4 transition-colors hover:bg-slate-50/80 md:table-row md:px-0 md:py-0">
                                    
                                    <!-- FECHA -->
                                    <td data-label="Fecha" class="flex items-center justify-between gap-4 py-3 before:text-xs before:font-medium before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                        <div class="flex items-center gap-3">
                                            <div class="hidden md:flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
                                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                            <span class="text-sm font-semibold text-slate-700 tabular-nums">
                                                ${escapeHtml(formatDate(route.route_date))}
                                            </span>
                                        </div>
                                    </td>

                                    <!-- TÉCNICO -->
                                    <td data-label="Técnico" class="flex items-center justify-between gap-4 py-3 before:text-xs before:font-medium before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                        <div class="flex items-center gap-3">
                                            ${avatarHtml}
                                            <span class="text-sm font-bold text-slate-800">
                                                ${escapeHtml(technicianName)}
                                            </span>
                                        </div>
                                    </td>

                                    <!-- SERVICIOS -->
                                    <td data-label="Servicios" class="flex items-center justify-between gap-4 py-3 before:text-xs before:font-medium before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                        <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-200">
                                            <span class="text-slate-900">${serviceCount}</span>
                                            <span>${serviceLabel}</span>
                                        </span>
                                    </td>

                                    <!-- ESTADO -->
                                    <td data-label="Estado" class="flex items-center justify-between gap-4 py-3 before:text-xs before:font-medium before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                        ${renderStatus(route.status)}
                                    </td>

                                    <!-- ACCIÓN -->
                                    <td class="pt-4 md:table-cell md:px-6 md:py-5 md:text-right">
                                        <a href="/routes/detail?id=${encodeURIComponent(route.id)}" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white p-3 text-slate-500 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-indigo-600 active:scale-95 md:w-auto md:p-2.5" title="Ver detalles">
                                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            <span class="md:hidden text-sm font-bold text-slate-600">Ver detalles</span>
                                        </a>
                                    </td>
                                </tr>
                            `;
                        })
                        .join("");
                }
            } catch (err) {
                loading?.classList.add("hidden");
                if (error) {
                    error.innerHTML = `
                        <div class="flex items-center gap-3">
                            <svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <p>${err instanceof Error ? err.message : "No se pudieron cargar las rutas."}</p>
                        </div>
                    `;
                    error.classList.remove("hidden");
                }
            }
        }

        loadRoutes();
    </script>
</Layout>