---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Rutas">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- CABECERA -->
            <header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <a href="/" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-orange-600 transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Volver a dashboard
                    </a>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-orange-500"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-orange-600">Gestión de Campo</span>
                    </div>
                    <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Listado de Rutas
                    </h1>
                    <p class="mt-2 text-base text-slate-500 max-w-xl">
                        Consulta y administra todas las rutas programadas y sus técnicos asignados.
                    </p>
                </div>

                <a
                        href="/routes/new"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95 shrink-0"
                >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    <span>Nueva asignación</span>
                </a>
            </header>

            <!-- Loading (skeleton) -->
            <div id="loading" role="status" aria-live="polite" class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200/50">
                <span class="sr-only">Cargando rutas...</span>
                <div class="animate-pulse divide-y divide-slate-100" aria-hidden="true">
                    {Array.from({ length: 5 }).map(() => (
                            <div class="flex flex-col gap-4 px-6 py-5 md:flex-row md:items-center md:justify-between">
                                <div class="h-4 w-28 rounded-md bg-slate-200"></div>
                                <div class="flex items-center gap-3">
                                    <div class="h-10 w-10 rounded-full bg-slate-200"></div>
                                    <div class="h-4 w-32 rounded-md bg-slate-200"></div>
                                </div>
                                <div class="h-6 w-24 rounded-full bg-slate-200"></div>
                                <div class="h-6 w-24 rounded-full bg-slate-200"></div>
                                <div class="h-9 w-32 rounded-xl bg-slate-200"></div>
                            </div>
                    ))}
                </div>
            </div>

            <!-- Toast Messages -->
            <div id="message" class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"></div>
            <div id="error" role="alert" class="hidden rounded-2xl border border-red-200 bg-red-50 p-5 text-sm font-medium text-red-700 shadow-sm"></div>

            <!-- Tabla -->
            <div id="routes-container" class="hidden overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200/50">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="hidden bg-slate-50 border-b border-slate-200 md:table-header-group">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">Fecha</th>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">Técnico</th>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">Servicios</th>
                        <th scope="col" class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">Estado</th>
                        <th scope="col" class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-500">Acciones</th>
                    </tr>
                    </thead>
                    <tbody id="routes-body" class="block divide-y divide-slate-100 md:table-row-group bg-white"></tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="empty" class="hidden rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center shadow-sm">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                    <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">Aún no hay rutas programadas</h3>
                <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                    Crea la primera asignación para organizar las visitas y el trabajo de tu equipo de técnicos.
                </p>
            </div>

        </section>

        <!-- ============================================== -->
        <!-- MODALES DE CONFIRMACIÓN (Tailwind)             -->
        <!-- ============================================== -->

        <!-- MODAL DE CANCELAR RUTA -->
        <div id="cancel-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4 backdrop-blur-sm transition-opacity">
            <div class="w-full max-w-sm overflow-hidden rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-slate-200/50 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-50 text-amber-500 ring-8 ring-amber-50/50">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-black tracking-tight text-slate-900">¿Suspender ruta?</h3>
                <p class="mt-2 text-sm font-medium text-slate-500 leading-relaxed">
                    Al confirmar, el técnico ya no podrá realizar ni terminar ninguna instalación de esta asignación.
                </p>
                <div class="mt-8 flex flex-col gap-3">
                    <button id="confirm-cancel-btn" class="flex w-full items-center justify-center rounded-xl bg-amber-500 px-5 py-3.5 text-sm font-bold text-white shadow-md shadow-amber-500/20 transition hover:bg-amber-600 active:scale-95">
                        Sí, suspender
                    </button>
                    <button id="close-cancel-btn" class="flex w-full items-center justify-center rounded-xl bg-slate-100 px-5 py-3.5 text-sm font-bold text-slate-700 transition hover:bg-slate-200 active:scale-95">
                        Volver
                    </button>
                </div>
            </div>
        </div>

        <!-- MODAL DE ELIMINAR RUTA -->
        <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4 backdrop-blur-sm transition-opacity">
            <div class="w-full max-w-sm overflow-hidden rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-slate-200/50 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-50 text-red-500 ring-8 ring-red-50/50">
                    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-black tracking-tight text-slate-900">¿Eliminar registro?</h3>
                <p class="mt-2 text-sm font-medium text-slate-500 leading-relaxed">
                    Esta acción borrará la ruta permanentemente de la base de datos y no se podrá deshacer.
                </p>
                <div class="mt-8 flex flex-col gap-3">
                    <button id="confirm-delete-btn" class="flex w-full items-center justify-center rounded-xl bg-red-600 px-5 py-3.5 text-sm font-bold text-white shadow-md shadow-red-500/20 transition hover:bg-red-700 active:scale-95">
                        Eliminar permanentemente
                    </button>
                    <button id="close-delete-btn" class="flex w-full items-center justify-center rounded-xl bg-slate-100 px-5 py-3.5 text-sm font-bold text-slate-700 transition hover:bg-slate-200 active:scale-95">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>

    </main>

    <script>
        import { getRoutes, getTechnicians, updateRouteStatus, deleteRoute } from "../../services/api";
        import type { Route } from "../../types/route";

        const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000/api/v1";

        const loading = document.getElementById("loading");
        const errorContainer = document.getElementById("error");
        const messageContainer = document.getElementById("message");
        const container = document.getElementById("routes-container");
        const empty = document.getElementById("empty");
        const routesBody = document.getElementById("routes-body");

        // MODALES DOM
        const cancelModal = document.getElementById("cancel-modal");
        const confirmCancelBtn = document.getElementById("confirm-cancel-btn");
        const closeCancelBtn = document.getElementById("close-cancel-btn");

        const deleteModal = document.getElementById("delete-modal");
        const confirmDeleteBtn = document.getElementById("confirm-delete-btn");
        const closeDeleteBtn = document.getElementById("close-delete-btn");

        let routeIdToActOn: string | null = null;
        let routesData: Route[] = [];

        function escapeHtml(value: unknown): string {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function getInitials(name: string): string {
            return name.split(" ").filter(Boolean).slice(0, 2).map((word) => word[0].toUpperCase()).join("");
        }

        function formatDate(value: string): string {
            const [year, month, day] = value.split("-");
            const date = new Date(Number(year), Number(month) - 1, Number(day));
            return date.toLocaleDateString("es-MX", { day: "2-digit", month: "short", year: "numeric" }).replace('.', '');
        }

        function getAvatarColor(name: string): string {
            const colors = [
                'bg-blue-100 text-blue-700', 'bg-indigo-100 text-indigo-700',
                'bg-violet-100 text-violet-700', 'bg-fuchsia-100 text-fuchsia-700',
                'bg-pink-100 text-pink-700', 'bg-rose-100 text-rose-700'
            ];
            const charCode = name.charCodeAt(0) || 0;
            return colors[charCode % colors.length];
        }

        function renderStatus(status: string): string {
            const config: Record<string, { label: string; bg: string; dot: string; text: string; border: string }> = {
                assigned: { label: "Asignada", bg: "bg-blue-50", dot: "bg-blue-500", text: "text-blue-700", border: "ring-blue-600/20" },
                in_progress: { label: "En proceso", bg: "bg-orange-50", dot: "bg-orange-500 animate-pulse", text: "text-orange-700", border: "ring-orange-600/20" },
                completed: { label: "Completada", bg: "bg-green-50", dot: "bg-green-500", text: "text-green-700", border: "ring-green-600/20" },
                canceled: { label: "Cancelada", bg: "bg-red-50", dot: "bg-red-500", text: "text-red-700", border: "ring-red-600/20" },
            };
            const current = config[status] ?? { label: status, bg: "bg-slate-100", dot: "bg-slate-400", text: "text-slate-600", border: "ring-slate-500/20" };

            return `
                <span class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[10px] font-bold md:text-xs ${current.bg} ${current.text} ring-1 ring-inset ${current.border}">
                    <span class="h-1.5 w-1.5 rounded-full ${current.dot}"></span>
                    ${current.label}
                </span>
            `;
        }

        function showMessage(text: string, isError: boolean = false) {
            if (!messageContainer) return;
            messageContainer.innerHTML = `
                <div class="flex items-center gap-3">
                    ${isError
                ? `<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                : `<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`}
                    <p>${text}</p>
                </div>
            `;
            messageContainer.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800 shadow-sm";
            messageContainer.classList.remove("hidden");

            setTimeout(() => {
                messageContainer.classList.add("hidden");
            }, 4000);
        }

        async function loadRoutes() {
            try {
                const [routesResponse, technicians] = await Promise.all([
                    getRoutes(),
                    getTechnicians(),
                ]);

                routesData = routesResponse;
                loading?.classList.add("hidden");

                if (routesData.length === 0) {
                    empty?.classList.remove("hidden");
                    return;
                }

                container?.classList.remove("hidden");

                const technicianMap = new Map(
                    technicians.map((technician) => [technician.id, technician])
                );

                renderTable(technicianMap);

            } catch (err) {
                loading?.classList.add("hidden");
                if (errorContainer) {
                    errorContainer.innerHTML = `
                        <div class="flex items-center gap-3">
                            <svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <p>${err instanceof Error ? err.message : "No se pudieron cargar las rutas."}</p>
                        </div>
                    `;
                    errorContainer.classList.remove("hidden");
                }
            }
        }

        function renderTable(technicianMap: Map<string, any>) {
            if (!routesBody) return;

            routesBody.innerHTML = routesData
                .map((route) => {
                    const technician = technicianMap.get(route.technician_id) as any;
                    const technicianName = technician?.name ?? "Técnico desconocido";
                    const serviceCount = route.services.length;
                    const serviceLabel = serviceCount === 1 ? "Visita" : "Visitas";
                    const avatarColor = getAvatarColor(technicianName);

                    let avatarHtml = '';
                    if (technician) {
                        const photoUrl = technician.photo_url || technician.photo || `${API_URL}/technicians/${technician.id}/photo`;
                        avatarHtml = `
                            <img
                                src="${escapeHtml(photoUrl)}"
                                alt="${escapeHtml(technicianName)}"
                                class="h-10 w-10 shrink-0 rounded-full object-cover ring-2 ring-white shadow-sm"
                                onerror="this.onerror=null; this.replaceWith(Object.assign(document.createElement('span'), {className: 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white', textContent: '${getInitials(technicianName)}'}));"
                            />
                        `;
                    } else {
                        avatarHtml = `
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white">
                                ${escapeHtml(getInitials(technicianName))}
                            </span>
                        `;
                    }

                    return `
                        <tr class="group block px-4 py-4 transition-colors hover:bg-slate-50 md:table-row md:px-0 md:py-0 border-b border-slate-100 md:border-b-0">
                            
                            <!-- FECHA -->
                            <td data-label="Fecha" class="flex items-center justify-between gap-4 py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                <div class="flex items-center gap-3">
                                    <div class="hidden md:flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                    <span class="text-sm font-semibold text-slate-700 tabular-nums">
                                        ${escapeHtml(formatDate(route.route_date))}
                                    </span>
                                </div>
                            </td>

                            <!-- TÉCNICO -->
                            <td data-label="Técnico" class="flex items-center justify-between gap-4 py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                <div class="flex items-center gap-3">
                                    ${avatarHtml}
                                    <span class="text-sm font-bold text-slate-800">
                                        ${escapeHtml(technicianName)}
                                    </span>
                                </div>
                            </td>

                            <!-- SERVICIOS -->
                            <td data-label="Servicios" class="flex items-center justify-between gap-4 py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-200">
                                    <span class="text-slate-900">${serviceCount}</span>
                                    <span>${serviceLabel}</span>
                                </span>
                            </td>

                            <!-- ESTADO -->
                            <td data-label="Estado" class="flex items-center justify-between gap-4 py-2 before:text-xs before:font-bold before:text-slate-400 before:content-[attr(data-label)] md:table-cell md:px-6 md:py-5 md:before:content-none">
                                ${renderStatus(route.status)}
                            </td>

                            <!-- ACCIONES COMPLETAS -->
                            <td class="mt-4 flex justify-end pt-4 md:mt-0 md:table-cell md:px-6 md:py-5 border-t border-slate-100 md:border-0 md:pt-5">
                                <div class="flex items-center gap-2 transition-opacity md:opacity-80 md:group-hover:opacity-100">
                                    
                                    <a
                                        href="/routes/detail?id=${route.id}"
                                        class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-indigo-600 active:scale-95 md:p-2"
                                        title="Ver detalles completos"
                                    >
                                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                        <span class="md:hidden text-sm font-bold ml-2 text-slate-600">Ver detalles</span>
                                    </a>

                                    ${
                        route.status === "assigned"
                            ? `
                                                <a
                                                    href="/routes/edit?id=${route.id}"
                                                    class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-blue-600 active:scale-95 md:p-2"
                                                    title="Editar asignación"
                                                >
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                </a>
                                            `
                            : ""
                    }

                                    ${
                        route.status === "assigned" || route.status === "in_progress"
                            ? `
                                                <button
                                                    type="button"
                                                    data-action="cancel"
                                                    data-id="${route.id}"
                                                    class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-amber-600 active:scale-95 md:p-2"
                                                    title="Suspender/Cancelar ruta"
                                                >
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                    </svg>
                                                </button>
                                            `
                            : ""
                    }

                                    ${
                        route.status === "assigned"
                            ? `
                                                <button
                                                    type="button"
                                                    data-action="delete"
                                                    data-id="${route.id}"
                                                    class="inline-flex items-center justify-center rounded-xl bg-white p-2.5 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-red-50 hover:text-red-600 hover:ring-red-200 active:scale-95 md:p-2"
                                                    title="Eliminar permanentemente"
                                                >
                                                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            `
                            : ""
                    }
                                </div>
                            </td>
                        </tr>
                    `;
                })
                .join("");

            addTableEvents(technicianMap);
        }

        // ==============================================
        // EVENTOS DE BOTONES Y MODALES (Sin window.confirm)
        // ==============================================
        function addTableEvents(technicianMap: Map<string, any>) {
            document.querySelectorAll<HTMLButtonElement>("[data-action='cancel']").forEach((button) => {
                button.addEventListener("click", () => {
                    routeIdToActOn = button.dataset.id || null;
                    cancelModal?.classList.remove("hidden");
                });
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () => {
                    routeIdToActOn = button.dataset.id || null;
                    deleteModal?.classList.remove("hidden");
                });
            });

            // Asignar los métodos a los botones de los modales de Tailwind
            if (confirmCancelBtn) {
                const newCancelBtn = confirmCancelBtn.cloneNode(true) as HTMLButtonElement;
                confirmCancelBtn.parentNode?.replaceChild(newCancelBtn, confirmCancelBtn);

                newCancelBtn.addEventListener("click", async () => {
                    if (!routeIdToActOn) return;
                    cancelModal?.classList.add("hidden");

                    try {
                        await updateRouteStatus(routeIdToActOn, "canceled");
                        routesData = routesData.map((route) => (route.id === routeIdToActOn ? { ...route, status: "canceled" } : route));
                        renderTable(technicianMap);
                        showMessage("Ruta suspendida correctamente.", false);
                    } catch (error) {
                        showMessage(error instanceof Error ? error.message : "No se pudo cancelar la ruta.", true);
                    }
                });
            }

            if (confirmDeleteBtn) {
                const newDeleteBtn = confirmDeleteBtn.cloneNode(true) as HTMLButtonElement;
                confirmDeleteBtn.parentNode?.replaceChild(newDeleteBtn, confirmDeleteBtn);

                newDeleteBtn.addEventListener("click", async () => {
                    if (!routeIdToActOn) return;
                    deleteModal?.classList.add("hidden");

                    try {
                        await deleteRoute(routeIdToActOn);
                        routesData = routesData.filter((route) => route.id !== routeIdToActOn);

                        if(routesData.length === 0) {
                            document.getElementById("routes-container")?.classList.add("hidden");
                            document.getElementById("empty")?.classList.remove("hidden");
                        } else {
                            renderTable(technicianMap);
                        }
                        showMessage("Asignación eliminada permanentemente.", false);
                    } catch (error) {
                        showMessage(error instanceof Error ? error.message : "Error al intentar eliminar.", true);
                    }
                });
            }
        }

        closeCancelBtn?.addEventListener("click", () => cancelModal?.classList.add("hidden"));
        closeDeleteBtn?.addEventListener("click", () => deleteModal?.classList.add("hidden"));

        loadRoutes();
    </script>
</Layout>