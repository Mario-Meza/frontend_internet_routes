---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Nueva ruta">

    <main class="min-h-screen bg-slate-50/50">

        <!-- CONTENIDO -->
        <section class="mx-auto max-w-5xl px-6 py-10 sm:py-14">

            <!-- CABECERA -->
            <header class="mb-8">
                <a href="/routes" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-orange-600 transition-colors">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Volver a rutas
                </a>
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100 text-orange-600 shadow-sm ring-1 ring-inset ring-orange-200">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-black tracking-tight text-slate-900">
                            Nueva asignación
                        </h1>
                        <p class="mt-1 text-sm text-slate-500">
                            Programa una nueva ruta asignando una fecha, técnico y los servicios a realizar.
                        </p>
                    </div>
                </div>
            </header>

            <!-- MENSAJES DE NOTIFICACIÓN -->
            <div id="error-message" class="mb-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700 shadow-sm"></div>
            <div id="success-message" class="mb-6 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-700 shadow-sm"></div>


            <!-- DATOS DE LA RUTA -->
            <section class="mb-8 overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50">

                <div class="border-b border-slate-100 bg-slate-50/50 px-6 py-5">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        1. Detalles Generales
                    </h2>
                </div>

                <div class="grid gap-6 px-6 py-8 md:grid-cols-2">
                    <!-- FECHA -->
                    <div>
                        <label for="route-date" class="mb-2 block text-sm font-bold text-slate-700">
                            Fecha de ruta
                        </label>
                        <input
                                id="route-date"
                                type="date"
                                required
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20"
                        />
                    </div>

                    <!-- TÉCNICO -->
                    <div>
                        <label for="technician" class="mb-2 block text-sm font-bold text-slate-700">
                            Técnico Asignado
                        </label>
                        <select
                                id="technician"
                                required
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 cursor-pointer"
                        >
                            <option value="">Cargando técnicos operativos...</option>
                        </select>

                        <div id="no-active-technicians" class="mt-3 hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800 flex gap-2">
                            <svg class="h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                            <div>
                                <p class="font-semibold">No hay técnicos operativos.</p>
                                <p class="mt-0.5 text-xs text-amber-700/80">Necesitas <a href="/technicians" class="underline font-bold hover:text-amber-900">dar de alta o activar</a> un técnico para crear una ruta.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>


            <!-- SERVICIOS -->
            <section class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50">

                <div class="flex flex-col gap-4 border-b border-slate-100 bg-slate-50/50 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                        <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        2. Servicios a Realizar
                    </h2>

                    <button
                            id="add-service"
                            type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-xl bg-orange-100 px-4 py-2 text-sm font-bold text-orange-700 shadow-sm transition hover:bg-orange-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-orange-600 disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        + Añadir Visita
                    </button>
                </div>

                <div class="p-6 sm:p-8">
                    <div id="no-active-customers" class="mb-5 hidden rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 flex gap-3">
                        <svg class="h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        <div>
                            <p class="font-bold">No hay clientes activos en la base de datos.</p>
                            <p class="mt-1 text-xs">Debes <a href="/customers" class="underline font-bold hover:text-amber-900">registrar al menos un cliente</a> antes de poder asignarle servicios en una ruta.</p>
                        </div>
                    </div>

                    <!-- CONTENEDOR DE SERVICIOS -->
                    <div id="services-container" class="space-y-4"></div>

                    <!-- SIN SERVICIOS (EMPTY STATE) -->
                    <div id="empty-services" class="rounded-xl border-2 border-dashed border-slate-200 p-10 text-center">
                        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                            <svg class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <p id="empty-services-title" class="mt-4 font-bold text-slate-900">
                            Aún no hay visitas programadas
                        </p>
                        <p id="empty-services-description" class="mt-1 text-sm text-slate-500">
                            Haz clic en "Añadir Visita" para seleccionar clientes.
                        </p>
                    </div>
                </div>

                <!-- FOOTER / BOTONES DE ACCIÓN -->
                <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-6 sm:flex sm:items-center sm:justify-end sm:gap-3 sm:px-10">
                    <a
                            href="/routes"
                            class="mb-3 block w-full rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-center text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.98] sm:mb-0 sm:w-auto"
                    >
                        Cancelar
                    </a>

                    <button
                            id="create-route"
                            type="button"
                            class="block w-full rounded-xl bg-orange-600 px-6 py-3.5 text-center text-sm font-bold text-white shadow-md shadow-orange-500/30 transition hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                    >
                        Crear Asignación
                    </button>
                </div>

            </section>

        </section>

    </main>


    <script>
        import {
            getCustomers,
            getTechnicians,
            getRoutes,
            createRoute,
            } from "../../services/api";

            import type { Customer } from "../../types/customer";
            import type { RouteServiceCreate, ServiceType } from "../../types/route";

            const routeDateInput = document.querySelector<HTMLInputElement>("#route-date");
            const technicianSelect = document.querySelector<HTMLSelectElement>("#technician");
            const noActiveTechniciansMessage = document.querySelector<HTMLDivElement>("#no-active-technicians");
            const noActiveCustomersMessage = document.querySelector<HTMLDivElement>("#no-active-customers");

            const servicesContainer = document.querySelector<HTMLDivElement>("#services-container");
            const emptyServices = document.querySelector<HTMLDivElement>("#empty-services");

            const addServiceButton = document.querySelector<HTMLButtonElement>("#add-service");
            const createRouteButton = document.querySelector<HTMLButtonElement>("#create-route");

            const errorMessage = document.querySelector<HTMLDivElement>("#error-message");
            const successMessage = document.querySelector<HTMLDivElement>("#success-message");

            let customers: Customer[] = [];
            let activeTechniciansCount = 0;
            let isSubmitting = false;

            const serviceTypes: { value: ServiceType; label: string; bg: string; text:string; }[] = [
                { value: "S", label: "Servicio", bg: "bg-blue-50", text: "text-blue-700" },
                { value: "R", label: "Reconexión", bg: "bg-purple-50", text: "text-purple-700" },
                { value: "A", label: "Alinear", bg: "bg-amber-50", text: "text-amber-700" },
                { value: "CF", label: "Cambio a fibra", bg: "bg-indigo-50", text: "text-indigo-700" },
                ];

            async function loadInitialData() {
                try {
                    // 1. Cargamos Clientes, Técnicos y las Rutas Actuales
                    const [customersResponse, techniciansResponse, routesResponse] = await Promise.all([
                        getCustomers(),
                        getTechnicians(),
                        getRoutes(),
                        ]);

                    // 2. Extraer los IDs de todos los clientes que YA están en una ruta activa
                    const activeCustomerIds = new Set<string>();

                    routesResponse.forEach(route => {
                        if (route.status === "assigned" || route.status === "in_progress") {
                            route.services.forEach(service => {
                                if (service.customer_id) {
                                    activeCustomerIds.add(service.customer_id);
                                    }
                                });
                            }
                        });

                    // 3. Filtrar la lista de clientes: Debe estar activo y NO ocupado
                    customers = customersResponse.filter((customer) => {
                        const isActive = customer.active !== false;
                        const isNotBusy = !activeCustomerIds.has(customer.id);
                        return isActive && isNotBusy;
                        });

                    const activeTechnicians = techniciansResponse.filter((technician) => technician.active === true);
                    activeTechniciansCount = activeTechnicians.length;

                    if (technicianSelect) {
                        technicianSelect.innerHTML = activeTechnicians.length
                            ? `<option value="">Selecciona un técnico</option>`
                            : `<option value="">No hay técnicos operativos</option>`;

                        activeTechnicians.forEach((technician) => {
                            const option = document.createElement("option");
                            option.value = technician.id;
                            option.textContent = technician.name;
                            technicianSelect.appendChild(option);
                            });
                        technicianSelect.disabled = activeTechnicians.length === 0;
                        }

                    noActiveTechniciansMessage?.classList.toggle("hidden", activeTechnicians.length > 0);

                    if (noActiveCustomersMessage) {
                        if (customers.length === 0) {
                            noActiveCustomersMessage.innerHTML = `
                            <svg class="h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                            <div>
                                <p class="font-bold">No hay clientes disponibles.</p>
                                <p class="mt-1 text-xs">Todos los clientes activos ya están asignados a rutas pendientes o en proceso.</p>
                            </div>
                         `;
                            noActiveCustomersMessage.classList.remove("hidden");
                            } else {
                            noActiveCustomersMessage.classList.add("hidden");
                            }
                        }

                    updateFormAvailability();

                    if (customers.length > 0 && activeTechniciansCount > 0) {
                        addService();
                        } else {
                        updateServiceNumbers();
                        }

                    } catch (error) {
                    showError("No se pudieron cargar los datos base. Revisa tu conexión.");
                    if (technicianSelect) {
                        technicianSelect.disabled = true;
                        technicianSelect.innerHTML = `<option value="">Error de conexión</option>`;
                        }
                    if (addServiceButton) addServiceButton.disabled = true;
                    if (createRouteButton) createRouteButton.disabled = true;
                    }
                }

            // =========================================================
            // LÓGICA DE DIBUJADO DE LAS TARJETAS
            // =========================================================
            function addService() {
                if (!servicesContainer) return;
                if (customers.length === 0 || activeTechniciansCount === 0) {
                    updateServiceNumbers();
                    return;
                    }

                const serviceCard = document.createElement("div");
                serviceCard.className = "service-card relative overflow-hidden rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md hover:border-orange-200";

                serviceCard.innerHTML = `
                <div class="mb-4 flex items-center justify-between border-b border-slate-100 pb-3">
                    <div class="flex items-center gap-3">
                        <span class="service-number flex h-8 w-8 items-center justify-center rounded-xl bg-slate-900 text-sm font-black text-white shadow-sm ring-2 ring-slate-100">
                            1
                        </span>
                        <h3 class="font-bold text-slate-800 text-sm uppercase tracking-wider">
                            Visita
                        </h3>
                    </div>
                    
                    <button type="button" class="remove-service inline-flex items-center justify-center rounded-xl bg-red-50 p-2 text-red-500 shadow-sm transition hover:bg-red-100 hover:text-red-700" title="Eliminar servicio">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                </div>

                <div class="grid gap-5 md:grid-cols-12">
                    <div class="md:col-span-8">
                        <label class="mb-2 block text-xs font-bold text-slate-500 uppercase tracking-widest">
                            Cliente Destino
                        </label>
                        <select class="customer-select w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm font-medium text-slate-900 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20 disabled:cursor-not-allowed">
                            <option value="">Selecciona un cliente de la lista</option>
                        </select>
                    </div>

                    <div class="md:col-span-4">
                        <label class="mb-2 block text-xs font-bold text-slate-500 uppercase tracking-widest">
                            Tipo de Trabajo
                        </label>
                        <select class="service-type-select w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm font-medium text-slate-900 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20">
                        </select>
                    </div>
                </div>
            `;

                const customerSelect = serviceCard.querySelector<HTMLSelectElement>(".customer-select");
                const serviceTypeSelect = serviceCard.querySelector<HTMLSelectElement>(".service-type-select");

                if (customerSelect) {
                    customers.forEach((customer) => {
                        const option = document.createElement("option");
                        option.value = customer.id;
                        option.textContent = `${customer.name} — ${customer.location}`;
                        customerSelect.appendChild(option);
                        });
                    }

                if (serviceTypeSelect) {
                    serviceTypes.forEach((serviceType) => {
                        const option = document.createElement("option");
                        option.value = serviceType.value;
                        option.textContent = serviceType.label;
                        serviceTypeSelect.appendChild(option);
                        });
                    }

                const removeButton = serviceCard.querySelector<HTMLButtonElement>(".remove-service");
                removeButton?.addEventListener("click", () => {
                    serviceCard.remove();
                    updateServiceNumbers();
                    updateAvailableCustomers(); // Liberamos al cliente al borrar la tarjeta
                    });

                servicesContainer.appendChild(serviceCard);
                updateServiceNumbers();

                // 🔥 CLAVE: Forzamos la actualización de todos los selects INMEDIATAMENTE después de añadir uno nuevo
                setTimeout(() => {
                    updateAvailableCustomers();
                    }, 0);
                }

            // =========================================================
            // 🔥 DELEGACIÓN DE EVENTOS PARA EL CONTENEDOR (NUEVO)
            // =========================================================
            // Escuchamos cualquier cambio ('change') que ocurra DENTRO de servicesContainer
            if (servicesContainer) {
                servicesContainer.addEventListener('change', (event) => {
                    const target = event.target as HTMLElement;
                    // Solo nos importa si el cambio fue en uno de los desplegables de clientes
                    if (target && target.classList.contains('customer-select')) {
                        updateAvailableCustomers();
                        }
                    });
                }

            // =========================================================
            // LÓGICA DE EXCLUSIÓN MUTUA DE CLIENTES
            // =========================================================
            function updateAvailableCustomers() {
                if (!servicesContainer) return;

                // 1. Recopilar qué clientes están seleccionados actualmente en toda la pantalla
                const allSelects = Array.from(servicesContainer.querySelectorAll<HTMLSelectElement>(".customer-select"));
                const selectedIds = new Set(allSelects.map(select => select.value).filter(val => val !== ""));

                // 2. Recorrer cada <select> y bloquear/desbloquear sus opciones
                allSelects.forEach(select => {
                    const currentValue = select.value;
                    const options = Array.from(select.options);

                    options.forEach(option => {
                        // Ignoramos el placeholder vacío
                        if (option.value === "") return;

                        // Restauramos el texto original (quitando emojis y avisos por si los tenía)
                        let originalText = option.textContent || "";
                        originalText = originalText.replace("🚫 ", "").replace(" (Ya seleccionado)", "");

                        // Si la opción está seleccionada en OTRO select distinto al actual
                        if (selectedIds.has(option.value) && option.value !== currentValue) {
                            option.disabled = true;
                            option.textContent = `🚫 ${originalText} (Ya seleccionado)`;
                            } else {
                            // Si está libre (o es la que tiene seleccionada este mismo select), la habilitamos
                            option.disabled = false;
                            option.textContent = originalText;
                            }
                        });
                    });
                }

            function updateServiceNumbers() {
                if (!servicesContainer || !emptyServices) return;

                const cards = servicesContainer.querySelectorAll(".service-card");

                cards.forEach((card, index) => {
                    const number = card.querySelector(".service-number");
                    if (number) number.textContent = String(index + 1);
                    });

                const emptyTitle = document.querySelector<HTMLElement>("#empty-services-title");
                const emptyDescription = document.querySelector<HTMLElement>("#empty-services-description");

                if (cards.length === 0) {
                    emptyServices.classList.remove("hidden");

                    if (customers.length === 0) {
                        if (emptyTitle) emptyTitle.textContent = "No se pueden añadir visitas";
                        if (emptyDescription) emptyDescription.textContent = "No hay clientes disponibles (todos están asignados).";
                        } else if (activeTechniciansCount === 0) {
                        if (emptyTitle) emptyTitle.textContent = "Bloqueado";
                        if (emptyDescription) emptyDescription.textContent = "Registra un técnico para proceder.";
                        } else {
                        if (emptyTitle) emptyTitle.textContent = "Aún no hay visitas programadas";
                        if (emptyDescription) emptyDescription.textContent = "Haz clic en 'Añadir Visita' en la parte superior.";
                        }
                    } else {
                    emptyServices.classList.add("hidden");
                    }
                }

            async function handleCreateRoute() {
                hideMessages();

                const routeDate = routeDateInput?.value.trim();
                const technicianId = technicianSelect?.value;

                if (customers.length === 0) {
                    showError("No hay clientes activos disponibles.");
                    return;
                    }

                if (activeTechniciansCount === 0) {
                    showError("No hay técnicos activos disponibles.");
                    return;
                    }

                if (!routeDate) {
                    showError("Debes seleccionar una fecha para programar la ruta.");
                    return;
                    }

                if (!technicianId) {
                    showError("Debes asignar un técnico responsable a esta ruta.");
                    return;
                    }

                const cards = servicesContainer?.querySelectorAll(".service-card");
                if (!cards || cards.length === 0) {
                    showError("Agrega al menos una visita a la ruta.");
                    return;
                    }

                const services: RouteServiceCreate[] = [];
                let isValid = true;
                const selectedCustomers = new Set<string>(); // Doble validación por seguridad

                cards.forEach(card => {
                    const customerSelect = card.querySelector<HTMLSelectElement>(".customer-select");
                    const serviceTypeSelect = card.querySelector<HTMLSelectElement>(".service-type-select");

                    const customerId = customerSelect?.value;
                    const serviceType = serviceTypeSelect?.value;

                    if (!customerId) {
                        showError("Te faltó seleccionar el cliente en una o más visitas.");
                        isValid = false;
                        return;
                        }

                    if (selectedCustomers.has(customerId)) {
                        showError("Has seleccionado al mismo cliente más de una vez en esta ruta. Verifícalo.");
                        isValid = false;
                        return;
                        }

                    selectedCustomers.add(customerId);

                    if (serviceType !== "S" && serviceType !== "R" && serviceType !== "A" && serviceType !== "CF") {
                        showError("Tipo de trabajo inválido seleccionado.");
                        isValid = false;
                        return;
                        }

                    services.push({ customer_id: customerId, service_type: serviceType });
                    });

                if (!isValid) return;

                try {
                    setLoading(true);
                    const route = await createRoute(routeDate, technicianId, services);
                    showSuccess("¡Asignación creada correctamente!");

                    setTimeout(() => {
                        window.location.href = `/routes/detail?id=${route.id}`;
                        }, 1000);

                    } catch (error) {
                    showError(error instanceof Error ? error.message : "Error del servidor. Intenta de nuevo.");
                    setLoading(false);
                    }
                }

            function updateFormAvailability() {
                const hasActiveCustomers = customers.length > 0;
                const hasActiveTechnicians = activeTechniciansCount > 0;
                const canAddService = hasActiveCustomers && hasActiveTechnicians;

                if (addServiceButton) {
                    addServiceButton.disabled = !canAddService;
                    }

                if (createRouteButton) {
                    createRouteButton.disabled = isSubmitting || !canAddService;
                    }
                }

            function setLoading(loading: boolean) {
                isSubmitting = loading;
                if (createRouteButton) {
                    createRouteButton.innerHTML = loading
                        ? `
                        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Guardando...
                      `
                        : "Crear Asignación";
                    }
                updateFormAvailability();
                }

            function showError(message: string) {
                if (!errorMessage) return;
                errorMessage.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <p>${message}</p>
                </div>
            `;
                errorMessage.classList.remove("hidden");
                }

            function showSuccess(message: string) {
                if (!successMessage) return;
                successMessage.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <p>${message}</p>
                </div>
            `;
                successMessage.classList.remove("hidden");
                }

            function hideMessages() {
                errorMessage?.classList.add("hidden");
                successMessage?.classList.add("hidden");
                }

            addServiceButton?.addEventListener("click", addService);
            createRouteButton?.addEventListener("click", handleCreateRoute);

            loadInitialData();
    </script>
</Layout>