---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Clientes">

    <main class="min-h-screen bg-slate-50/60 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- MENSAJE DE NOTIFICACIÓN -->
            <div
                    id="message"
                    class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"
            ></div>

            <!-- CABECERA -->
            <header class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="flex h-2.5 w-2.5 rounded-full bg-orange-500 animate-pulse"></span>
                        <span class="text-xs font-bold uppercase tracking-wider text-orange-600">Gestión de Clientes</span>
                    </div>
                    <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Clientes registrados
                    </h1>
                    <p class="mt-1 text-sm text-slate-500">
                        Administra y consulta de clientes.
                    </p>
                </div>

                <a
                        href="/customers/new"
                        class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-orange-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-orange-600/25 transition-all duration-200 hover:bg-orange-700 hover:shadow-orange-600/35 active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600"
                >
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M10 3a1 1 0 0 1 1 1v5h5a1 1 0 1 1 0 2h-5v5a1 1 0 1 1-2 0v-5H4a1 1 0 1 1 0-2h5V4a1 1 0 0 1 1-1Z" />
                    </svg>
                    <span>Nuevo cliente</span>
                </a>
            </header>

            <!-- TARJETAS RÁPIDAS DE RESUMEN (MÉTRICAS) -->
            <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Clientes</span>
                        <span class="rounded-xl bg-orange-50 p-2 text-orange-600">👥</span>
                    </div>
                    <div id="stat-total" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>

                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Activos</span>
                        <span class="rounded-xl bg-emerald-50 p-2 text-emerald-600">🟢</span>
                    </div>
                    <div id="stat-active" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>

                <div class="rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Inactivos</span>
                        <span class="rounded-xl bg-slate-100 p-2 text-slate-600">⚪</span>
                    </div>
                    <div id="stat-inactive" class="mt-2 text-2xl font-black text-slate-900">0</div>
                </div>
            </div>

            <!-- BUSCADOR -->
            <div class="mb-6 rounded-2xl bg-white p-4 shadow-sm border border-slate-200/80">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input
                            id="search"
                            type="search"
                            placeholder="Buscar por nombre, teléfono o localidad..."
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-3 pl-10 pr-4 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20"
                    />
                </div>
            </div>

            <!-- TABLA -->
            <div class="overflow-hidden rounded-2xl bg-white shadow-sm border border-slate-200/80">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50/75">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Cliente
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Teléfono
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Localidad
                            </th>
                            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">
                                Estado
                            </th>
                            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500">
                                Acciones
                            </th>
                        </tr>
                        </thead>
                        <tbody
                                id="customers-body"
                                class="divide-y divide-slate-100 bg-white"
                        >
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- VACÍO -->
            <div
                    id="empty"
                    class="mt-6 hidden rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-sm"
            >
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-orange-50 text-3xl shadow-inner">
                    👥
                </div>
                <h3 class="mt-4 text-lg font-bold text-slate-900">
                    No se encontraron clientes
                </h3>
                <p class="mt-1 text-sm text-slate-500">
                    No hay clientes que coincidan con la búsqueda realizada.
                </p>
            </div>

        </section>

    </main>


    <script>
        import {
            getCustomers,
            updateCustomerActive,
            deleteCustomer,
        } from "../../services/api";

        import type { Customer } from "../../types/customer";

        const customersBody = document.querySelector<HTMLTableSectionElement>("#customers-body");
        const searchInput = document.querySelector<HTMLInputElement>("#search");
        const emptyMessage = document.querySelector<HTMLDivElement>("#empty");
        const message = document.querySelector<HTMLDivElement>("#message");

        // Elementos de Estadísticas
        const statTotal = document.getElementById("stat-total");
        const statActive = document.getElementById("stat-active");
        const statInactive = document.getElementById("stat-inactive");

        let customers: Customer[] = [];

        function escapeHtml(value: string): string {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        function updateStats() {
            if (statTotal) statTotal.textContent = String(customers.length);
            if (statActive) statActive.textContent = String(customers.filter(c => c.active).length);
            if (statInactive) statInactive.textContent = String(customers.filter(c => !c.active).length);
        }

        async function loadCustomers() {
            try {
                customers = await getCustomers();
                updateStats();
                renderCustomers();
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudieron cargar los clientes.",
                    true,
                );
            }
        }

        function renderCustomers(search = "") {
            if (!customersBody || !emptyMessage) {
                return;
            }

            const query = search.trim().toLowerCase();

            const filtered = customers.filter(
                (customer) =>
                    customer.name.toLowerCase().includes(query) ||
                    customer.phone.toLowerCase().includes(query) ||
                    customer.location.toLowerCase().includes(query),
            );

            customersBody.innerHTML = "";

            if (filtered.length === 0) {
                emptyMessage.classList.remove("hidden");
                return;
            }

            emptyMessage.classList.add("hidden");
            customersBody.innerHTML = filtered.map((customer) => customerRow(customer)).join("");
            addEvents();
        }

        function statusSwitch(customer: Customer): string {
            const active = customer.active;

            return `
                <div class="flex items-center gap-3">
                    <button
                        type="button"
                        role="switch"
                        aria-checked="${active}"
                        aria-label="${active ? "Desactivar" : "Activar"} a ${escapeHtml(customer.name)}"
                        data-action="toggle"
                        data-id="${customer.id}"
                        data-active="${active}"
                        class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full transition-colors duration-200 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-50 ${
                active ? "bg-emerald-500" : "bg-slate-300"
            }"
                    >
                        <span
                            aria-hidden="true"
                            class="inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition-transform duration-200 ease-in-out ${
                active ? "translate-x-5" : "translate-x-0.5"
            }"
                        ></span>
                    </button>
                    <span class="w-16 text-xs font-bold whitespace-nowrap ${
                active ? "text-emerald-700" : "text-slate-500"
            }">
                        ${active ? "Activo" : "Inactivo"}
                    </span>
                </div>
            `;
        }

        function customerRow(customer: Customer): string {
            return `
                <tr class="transition-colors hover:bg-slate-50/80">
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">

                            <div>
                                <div class="font-bold text-slate-800">
                                    ${escapeHtml(customer.name)}
                                </div>
                                <div class="mt-0.5 text-xs font-medium text-slate-400">
                                    ${escapeHtml(customer.reference ?? "Sin referencia")}
                                </div>
                            </div>
                        </div>
                    </td>

                    <td class="px-6 py-4 text-sm font-medium text-slate-600 tabular-nums">
                        ${escapeHtml(customer.phone)}
                    </td>

                    <td class="px-6 py-4 text-sm font-medium text-slate-600">
                        ${escapeHtml(customer.location)}
                    </td>

                    <td class="px-6 py-4">
                        ${statusSwitch(customer)}
                    </td>

                    <td class="px-6 py-4">
                        <div class="flex items-center justify-end gap-1.5">
                            <a
                                href="/customers/edit?id=${customer.id}"
                                class="inline-flex items-center justify-center gap-1 rounded-xl bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700 transition-all hover:bg-blue-100 active:scale-95"
                                title="Editar cliente"
                            >
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                <span>Editar</span>
                            </a>

                            <button
                                type="button"
                                data-action="delete"
                                data-id="${customer.id}"
                                class="inline-flex items-center justify-center gap-1 rounded-xl bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 transition-all hover:bg-red-100 active:scale-95"
                                title="Eliminar cliente"
                            >
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                                <span>Eliminar</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }

        function addEvents() {
            document.querySelectorAll<HTMLButtonElement>("[data-action='toggle']").forEach((button) => {
                button.addEventListener("click", () =>
                    toggleCustomer(
                        button,
                        button.dataset.id,
                        button.dataset.active === "true",
                    ),
                );
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () =>
                    removeCustomer(button.dataset.id),
                );
            });
        }

        async function toggleCustomer(
            button: HTMLButtonElement,
            customerId?: string,
            currentActive = false,
        ) {
            if (!customerId) {
                return;
            }

            button.disabled = true;

            try {
                const updated = await updateCustomerActive(
                    customerId,
                    !currentActive,
                );

                customers = customers.map((customer) =>
                    customer.id === updated.id ? updated : customer,
                );

                updateStats();
                renderCustomers(searchInput?.value ?? "");
            } catch (error) {
                button.disabled = false;
                showMessage(
                    error instanceof Error ? error.message : "No se pudo actualizar el estado.",
                    true,
                );
            }
        }

        async function removeCustomer(customerId?: string) {
            if (!customerId) {
                return;
            }

            const confirmed = window.confirm("¿Seguro que deseas eliminar este cliente?");
            if (!confirmed) {
                return;
            }

            try {
                await deleteCustomer(customerId);

                customers = customers.filter((customer) => customer.id !== customerId);

                updateStats();
                renderCustomers(searchInput?.value ?? "");
                showMessage("Cliente eliminado correctamente.", false);
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudo eliminar el cliente.",
                    true,
                );
            }
        }

        function showMessage(text: string, isError: boolean) {
            if (!message) {
                return;
            }

            message.textContent = text;
            message.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-700 shadow-sm";
            message.classList.remove("hidden");
        }

        searchInput?.addEventListener("input", () => {
            renderCustomers(searchInput.value);
        });

        loadCustomers();
    </script>

</Layout>