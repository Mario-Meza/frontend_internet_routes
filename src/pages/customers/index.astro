---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Clientes">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- MENSAJE DE NOTIFICACIÓN -->
            <div
                    id="message"
                    class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"
            ></div>

            <!-- CABECERA -->
            <header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-blue-600">Directorio</span>
                    </div>
                    <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Clientes registrados
                    </h1>
                    <p class="mt-2 text-base text-slate-500 max-w-xl">
                        Administra la base de datos de tus clientes, su información de contacto y estado de servicio.
                    </p>
                </div>

                <a
                        href="/customers/new"
                        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600"
                >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    <span>Nuevo cliente</span>
                </a>
            </header>

            <!-- TARJETAS RÁPIDAS DE RESUMEN (MÉTRICAS) -->
            <div class="mb-10 grid grid-cols-1 gap-5 sm:grid-cols-3">

                <!-- Tarjeta: Total -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Clientes</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 ring-1 ring-inset ring-blue-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-total" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Activos -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg hover:ring-emerald-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Activos</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-active" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Inactivos -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg hover:ring-slate-300">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Inactivos</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500 ring-1 ring-inset ring-slate-200">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-inactive" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>
            </div>

            <!-- BUSCADOR -->
            <div class="mb-6 rounded-2xl bg-white p-4 shadow-sm border border-slate-200/80">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input
                            id="search"
                            type="search"
                            placeholder="Buscar por nombre, teléfono o localidad..."
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-3.5 pl-11 pr-4 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20"
                    />
                </div>
            </div>

            <!-- TABLA -->
            <div class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] ring-1 ring-slate-200/50">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Cliente
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Contacto
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Localidad
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Estado
                            </th>
                            <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-500">
                                Acciones
                            </th>
                        </tr>
                        </thead>
                        <tbody
                                id="customers-body"
                                class="divide-y divide-slate-100 bg-white"
                        >
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- VACÍO -->
            <div
                    id="empty"
                    class="mt-8 hidden rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center shadow-sm"
            >
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                    <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">
                    No se encontraron clientes
                </h3>
                <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                    Intenta cambiar los términos de búsqueda o registra a tu primer cliente en el sistema.
                </p>
                <button onclick="document.getElementById('search').focus()" class="mt-6 inline-flex items-center text-sm font-semibold text-orange-600 hover:text-orange-700">
                    Limpiar búsqueda <span aria-hidden="true" class="ml-1">→</span>
                </button>
            </div>

        </section>

    </main>


    <script>
        import {
            getCustomers,
            updateCustomerActive,
            deleteCustomer,
        } from "../../services/api";

        import type { Customer } from "../../types/customer";

        const customersBody = document.querySelector<HTMLTableSectionElement>("#customers-body");
        const searchInput = document.querySelector<HTMLInputElement>("#search");
        const emptyMessage = document.querySelector<HTMLDivElement>("#empty");
        const message = document.querySelector<HTMLDivElement>("#message");

        // Elementos de Estadísticas
        const statTotal = document.getElementById("stat-total");
        const statActive = document.getElementById("stat-active");
        const statInactive = document.getElementById("stat-inactive");

        let customers: Customer[] = [];

        function escapeHtml(value: string): string {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        // Avatar de colores dinámicos
        function getAvatarColor(name: string): string {
            const colors = [
                'bg-blue-100 text-blue-700', 'bg-cyan-100 text-cyan-700',
                'bg-teal-100 text-teal-700', 'bg-emerald-100 text-emerald-700',
                'bg-fuchsia-100 text-fuchsia-700', 'bg-indigo-100 text-indigo-700'
            ];
            const charCode = name.charCodeAt(0) || 0;
            return colors[charCode % colors.length];
        }

        function updateStats() {
            if (statTotal) statTotal.textContent = String(customers.length);
            if (statActive) statActive.textContent = String(customers.filter(c => c.active).length);
            if (statInactive) statInactive.textContent = String(customers.filter(c => !c.active).length);
        }

        async function loadCustomers() {
            try {
                customers = await getCustomers();
                updateStats();
                renderCustomers();
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudieron cargar los clientes.",
                    true,
                );
            }
        }

        function renderCustomers(search = "") {
            if (!customersBody || !emptyMessage) {
                return;
            }

            const query = search.trim().toLowerCase();

            const filtered = customers.filter(
                (customer) =>
                    customer.name.toLowerCase().includes(query) ||
                    customer.phone.toLowerCase().includes(query) ||
                    customer.location.toLowerCase().includes(query),
            );

            customersBody.innerHTML = "";

            if (filtered.length === 0) {
                emptyMessage.classList.remove("hidden");
                return;
            }

            emptyMessage.classList.add("hidden");
            customersBody.innerHTML = filtered.map((customer) => customerRow(customer)).join("");
            addEvents();
        }

        function statusSwitch(customer: Customer): string {
            const active = customer.active;

            return `
                <div class="flex items-center gap-3">
                    <button
                        type="button"
                        role="switch"
                        aria-checked="${active}"
                        aria-label="${active ? "Desactivar" : "Activar"} a ${escapeHtml(customer.name)}"
                        data-action="toggle"
                        data-id="${customer.id}"
                        data-active="${active}"
                        class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full transition-colors duration-200 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-50 ${
                active ? "bg-emerald-500" : "bg-slate-300"
            }"
                    >
                        <span
                            aria-hidden="true"
                            class="inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition-transform duration-200 ease-in-out ${
                active ? "translate-x-5" : "translate-x-0.5"
            }"
                        ></span>
                    </button>
                    <span class="w-16 text-xs font-bold whitespace-nowrap ${
                active ? "text-emerald-700" : "text-slate-500"
            }">
                        ${active ? "Activo" : "Inactivo"}
                    </span>
                </div>
            `;
        }

        function customerRow(customer: Customer): string {
            const avatarColor = getAvatarColor(customer.name);

            return `
                <tr class="group transition-colors hover:bg-slate-50">
                    
                    <!-- CLIENTE (AVATAR + NOMBRE + REFERENCIA) -->
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-4">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white" aria-hidden="true">
                                ${escapeHtml(getInitials(customer.name))}
                            </span>
                            <div>
                                <div class="text-sm font-bold text-slate-800">
                                    ${escapeHtml(customer.name)}
                                </div>
                                <div class="mt-0.5 flex items-center gap-1 text-xs font-medium text-slate-400">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    ${escapeHtml(customer.reference ?? "Sin referencia")}
                                </div>
                            </div>
                        </div>
                    </td>

                    <!-- TELÉFONO -->
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-2 text-sm font-medium text-slate-600">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                            <span class="tabular-nums">${escapeHtml(customer.phone)}</span>
                        </div>
                    </td>

                    <!-- LOCALIDAD -->
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-2 text-sm font-medium text-slate-600">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            ${escapeHtml(customer.location)}
                        </div>
                    </td>

                    <!-- ESTADO (TOGGLE) -->
                    <td class="px-6 py-5">
                        ${statusSwitch(customer)}
                    </td>

                    <!-- ACCIONES -->
                    <td class="px-6 py-5">
                        <div class="flex items-center justify-end gap-2 opacity-80 transition-opacity group-hover:opacity-100">
                            <a
                                href="/customers/edit?id=${customer.id}"
                                class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-blue-600 active:scale-95"
                                title="Editar información del cliente"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </a>

                            <button
                                type="button"
                                data-action="delete"
                                data-id="${customer.id}"
                                class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-red-50 hover:text-red-600 hover:ring-red-200 active:scale-95"
                                title="Eliminar cliente"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }

        function addEvents() {
            document.querySelectorAll<HTMLButtonElement>("[data-action='toggle']").forEach((button) => {
                button.addEventListener("click", () =>
                    toggleCustomer(
                        button,
                        button.dataset.id,
                        button.dataset.active === "true",
                    ),
                );
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () =>
                    removeCustomer(button.dataset.id),
                );
            });
        }

        async function toggleCustomer(
            button: HTMLButtonElement,
            customerId?: string,
            currentActive = false,
        ) {
            if (!customerId) {
                return;
            }

            button.disabled = true;

            try {
                const updated = await updateCustomerActive(
                    customerId,
                    !currentActive,
                );

                customers = customers.map((customer) =>
                    customer.id === updated.id ? updated : customer,
                );

                updateStats();
                renderCustomers(searchInput?.value ?? "");
                showMessage(`Cliente ${!currentActive ? 'activado' : 'desactivado'} correctamente.`, false);
            } catch (error) {
                button.disabled = false;
                showMessage(
                    error instanceof Error ? error.message : "No se pudo actualizar el estado.",
                    true,
                );
            }
        }

        async function removeCustomer(customerId?: string) {
            if (!customerId) {
                return;
            }

            const confirmed = window.confirm("¿Estás seguro de eliminar este cliente?\n\nEsta acción no se puede deshacer.");
            if (!confirmed) {
                return;
            }

            try {
                await deleteCustomer(customerId);

                customers = customers.filter((customer) => customer.id !== customerId);

                updateStats();
                renderCustomers(searchInput?.value ?? "");
                showMessage("Cliente eliminado correctamente.", false);
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudo eliminar el cliente.",
                    true,
                );
            }
        }

        function showMessage(text: string, isError: boolean) {
            if (!message) return;

            message.innerHTML = `
                <div class="flex items-center gap-3">
                    ${isError
                ? `<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                : `<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            }
                    <p>${text}</p>
                </div>
            `;
            message.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800 shadow-sm";
            message.classList.remove("hidden");

            // Ocultar mensaje automáticamente después de 4 segundos
            setTimeout(() => {
                message.classList.add("hidden");
            }, 4000);
        }

        searchInput?.addEventListener("input", () => {
            renderCustomers(searchInput.value);
        });

        loadCustomers();
    </script>

</Layout>