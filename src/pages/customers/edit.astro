---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Editar cliente">

    <main class="min-h-screen bg-slate-100">

        <section class="mx-auto max-w-3xl px-6 py-8">

            <form
                    id="customer-form"
                    class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200"
            >

                <div class="space-y-5">

                    <div>

                        <label
                                for="name"
                                class="mb-2 block text-sm font-semibold"
                        >
                            Nombre completo
                        </label>

                        <input
                                id="name"
                                required
                                maxlength="100"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                        />

                    </div>


                    <!-- Campo Teléfono (Con selector de extensión y input de dígitos) -->
                    <div>

                        <label
                                class="mb-2 block text-sm font-semibold"
                        >
                            Teléfono
                        </label>

                        <div class="flex gap-2">
                            <!-- Select para la extensión/código de país -->
                            <select
                                    id="phone-country"
                                    class="rounded-xl border border-slate-300 bg-white px-3 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                            >
                                <option value="+52">🇲🇽 +52 (México)</option>
                                <option value="+1">🇺🇸 +1 (EE. UU.)</option>
                            </select>

                            <!-- Input para los dígitos del número -->
                            <input
                                    id="phone-digits"
                                    type="tel"
                                    required
                                    maxlength="10"
                                    placeholder="5512345678"
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                            />
                        </div>

                    </div>


                    <div>

                        <label
                                for="location"
                                class="mb-2 block text-sm font-semibold"
                        >
                            Localidad
                        </label>

                        <input
                                id="location"
                                required
                                maxlength="100"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                        />

                    </div>


                    <div>

                        <label
                                for="reference"
                                class="mb-2 block text-sm font-semibold"
                        >
                            Referencia
                        </label>

                        <textarea
                                id="reference"
                                rows="3"
                                maxlength="250"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                        ></textarea>

                    </div>


                    <div
                            id="error"
                            class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"
                    ></div>


                    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                        <a
                                href="/customers"
                                class="rounded-xl border border-slate-300 px-6 py-3 text-center font-semibold text-slate-700"
                        >
                            Cancelar
                        </a>

                        <button
                                type="submit"
                                id="submit"
                                class="rounded-xl bg-orange-500 px-6 py-3 font-semibold text-white hover:bg-orange-600 disabled:opacity-50"
                        >
                            Guardar cambios
                        </button>

                    </div>

                </div>

            </form>

        </section>

    </main>


    <script>

        import {
            getCustomer,
            updateCustomer,
        } from "../../services/api";

        import type { CustomerUpdate } from "../../types/customer";


        const customerId =
            new URLSearchParams(
                window.location.search,
            ).get("id");


        const form =
            document.querySelector<HTMLFormElement>(
                "#customer-form",
            );


        const nameInput =
            document.querySelector<HTMLInputElement>(
                "#name",
            );


        const phoneCountrySelect =
            document.querySelector<HTMLSelectElement>(
                "#phone-country",
            );


        const phoneDigitsInput =
            document.querySelector<HTMLInputElement>(
                "#phone-digits",
            );


        const locationInput =
            document.querySelector<HTMLInputElement>(
                "#location",
            );


        const referenceInput =
            document.querySelector<HTMLTextAreaElement>(
                "#reference",
            );


        const submitButton =
            document.querySelector<HTMLButtonElement>(
                "#submit",
            );


        const error =
            document.querySelector<HTMLDivElement>(
                "#error",
            );


        function showError(message: string) {
            if (!error) return;

            error.textContent = message;
            error.classList.remove("hidden");
        }

        function hideError() {
            error?.classList.add("hidden");
        }


        function validateCustomer(
            name: string,
            phone: string,
            location: string,
            reference: string,
        ): string | null {
            if (!name.trim()) {
                return "El nombre del cliente es obligatorio.";
            }

            if (name.trim().length < 3) {
                return "El nombre debe tener al menos 3 caracteres.";
            }

            if (!phone.trim()) {
                return "El teléfono es obligatorio.";
            }

            const cleanPhone = phone.trim().replace(/[\s\-\(\)]/g, "");

            // Validar secuencias repetidas (ej. 0000000000)
            const digitsOnly = cleanPhone.replace("+", "");
            const pureNumber = digitsOnly.slice(-10);
            const isAllSameDigits = /^(\d)\1+$/.test(pureNumber);

            if (isAllSameDigits) {
                return "El número de teléfono no puede tener todos sus dígitos iguales.";
            }

            // Validar formato completo (Ej: +52XXXXXXXXXX o +1XXXXXXXXXX)
            const phoneRegex = /^(\+52|\+1)\d{10}$/;

            if (!phoneRegex.test(cleanPhone)) {
                return "Introduce un número de teléfono de 10 dígitos válido.";
            }

            if (!location.trim()) {
                return "La localidad es obligatoria.";
            }

            if (location.trim().length < 2) {
                return "La localidad debe tener al menos 2 caracteres.";
            }

            if (reference.trim().length > 250) {
                return "La referencia no puede superar los 250 caracteres.";
            }

            return null;
        }


        async function loadCustomer() {
            try {
                if (!customerId) {
                    throw new Error(
                        "No se encontró el ID del cliente.",
                    );
                }

                const customer = await getCustomer(customerId);

                if (nameInput) {
                    nameInput.value = customer.name;
                }

                // Separar el teléfono de la BD para asignarlo al select y al input
                if (phoneCountrySelect && phoneDigitsInput && customer.phone) {
                    let code = "+52";
                    let digits = customer.phone;

                    if (customer.phone.startsWith("+1")) {
                        code = "+1";
                        digits = customer.phone.replace("+1", "");
                    } else if (customer.phone.startsWith("+52")) {
                        code = "+52";
                        digits = customer.phone.replace("+52", "");
                    }

                    phoneCountrySelect.value = code;
                    phoneDigitsInput.value = digits;
                }

                if (locationInput) {
                    locationInput.value = customer.location;
                }

                if (referenceInput) {
                    referenceInput.value = customer.reference ?? "";
                }
            } catch (err) {
                showError(
                    err instanceof Error
                        ? err.message
                        : "No se pudo cargar el cliente.",
                );
            }
        }


        form?.addEventListener(
            "submit",
            async (event) => {
                event.preventDefault();
                hideError();

                if (!customerId) {
                    showError("No se encontró el ID del cliente.");
                    return;
                }

                // Unir la extensión seleccionada con los dígitos ingresados
                const countryCode = phoneCountrySelect?.value ?? "+52";
                const digits = phoneDigitsInput?.value.trim() ?? "";
                const fullPhone = `${countryCode}${digits}`;

                const customer: CustomerUpdate = {
                    name: nameInput?.value.trim(),
                    phone: fullPhone,
                    location: locationInput?.value.trim(),
                    reference: referenceInput?.value.trim() || null,
                };

                // Validar antes de enviar
                const validationError = validateCustomer(
                    customer.name ?? "",
                    customer.phone ?? "",
                    customer.location ?? "",
                    customer.reference ?? "",
                );

                if (validationError) {
                    showError(validationError);
                    return;
                }

                try {
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = "Guardando...";
                    }

                    await updateCustomer(customerId, customer);

                    window.location.href = "/customers";
                } catch (err) {
                    showError(
                        err instanceof Error
                            ? err.message
                            : "No se pudo actualizar el cliente.",
                    );
                } finally {
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.textContent = "Guardar cambios";
                    }
                }
            },
        );


        loadCustomer();

    </script>

</Layout>