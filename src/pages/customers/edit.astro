---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Editar cliente">

    <main class="min-h-screen bg-slate-50/50">

        <section class="mx-auto max-w-3xl px-6 py-10 sm:py-14">

            <!-- CABECERA -->
            <header class="mb-8">
                <a href="/customers" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-blue-600 transition-colors">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Volver a directorio
                </a>
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-blue-600 shadow-sm ring-1 ring-inset ring-blue-200">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-3xl font-black tracking-tight text-slate-900">
                            Editar cliente
                        </h1>
                        <p class="mt-1 text-sm text-slate-500">
                            Actualiza la información de contacto o referencias del domicilio[cite: 29].
                        </p>
                    </div>
                </div>
            </header>


            <form
                    id="customer-form"
                    class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07)] ring-1 ring-slate-200/50"
            >

                <div class="p-6 sm:p-10">
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">

                        <!-- Campo Nombre Completo -->
                        <div class="sm:col-span-2">
                            <label
                                    for="name"
                                    class="mb-2 block text-sm font-bold text-slate-700"
                            >
                                Nombre completo
                            </label>
                            <input
                                    id="name"
                                    name="name"
                                    required
                                    maxlength="100"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                            />
                        </div>


                        <!-- Campo Teléfono -->
                        <div class="sm:col-span-1">
                            <label class="mb-2 block text-sm font-bold text-slate-700">
                                Teléfono móvil
                            </label>
                            <div class="flex gap-2">
                                <select
                                        id="phone-country"
                                        class="w-[110px] shrink-0 appearance-none rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm font-medium outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                                >
                                    <option value="+52">🇲🇽 +52</option>
                                    <option value="+1">🇺🇸 +1</option>
                                </select>

                                <input
                                        id="phone-digits"
                                        type="tel"
                                        required
                                        maxlength="10"
                                        placeholder="55 1234 5678"
                                        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                                />
                            </div>
                        </div>


                        <!-- Campo Localidad -->
                        <div class="sm:col-span-1">
                            <label
                                    for="location"
                                    class="mb-2 block text-sm font-bold text-slate-700"
                            >
                                Localidad o Sector
                            </label>
                            <input
                                    id="location"
                                    name="location"
                                    required
                                    maxlength="100"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                            />
                        </div>


                        <!-- Campo Referencia -->
                        <div class="sm:col-span-2">
                            <label
                                    for="reference"
                                    class="mb-2 block text-sm font-bold text-slate-700"
                            >
                                Referencias del domicilio (Opcional)
                            </label>
                            <textarea
                                    id="reference"
                                    name="reference"
                                    rows="3"
                                    maxlength="250"
                                    class="w-full resize-none rounded-xl border border-slate-300 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                            ></textarea>
                            <p class="mt-2 text-xs font-medium text-slate-400">Ayuda al técnico a localizar el domicilio más rápido.</p>
                        </div>

                    </div>

                    <div
                            id="error"
                            class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700"
                    ></div>

                </div>

                <!-- Footer Formulario -->
                <div class="border-t border-slate-100 bg-slate-50/50 px-6 py-6 sm:flex sm:items-center sm:justify-end sm:gap-3 sm:px-10">
                    <a
                            href="/customers"
                            class="mb-3 block w-full rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-center text-sm font-bold text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.98] sm:mb-0 sm:w-auto"
                    >
                        Cancelar
                    </a>

                    <button
                            type="submit"
                            id="submit"
                            class="block w-full rounded-xl bg-orange-600 px-6 py-3.5 text-center text-sm font-bold text-white shadow-md shadow-orange-500/30 transition hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                    >
                        Guardar cambios
                    </button>
                </div>

            </form>

        </section>

    </main>


    <script>
        import {
            getCustomer,
            updateCustomer,
            } from "../../services/api";

            import type { CustomerUpdate } from "../../types/customer";

            const customerId = new URLSearchParams(window.location.search).get("id");

            const form = document.querySelector<HTMLFormElement>("#customer-form");
            const nameInput = document.querySelector<HTMLInputElement>("#name");
            const phoneCountrySelect = document.querySelector<HTMLSelectElement>("#phone-country");
            const phoneDigitsInput = document.querySelector<HTMLInputElement>("#phone-digits");
            const locationInput = document.querySelector<HTMLInputElement>("#location");
            const referenceInput = document.querySelector<HTMLTextAreaElement>("#reference");
            const submitButton = document.querySelector<HTMLButtonElement>("#submit");
            const error = document.querySelector<HTMLDivElement>("#error");

            function showError(message: string) {
                if (!error) return;
                error.innerHTML = `
                <div class="flex items-center gap-3">
                    <svg class="h-5 w-5 text-red-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <p>${message}</p>
                </div>
            `;
                error.classList.remove("hidden");
                }

            function hideError() {
                error?.classList.add("hidden");
                }

            function validateCustomer(
                name: string,
                phone: string,
                location: string,
                reference: string,
                ): string | null {
                if (!name.trim()) return "El nombre del cliente es obligatorio.";
                if (name.trim().length < 3) return "El nombre debe tener al menos 3 caracteres.";
                if (!phone.trim()) return "El teléfono es obligatorio.";

                const cleanPhone = phone.trim().replace(/[\s\-\(\)]/g, "");
                const digitsOnly = cleanPhone.replace("+", "");
                const pureNumber = digitsOnly.slice(-10);
                const isAllSameDigits = /^(\d)\1+$/.test(pureNumber);

                if (isAllSameDigits) return "El número de teléfono no puede tener todos sus dígitos iguales.";

                const phoneRegex = /^(\+52|\+1)\d{10}$/;
                if (!phoneRegex.test(cleanPhone)) return "Introduce un número de teléfono de 10 dígitos válido.";

                if (!location.trim()) return "La localidad es obligatoria.";
                if (location.trim().length < 2) return "La localidad debe tener al menos 2 caracteres.";
                if (reference.trim().length > 250) return "La referencia no puede superar los 250 caracteres.";

                return null;
                }

            async function loadCustomer() {
                try {
                    if (!customerId) throw new Error("No se encontró el ID del cliente.");

                    const customer = await getCustomer(customerId);

                    if (nameInput) nameInput.value = customer.name;

                    if (phoneCountrySelect && phoneDigitsInput && customer.phone) {
                        let code = "+52";
                        let digits = customer.phone;

                        if (customer.phone.startsWith("+1")) {
                            code = "+1";
                            digits = customer.phone.replace("+1", "");
                            } else if (customer.phone.startsWith("+52")) {
                            code = "+52";
                            digits = customer.phone.replace("+52", "");
                            }

                        phoneCountrySelect.value = code;
                        phoneDigitsInput.value = digits;
                        }

                    if (locationInput) locationInput.value = customer.location;
                    if (referenceInput) referenceInput.value = customer.reference ?? "";

                    } catch (err) {
                    showError(err instanceof Error ? err.message : "No se pudo cargar la información del cliente.");
                    }
                }

            form?.addEventListener("submit", async (event) => {
                event.preventDefault();
                hideError();

                if (!customerId) {
                    showError("No se encontró el ID del cliente.");
                    return;
                    }

                const countryCode = phoneCountrySelect?.value ?? "+52";
                const digits = phoneDigitsInput?.value.trim() ?? "";
                const fullPhone = `${countryCode}${digits}`;

                const customer: CustomerUpdate = {
                    name: nameInput?.value.trim(),
                    phone: fullPhone,
                    location: locationInput?.value.trim(),
                    reference: referenceInput?.value.trim() || null,
                    };

                const validationError = validateCustomer(
                    customer.name ?? "",
                    customer.phone ?? "",
                    customer.location ?? "",
                    customer.reference ?? "",
                    );

                if (validationError) {
                    showError(validationError);
                    return;
                    }

                try {
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = `
                        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Actualizando datos...
                    `;
                        }

                    await updateCustomer(customerId, customer);
                    window.location.href = "/customers";

                    } catch (err) {
                    showError(err instanceof Error ? err.message : "No se pudo actualizar la información del cliente.");
                    } finally {
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.textContent = "Guardar cambios";
                        }
                    }
                });

            loadCustomer();
    </script>
</Layout>