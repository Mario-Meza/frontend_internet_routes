---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Nuevo cliente">

    <main class="min-h-screen bg-slate-100">

        <header class="bg-slate-900">

        </header>


        <section class="mx-auto max-w-3xl px-6 py-8">

            <form
                    id="customer-form"
                    class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200"
            >

                <div class="space-y-5">

                    <!-- Campo Nombre Completo -->
                    <div>

                        <label
                                for="name"
                                class="mb-2 block text-sm font-semibold"
                        >
                            Nombre completo
                        </label>

                        <input
                                id="name"
                                name="name"
                                required
                                maxlength="100"
                                placeholder="Ej. Juan Pérez"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                        />

                    </div>


                    <!-- Campo Teléfono (Con selector de extensión y input de dígitos) -->
                    <div>

                        <label
                                class="mb-2 block text-sm font-semibold"
                        >
                            Teléfono
                        </label>

                        <div class="flex gap-2">
                            <!-- Select para la extensión/código de país -->
                            <select
                                    id="phone-country"
                                    class="rounded-xl border border-slate-300 bg-white px-3 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                            >
                                <option value="+52">🇲🇽 +52 (México)</option>
                                <option value="+1">🇺🇸 +1 (EE. UU.)</option>
                            </select>

                            <!-- Input para los dígitos del número -->
                            <input
                                    id="phone-digits"
                                    type="tel"
                                    required
                                    maxlength="10"
                                    placeholder="5512345678"
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                            />
                        </div>

                    </div>


                    <!-- Campo Localidad -->
                    <div>

                        <label
                                for="location"
                                class="mb-2 block text-sm font-semibold"
                        >
                            Localidad
                        </label>

                        <input
                                id="location"
                                name="location"
                                required
                                maxlength="100"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                        />

                    </div>


                    <!-- Campo Referencia -->
                    <div>

                        <label
                                for="reference"
                                class="mb-2 block text-sm font-semibold"
                        >
                            Referencia
                        </label>

                        <textarea
                                id="reference"
                                name="reference"
                                rows="3"
                                maxlength="250"
                                placeholder="Ej. Cerca de la iglesia..."
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none focus:border-orange-500 focus:ring-2 focus:ring-orange-100"
                        ></textarea>

                    </div>


                    <div
                            id="error"
                            class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"
                    ></div>


                    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                        <a
                                href="/customers"
                                class="rounded-xl border border-slate-300 px-6 py-3 text-center font-semibold text-slate-700"
                        >
                            Cancelar
                        </a>

                        <button
                                type="submit"
                                id="submit"
                                class="rounded-xl bg-orange-500 px-6 py-3 font-semibold text-white hover:bg-orange-600 disabled:opacity-50"
                        >
                            Guardar cliente
                        </button>

                    </div>

                </div>

            </form>

        </section>

    </main>


    <script>

        import { createCustomer } from "../../services/api";

        import type { CustomerCreate } from "../../types/customer";


        const form =
            document.querySelector<HTMLFormElement>(
                "#customer-form",
            );


        const submitButton =
            document.querySelector<HTMLButtonElement>(
                "#submit",
            );


        const error =
            document.querySelector<HTMLDivElement>(
                "#error",
            );


        const phoneCountrySelect =
            document.querySelector<HTMLSelectElement>(
                "#phone-country",
            );


        const phoneDigitsInput =
            document.querySelector<HTMLInputElement>(
                "#phone-digits",
            );


        function showError(message: string) {
            if (!error) return;

            error.textContent = message;
            error.classList.remove("hidden");
        }

        function hideError() {
            error?.classList.add("hidden");
        }

        function validateCustomer(
            name: string,
            phone: string,
            location: string,
            reference: string,
        ): string | null {
            // 1. Validar nombre
            if (!name.trim()) {
                return "El nombre del cliente es obligatorio.";
            }

            if (name.trim().length < 3) {
                return "El nombre debe tener al menos 3 caracteres.";
            }

            // 2. Validar teléfono
            if (!phone.trim()) {
                return "El teléfono es obligatorio.";
            }

            // Limpiar espacios o guiones
            const cleanPhone = phone.trim().replace(/[\s\-\(\)]/g, "");

            // Validar secuencias repetidas (ej. +520000000000)
            const digitsOnly = cleanPhone.replace("+", "");
            // Tomamos solo los últimos 10 dígitos para revisar si son puros ceros/unos repetidos
            const pureNumber = digitsOnly.slice(-10);
            const isAllSameDigits = /^(\d)\1+$/.test(pureNumber);

            if (isAllSameDigits) {
                return "El número de teléfono no puede tener todos sus dígitos iguales.";
            }

            // Validar formato completo (Ej: +52XXXXXXXXXX o +1XXXXXXXXXX)
            const phoneRegex = /^(\+52|\+1)\d{10}$/;

            if (!phoneRegex.test(cleanPhone)) {
                return "Introduce un número de teléfono de 10 dígitos válido.";
            }

            // 3. Validar localidad
            if (!location.trim()) {
                return "La localidad es obligatoria.";
            }

            if (location.trim().length < 2) {
                return "La localidad debe tener al menos 2 caracteres.";
            }

            // 4. Validar referencia (opcional, máximo 250 caracteres)
            if (reference.trim().length > 250) {
                return "La referencia no puede superar los 250 caracteres.";
            }

            return null;
        }

        form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            hideError();

            const formData = new FormData(form);

            // Unir la extensión seleccionada con los dígitos ingresados
            const countryCode = phoneCountrySelect?.value ?? "+52";
            const digits = phoneDigitsInput?.value.trim() ?? "";
            const fullPhone = `${countryCode}${digits}`;

            const customer: CustomerCreate = {
                name: String(formData.get("name") ?? "").trim(),
                phone: fullPhone,
                location: String(formData.get("location") ?? "").trim(),
                reference: String(formData.get("reference") ?? "").trim() || null,
            };

            // Validar antes de enviar
            const validationError = validateCustomer(
                customer.name,
                customer.phone,
                customer.location,
                customer.reference ?? "",
            );

            if (validationError) {
                showError(validationError);
                return;
            }

            try {
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.textContent = "Guardando...";
                }

                await createCustomer(customer);

                window.location.href = "/customers";
            } catch (err) {
                showError(
                    err instanceof Error
                        ? err.message
                        : "No se pudo crear el cliente.",
                );
            } finally {
                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.textContent = "Guardar cliente";
                }
            }
        });

    </script>

</Layout>