---
// src/pages/panel/index.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Mi Panel - Rutas Digitales">
    <main class="min-h-screen bg-slate-50/80 pb-24">

        <!-- CABECERA FIJA ESTILO APP NATIVA -->
        <header class="sticky top-0 z-20 flex items-center justify-between border-b border-slate-200/80 bg-white/90 px-5 py-4 backdrop-blur-md shadow-sm">
            <div class="flex items-center gap-3">

                <!-- AVATAR DINÁMICO DEL TÉCNICO -->
                <div id="tech-avatar-container" class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-slate-400 shadow-sm ring-2 ring-slate-200/50">
                    <!-- Ícono de usuario por defecto mientras carga o si hay un error con el token -->
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>

                <div>
                    <h1 class="text-lg font-black tracking-tight text-slate-900 leading-none">Mis Rutas</h1>
                    <p class="mt-1 text-xs font-semibold text-slate-500">Asignaciones en campo</p>
                </div>
            </div>

            <button id="logout-btn" class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-red-50 hover:text-red-600 active:scale-95" title="Cerrar sesión">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
            </button>
        </header>

        <!-- CONTENEDOR DE RUTAS -->
        <div class="px-4 pt-6 sm:px-6">

            <!-- Título de sección -->
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400">Trabajo para hoy</h2>
                <span id="routes-count" class="hidden rounded-full bg-slate-200 px-2 py-0.5 text-xs font-bold text-slate-600">0</span>
            </div>

            <!-- Aquí se inyectarán las rutas -->
            <div id="routes-container" class="space-y-4">

                <!-- Skeleton Loading Inicial -->
                <div class="animate-pulse overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
                    <div class="p-5">
                        <div class="mb-4 flex justify-between">
                            <div class="h-5 w-20 rounded-md bg-slate-200"></div>
                            <div class="h-5 w-16 rounded-md bg-slate-200"></div>
                        </div>
                        <div class="h-4 w-32 rounded-md bg-slate-200 mb-2"></div>
                        <div class="h-3 w-24 rounded-md bg-slate-200"></div>
                    </div>
                    <div class="bg-slate-50 px-5 py-4">
                        <div class="h-11 w-full rounded-xl bg-slate-200"></div>
                    </div>
                </div>

                <div class="animate-pulse overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 opacity-50">
                    <div class="p-5">
                        <div class="mb-4 flex justify-between">
                            <div class="h-5 w-20 rounded-md bg-slate-200"></div>
                            <div class="h-5 w-16 rounded-md bg-slate-200"></div>
                        </div>
                        <div class="h-4 w-32 rounded-md bg-slate-200 mb-2"></div>
                        <div class="h-3 w-24 rounded-md bg-slate-200"></div>
                    </div>
                    <div class="bg-slate-50 px-5 py-4">
                        <div class="h-11 w-full rounded-xl bg-slate-200"></div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script>
        import { getRoutes } from "../../services/api";

        const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000/api/v1";
        const token = localStorage.getItem("auth_token");

        // 1. Redirección dura si no hay sesión
        if (!token) {
            window.location.href = "/login";
        }

        // 2. EXTRAER DATOS DEL JWT
        function decodeJWT(token: string) {
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                return JSON.parse(window.atob(base64));
            } catch (e) {
                return null;
            }
        }

        const userData = decodeJWT(token || "");
        const avatarContainer = document.getElementById("tech-avatar-container");

        // 3. NUEVO: CARGAR LA FOTO REAL DESDE LA BASE DE DATOS
        async function loadTechnicianAvatar() {
            if (!userData || !userData.id || !avatarContainer) return;

            try {
                // Consultamos el perfil de este técnico específico para obtener su 'photo_url'
                const res = await fetch(`${API_URL}/technicians/${userData.id}`, {
                    headers: { "Authorization": `Bearer ${token}` }
                });

                if (res.ok) {
                    const tech = await res.json();

                    // Extraemos la foto de la misma forma robusta que lo hace el administrador
                    const photoUrl = tech.photo_url || tech.photo || `${API_URL}/technicians/${tech.id}/photo`;
                    const initial = tech.name ? tech.name.charAt(0).toUpperCase() : 'T';

                    avatarContainer.innerHTML = `
                        <img 
                            src="${photoUrl}" 
                            alt="Perfil del técnico" 
                            class="h-full w-full object-cover"
                            onerror="this.onerror=null; this.outerHTML='<div class=\\'flex h-full w-full shrink-0 items-center justify-center bg-blue-100 text-blue-700 text-sm font-black\\'>${initial}</div>';"
                        />
                    `;
                }
            } catch (error) {
                console.error("No se pudo cargar la foto de perfil del técnico");
            }
        }

        // Ejecutamos la carga del avatar inmediatamente
        loadTechnicianAvatar();


        // 4. Lógica de cierre de sesión
        document.getElementById("logout-btn")?.addEventListener("click", () => {
            if(confirm("¿Seguro que deseas salir de la aplicación?")) {
                localStorage.removeItem("auth_token");
                localStorage.removeItem("user_role");
                window.location.href = "/login";
            }
        });

        // 5. Formateador de fechas
        function formatDate(dateString: string) {
            if (!dateString) return "Fecha sin definir";
            const [year, month, day] = dateString.split("-");
            const date = new Date(Number(year), Number(month) - 1, Number(day));
            return date.toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).replace('.', '');
        }

        // 6. Formateador de Estados
        function renderStatus(status: string) {
            const config: Record<string, { label: string; bg: string; text: string; dot: string; }> = {
                assigned: { label: "PENDIENTE", bg: "bg-orange-100", text: "text-orange-700", dot: "bg-orange-500" },
                in_progress: { label: "EN PROCESO", bg: "bg-blue-100", text: "text-blue-700", dot: "bg-blue-500 animate-pulse" },
                completed: { label: "COMPLETADA", bg: "bg-emerald-100", text: "text-emerald-700", dot: "bg-emerald-500" },
                canceled: { label: "CANCELADA", bg: "bg-red-100", text: "text-red-700", dot: "bg-red-500" }
            };

            const current = config[status] ?? { label: status || "N/A", bg: "bg-slate-100", text: "text-slate-600", dot: "bg-slate-400" };

            return `
                <span class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[10px] font-black tracking-wider ${current.bg} ${current.text}">
                    <span class="h-1.5 w-1.5 rounded-full ${current.dot}"></span>
                    ${current.label}
                </span>
            `;
        }

        // 7. Cargar Rutas
        async function loadMyRoutes() {
            const container = document.getElementById("routes-container");
            const countBadge = document.getElementById("routes-count");
            if (!container) return;

            try {
                const routes = await getRoutes();

                if(countBadge) {
                    countBadge.textContent = routes.length.toString();
                    countBadge.classList.remove("hidden");
                }

                if (routes.length === 0) {
                    container.innerHTML = `
                        <div class="mt-8 overflow-hidden rounded-3xl bg-white p-10 text-center shadow-sm ring-1 ring-slate-200">
                            <div class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-emerald-50 ring-8 ring-emerald-50/50">
                                <svg class="h-10 w-10 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-black tracking-tight text-slate-900">¡Todo despejado!</h3>
                            <p class="mt-2 text-sm font-medium text-slate-500 leading-relaxed">No tienes asignaciones pendientes por el momento. Puedes descansar o esperar nuevas instrucciones.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = routes.map(route => {
                    const totalServices = route.services ? route.services.length : 0;
                    const serviceText = totalServices === 1 ? '1 servicio' : `${totalServices} servicios`;
                    const shortId = route.id.substring(0, 8).toUpperCase();

                    const isFinished = route.status === 'completed' || route.status === 'canceled';

                    return `
                        <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition active:scale-[0.98]">
                            
                            <div class="p-5">
                                <div class="mb-3 flex items-start justify-between">
                                    ${renderStatus(route.status)}
                                    <span class="inline-flex items-center gap-1 rounded-lg bg-slate-50 px-2 py-1 text-xs font-bold text-slate-500 ring-1 ring-inset ring-slate-200">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        ${formatDate(route.route_date)}
                                    </span>
                                </div>
                                
                                <h3 class="text-lg font-black tracking-tight text-slate-900">
                                    Asignación <span class="text-slate-400">#${shortId}</span>
                                </h3>
                                
                                <div class="mt-2 flex items-center gap-2 text-sm font-semibold text-slate-500">
                                    <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                    Incluye ${serviceText}
                                </div>
                            </div>
                            
                            <div class="border-t border-slate-100 bg-slate-50 p-4">
                                <a 
                                    href="/panel/ruta?id=${route.id}" 
                                    class="flex w-full items-center justify-center gap-2 rounded-xl px-4 py-3.5 text-sm font-bold transition-colors ${
                        isFinished
                            ? 'bg-slate-200 text-slate-600 hover:bg-slate-300'
                            : 'bg-blue-600 text-white shadow-md shadow-blue-500/25 hover:bg-blue-700'
                    }"
                                >
                                    ${isFinished ? 'Ver resumen' : 'Revisar detalles e iniciar'}
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </a>
                            </div>

                        </div>
                    `;
                }).join('');

            } catch (error) {
                container.innerHTML = `
                    <div class="mt-4 flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-red-200 bg-white p-8 text-center shadow-sm">
                        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-red-50 text-red-500">
                            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <p class="text-sm font-bold text-slate-800">Error de conexión</p>
                        <p class="mt-1 text-xs text-slate-500">No pudimos descargar tus asignaciones.</p>
                        <button onclick="window.location.reload()" class="mt-4 rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-bold text-white shadow-sm transition active:scale-95">
                            Reintentar
                        </button>
                    </div>
                `;
            }
        }

        loadMyRoutes();
    </script>
</Layout>