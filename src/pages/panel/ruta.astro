---
// src/pages/panel/ruta.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Detalle de Instalación - Rutas Digitales">
    <main class="min-h-screen bg-slate-50/80 pb-28">

        <!-- CABECERA FIJA -->
        <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/90 px-4 py-4 backdrop-blur-md shadow-sm sm:px-6">
            <div class="flex items-center gap-4">
                <a href="/panel" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-slate-200 active:scale-95">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <div class="flex-1">
                    <h1 class="text-lg font-black tracking-tight text-slate-900 leading-none">Hoja de Trabajo</h1>
                    <p id="route-id-display" class="mt-1 flex items-center gap-1 text-xs font-bold text-slate-500">
                        <svg class="animate-spin h-3 w-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle class="opacity-25" cx="12" cy="12" r="10" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        Cargando ruta...
                    </p>
                </div>
            </div>
        </header>

        <!-- CONTENEDOR DE SERVICIOS -->
        <div class="px-4 pt-6 sm:px-6">
            <h2 class="mb-4 text-sm font-bold uppercase tracking-widest text-slate-400">Clientes a visitar</h2>

            <div id="service-container" class="space-y-5">
                <!-- Skeleton de Carga -->
                <div class="animate-pulse overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
                    <div class="p-5 border-b border-slate-100">
                        <div class="h-6 w-48 rounded-md bg-slate-200 mb-4"></div>
                        <div class="h-4 w-full rounded-md bg-slate-100 mb-2"></div>
                        <div class="h-4 w-32 rounded-md bg-slate-100"></div>
                    </div>
                    <div class="p-4 bg-slate-50">
                        <div class="h-12 w-full rounded-xl bg-slate-200"></div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- MODAL DE OBSERVACIONES (Estilo Bottom Sheet en móviles) -->
    <div id="observations-modal" class="hidden fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-4 backdrop-blur-sm sm:items-center transition-opacity duration-300">
        <div class="w-full max-w-lg transform overflow-hidden rounded-3xl bg-white shadow-2xl transition-transform duration-300 translate-y-0">

            <!-- Indicador de arrastre visual para móviles -->
            <div class="flex w-full items-center justify-center pt-3 pb-1 sm:hidden">
                <div class="h-1.5 w-12 rounded-full bg-slate-200"></div>
            </div>

            <div class="p-6 pt-2 sm:pt-8 sm:p-8">
                <div class="mb-5 flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 ring-4 ring-emerald-50">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-slate-900">Finalizar Instalación</h3>
                        <p class="mt-0.5 text-sm font-medium text-slate-500">Añade los detalles técnicos del trabajo.</p>
                    </div>
                </div>

                <div class="mt-2">
                    <label for="service-notes" class="mb-2 block text-xs font-bold uppercase tracking-widest text-slate-500">
                        Observaciones (Opcional)
                    </label>
                    <textarea
                            id="service-notes"
                            rows="4"
                            placeholder="Ej. Router TL-WR850N configurado. Cable Cat5E de 15m grapado. Señal al 100%..."
                            class="w-full resize-none rounded-2xl border border-slate-300 bg-slate-50 p-4 text-sm text-slate-900 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/20"
                    ></textarea>
                </div>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row-reverse">
                    <button id="confirm-complete" class="flex w-full items-center justify-center rounded-xl bg-emerald-600 px-6 py-4 text-sm font-bold text-white shadow-md shadow-emerald-500/30 transition hover:bg-emerald-700 active:scale-[0.98]">
                        Confirmar y Terminar
                    </button>
                    <button id="cancel-modal" class="flex w-full items-center justify-center rounded-xl bg-slate-100 px-6 py-4 text-sm font-bold text-slate-700 transition hover:bg-slate-200 active:scale-[0.98]">
                        Regresar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        import { getRoute, startService, completeService } from "../../services/api";

            const urlParams = new URLSearchParams(window.location.search);
            const routeId = urlParams.get("id");

            const container = document.getElementById("service-container");
            const routeIdDisplay = document.getElementById("route-id-display");

            // Elementos del Modal
            const modal = document.getElementById("observations-modal");
            const cancelModalBtn = document.getElementById("cancel-modal") as HTMLButtonElement;
            const confirmCompleteBtn = document.getElementById("confirm-complete") as HTMLButtonElement;
            const notesInput = document.getElementById("service-notes") as HTMLTextAreaElement;

            let currentServiceId: string | null = null;

            // Proteger ruta
            if (!localStorage.getItem("auth_token")) {
                window.location.href = "/login";
                }

            function formatDisplayStatus(statusLower: string) {
                const isPending = statusLower === 'pending' || statusLower === 'pendiente';
                const isInProgress = statusLower === 'in_progress' || statusLower === 'en_progreso';
                const isCompleted = statusLower === 'completed' || statusLower === 'completada';

                return {
                    isPending,
                    isInProgress,
                    isCompleted,
                    text: isPending ? 'PENDIENTE' : isInProgress ? 'EN PROCESO' : isCompleted ? 'COMPLETADO' : statusLower.toUpperCase()
                    };
                }

            async function loadRouteDetails() {
                if (!routeId || !container || !routeIdDisplay) return;

                try {
                    const route = await getRoute(routeId);

                    // Actualiza título superior
                    routeIdDisplay.innerHTML = `
                    <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
                    Asignación #${route.id.substring(0, 8).toUpperCase()}
                        `;

                    if (route.services && route.services.length > 0) {
                        container.innerHTML = route.services.map((service, index) => {
                            const customer = service.customer;
                            const status = formatDisplayStatus(service.status.toLowerCase());

                            return `
                        <div class="relative overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition-all ${status.isCompleted ? 'opacity-80' : ''}">
                            
                            <!-- Borde de color lateral (Indicador rápido de estado) -->
                            <div class="absolute bottom-0 left-0 top-0 w-1.5 ${status.isPending ? 'bg-orange-400' : status.isInProgress ? 'bg-blue-500' : 'bg-emerald-500'}"></div>
                            
                            <div class="p-5 pl-6 border-b border-slate-100">
                                <div class="flex justify-between items-start mb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="flex h-6 w-6 items-center justify-center rounded-md bg-slate-100 text-xs font-black text-slate-500">
                                            ${index + 1}
                                        </span>
                                        <h2 class="text-lg font-black text-slate-900 leading-tight">${customer?.name || 'Sin nombre'}</h2>
                                    </div>
                                    <span class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[10px] font-black tracking-wider ${
                                status.isInProgress ? 'bg-blue-100 text-blue-700' :
                                    status.isCompleted ? 'bg-emerald-100 text-emerald-700' : 'bg-orange-100 text-orange-700'
                                }">
                                        ${status.isInProgress ? '<span class="h-1.5 w-1.5 rounded-full bg-blue-500 animate-pulse"></span>' : ''}
                                ${status.text}
                                    </span>
                                </div>
                                
                                <div class="space-y-2.5 mt-4 text-sm font-medium text-slate-600">
                                    <div class="flex items-start gap-3">
                                        <div class="mt-0.5 rounded-lg bg-slate-100 p-1.5 text-slate-400 shrink-0">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                        </div>
                                        <p class="leading-snug">
                                            <span class="block text-slate-900">${customer?.location || 'Dirección no registrada'}</span>
                                            ${customer?.reference ? `<span class="block mt-0.5 text-xs text-slate-500">Ref: ${customer.reference}</span>` : ''}
                                        </p>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <div class="rounded-lg bg-blue-50 p-1.5 text-blue-500 shrink-0">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                        </div>
                                        <a href="tel:${customer?.phone}" class="text-blue-600 font-bold hover:underline">${customer?.phone || 'Sin teléfono'}</a>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- ZONA DE ACCIÓN -->
                            <div class="p-4 pl-5 ${status.isCompleted ? 'bg-white' : 'bg-slate-50'}">
                                ${status.isPending ? `
                                    <button onclick="window.handleStartService('${route.id}', '${service.service_id}')" class="flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-4 text-sm font-bold text-white shadow-md shadow-slate-900/20 transition active:scale-[0.98]">
                                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                        Iniciar Instalación
                                    </button>
                                ` : status.isInProgress ? `
                                    <button onclick="window.handleOpenCompleteModal('${service.service_id}')" class="flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-4 text-sm font-bold text-white shadow-md shadow-emerald-500/30 transition active:scale-[0.98] animate-pulse">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                        Marcar como Terminado
                                    </button>
                                ` : `
                                    <div class="flex w-full items-center justify-center gap-2 py-1 text-sm font-bold text-emerald-600">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        Servicio completado
                                    </div>
                                    ${service.notes ? `
                                        <div class="mt-3 rounded-xl bg-slate-50 p-3 border border-slate-100">
                                            <p class="text-xs font-bold text-slate-400 mb-1">OBSERVACIONES:</p>
                                            <p class="text-sm font-medium text-slate-700 italic">"${service.notes}"</p>
                                        </div>
                                    ` : ''}
                                `}
                            </div>
                        </div>
                        `;
                            }).join('');
                        } else {
                        container.innerHTML = `
                        <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-white p-10 text-center">
                            <span class="text-3xl mb-3">📁</span>
                            <p class="text-slate-500 font-medium">No hay servicios asignados.</p>
                        </div>
                    `;
                        }

                    } catch (error) {
                    container.innerHTML = `
                    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-center">
                        <p class="text-sm font-bold text-red-700">Error al descargar datos</p>
                        <button onclick="window.location.reload()" class="mt-3 text-xs font-bold underline text-red-600">Intentar de nuevo</button>
                    </div>
                `;
                    }
                }

            // =====================================
            // ACCIONES DE BOTONES
            // =====================================

            window.handleStartService = async (rId: string, sId: string) => {
                try {
                    await startService(rId, sId);
                    loadRouteDetails();
                    } catch (error) {
                    alert(error instanceof Error ? error.message : "Error al iniciar el servicio");
                    }
                };

            window.handleOpenCompleteModal = (sId: string) => {
                currentServiceId = sId;
                notesInput.value = "";
                modal?.classList.remove("hidden");
                };

            cancelModalBtn?.addEventListener("click", () => {
                modal?.classList.add("hidden");
                currentServiceId = null;
                });

            confirmCompleteBtn?.addEventListener("click", async () => {
                if (!routeId || !currentServiceId) return;

                try {
                    confirmCompleteBtn.disabled = true;
                    confirmCompleteBtn.innerHTML = `
                    <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Procesando...
                `;

                    await completeService(routeId, currentServiceId, notesInput.value.trim());

                    modal?.classList.add("hidden");
                    loadRouteDetails();

                    } catch (error) {
                    alert(error instanceof Error ? error.message : "Error al completar el servicio");
                    } finally {
                    confirmCompleteBtn.disabled = false;
                    confirmCompleteBtn.textContent = "Confirmar y Terminar";
                    }
                });

            declare global {
                interface Window {
                    handleStartService: (rId: string, sId: string) => void;
                    handleOpenCompleteModal: (sId: string) => void;
                    }
                }

            loadRouteDetails();
    </script>
</Layout>