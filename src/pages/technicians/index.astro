---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Técnicos">

    <main class="min-h-screen bg-slate-50/50 pb-16">

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">

            <!-- MENSAJE DE NOTIFICACIÓN -->
            <div
                    id="message"
                    class="mb-6 hidden rounded-2xl p-4 text-sm font-medium shadow-sm transition-all"
            ></div>

            <!-- CABECERA -->
            <header class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <a href="/" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-orange-600 transition-colors">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Volver a dashboard
                    </a>
                    <div class="flex items-center gap-2 mb-2">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-violet-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-violet-500"></span>
                        </span>
                        <span class="text-xs font-bold uppercase tracking-widest text-violet-600">Equipo Técnico</span>
                    </div>
                    <h1 class="text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Técnicos registrados
                    </h1>
                    <p class="mt-2 text-base text-slate-500 max-w-xl">
                        Administra y monitorea al personal técnico.
                    </p>
                </div>

                <a
                        href="/technicians/new"
                        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-orange-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-orange-500/30 transition-all hover:bg-orange-700 hover:shadow-lg hover:shadow-orange-500/40 active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600"
                >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                    <span>Nuevo técnico</span>
                </a>
            </header>

            <!-- TARJETAS RÁPIDAS DE RESUMEN (MÉTRICAS) -->
            <div class="mb-10 grid grid-cols-1 gap-5 sm:grid-cols-3">

                <!-- Tarjeta: Total -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Técnicos</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-50 text-violet-600 ring-1 ring-inset ring-violet-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-total" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Activos -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg hover:ring-emerald-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Operativos</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-100">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-active" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>

                <!-- Tarjeta: Inactivos -->
                <div class="relative overflow-hidden rounded-2xl bg-white p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] ring-1 ring-slate-200/50 transition-all hover:shadow-lg hover:ring-slate-300">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Bajas</span>
                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-500 ring-1 ring-inset ring-slate-200">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                        </div>
                    </div>
                    <div id="stat-inactive" class="mt-4 text-4xl font-black text-slate-900">0</div>
                </div>
            </div>

            <!-- BUSCADOR -->
            <div class="mb-6 rounded-2xl bg-white p-4 shadow-sm border border-slate-200/80">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-400">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </span>
                    <input
                            id="search"
                            type="search"
                            placeholder="Buscar técnico por nombre o número telefónico..."
                            class="w-full rounded-xl border border-slate-200 bg-slate-50/50 py-3.5 pl-11 pr-4 text-sm text-slate-800 placeholder-slate-400 outline-none transition focus:border-orange-500 focus:bg-white focus:ring-2 focus:ring-orange-500/20"
                    />
                </div>
            </div>

            <!-- TABLA Y PAGINACIÓN -->
            <div class="overflow-hidden rounded-2xl bg-white shadow-[0_2px_15px_-3px_rgba(0,0,0,0.07),0_10px_20px_-2px_rgba(0,0,0,0.04)] ring-1 ring-slate-200/50 flex flex-col">
                <div class="overflow-x-auto overflow-y-auto max-h-[500px] scrollbar-thin scrollbar-thumb-slate-300 scrollbar-track-transparent">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="sticky top-0 z-10 bg-slate-50 border-b border-slate-200 shadow-sm">
                        <tr>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500 backdrop-blur-sm">
                                Técnico
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500 backdrop-blur-sm">
                                Teléfono
                            </th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-slate-500 backdrop-blur-sm">
                                Estado
                            </th>
                            <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-slate-500 backdrop-blur-sm">
                                Acciones
                            </th>
                        </tr>
                        </thead>
                        <tbody
                                id="technicians-body"
                                class="divide-y divide-slate-100 bg-white"
                        >
                        </tbody>
                    </table>
                </div>

                <!-- CONTROLES DE PAGINACIÓN -->
                <div id="pagination-wrapper" class="hidden flex items-center justify-between border-t border-slate-100 bg-slate-50/80 px-6 py-4">
                    <div class="hidden sm:block">
                        <p class="text-sm text-slate-500">
                            Mostrando <span id="page-start" class="font-bold text-slate-900">0</span> a <span id="page-end" class="font-bold text-slate-900">0</span> de <span id="page-total" class="font-bold text-slate-900">0</span> técnicos
                        </p>
                    </div>
                    <div class="flex flex-1 justify-between sm:justify-end gap-3">
                        <button
                                id="prev-page"
                                type="button"
                                class="inline-flex items-center justify-center rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-slate-900 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Anterior
                        </button>
                        <button
                                id="next-page"
                                type="button"
                                class="inline-flex items-center justify-center rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-slate-900 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                        >
                            Siguiente
                        </button>
                    </div>
                </div>
            </div>

            <!-- VACÍO -->
            <div
                    id="empty"
                    class="mt-8 hidden rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center shadow-sm"
            >
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 ring-8 ring-slate-50/50">
                    <svg class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <h3 class="mt-6 text-xl font-bold text-slate-900">
                    No se encontraron técnicos
                </h3>
                <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                    Intenta cambiar los términos de búsqueda o registra a tu primer técnico en el sistema para comenzar a asignar rutas.
                </p>
                <button onclick="document.getElementById('search').value=''; document.getElementById('search').dispatchEvent(new Event('input'))" class="mt-6 inline-flex items-center text-sm font-semibold text-orange-600 hover:text-orange-700">
                    Limpiar búsqueda <span aria-hidden="true" class="ml-1">→</span>
                </button>
            </div>

            <!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN -->
            <dialog id="deleteModal" class="m-auto fixed inset-0 backdrop:bg-slate-900/50 rounded-2xl shadow-2xl border border-slate-100 p-0 w-full max-w-md backdrop-blur-sm transition-all open:animate-in open:fade-in open:zoom-in-95">
                <div class="p-6 text-center bg-white">
                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-red-100">
                        <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    </div>
                    <h3 class="mb-2 text-lg font-bold text-slate-900">
                        ¿Eliminar técnico?
                    </h3>
                    <p class="mb-6 text-sm text-slate-500">Esta acción no se puede deshacer. El técnico será borrado permanentemente del sistema.</p>
                    <div class="flex justify-center gap-3">
                        <button id="cancelDeleteBtn" type="button" class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-all hover:bg-slate-50 active:scale-95">
                            Cancelar
                        </button>
                        <button id="confirmDeleteBtn" type="button" class="rounded-xl bg-red-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm shadow-red-500/30 transition-all hover:bg-red-700 hover:shadow-red-500/40 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
                            Sí, eliminar
                        </button>
                    </div>
                </div>
            </dialog>

        </section>

    </main>


    <script>
        import {
            getTechnicians,
            updateTechnicianActive,
            deleteTechnician,
        } from "../../services/api";

        import type { Technician } from "../../types/technician";

        const body = document.querySelector<HTMLTableSectionElement>("#technicians-body");
        const searchInput = document.querySelector<HTMLInputElement>("#search");
        const empty = document.querySelector<HTMLDivElement>("#empty");
        const message = document.querySelector<HTMLDivElement>("#message");

        // Elementos de Paginación
        const paginationWrapper = document.getElementById("pagination-wrapper");
        const prevPageBtn = document.getElementById("prev-page") as HTMLButtonElement;
        const nextPageBtn = document.getElementById("next-page") as HTMLButtonElement;
        const pageStartEl = document.getElementById("page-start");
        const pageEndEl = document.getElementById("page-end");
        const pageTotalEl = document.getElementById("page-total");

        // Elementos del Modal
        const deleteModal = document.getElementById("deleteModal") as HTMLDialogElement;
        const confirmDeleteBtn = document.getElementById("confirmDeleteBtn") as HTMLButtonElement;
        const cancelDeleteBtn = document.getElementById("cancelDeleteBtn") as HTMLButtonElement;

        let technicianIdToDelete: string | null = null;
        let technicians: Technician[] = [];
        let currentPage = 1;
        const itemsPerPage = 5;

        // Elementos de Estadísticas
        const statTotal = document.getElementById("stat-total");
        const statActive = document.getElementById("stat-active");
        const statInactive = document.getElementById("stat-inactive");

        const API_URL = import.meta.env.PUBLIC_API_URL ?? "http://127.0.0.1:8000/api/v1";


        function escapeHtml(value: string): string {
            const div = document.createElement("div");
            div.textContent = value;
            return div.innerHTML;
        }

        function getInitials(name: string): string {
            return name
                .split(" ")
                .filter(Boolean)
                .slice(0, 2)
                .map((word) => word[0].toUpperCase())
                .join("");
        }

        function getAvatarColor(name: string): string {
            const colors = [
                'bg-blue-100 text-blue-700', 'bg-cyan-100 text-cyan-700',
                'bg-teal-100 text-teal-700', 'bg-emerald-100 text-emerald-700',
                'bg-fuchsia-100 text-fuchsia-700', 'bg-indigo-100 text-indigo-700'
            ];
            const charCode = name.charCodeAt(0) || 0;
            return colors[charCode % colors.length];
        }

        function updateStats() {
            if (statTotal) statTotal.textContent = String(technicians.length);
            if (statActive) statActive.textContent = String(technicians.filter(t => t.active).length);
            if (statInactive) statInactive.textContent = String(technicians.filter(t => !t.active).length);
        }

        async function loadTechnicians() {
            try {
                technicians = await getTechnicians();
                updateStats();
                renderTechnicians();
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudieron cargar los técnicos.",
                    true,
                );
            }
        }

        function renderTechnicians(search = "") {
            if (!body || !empty) {
                return;
            }

            const query = search.trim().toLowerCase();

            // 1. Filtrar los técnicos
            const filtered = technicians.filter(
                (technician) =>
                    technician.name.toLowerCase().includes(query) ||
                    (technician.phone ?? "").toLowerCase().includes(query),
            );

            body.innerHTML = "";

            if (filtered.length === 0) {
                empty.classList.remove("hidden");
                paginationWrapper?.classList.add("hidden");
                return;
            }

            empty.classList.add("hidden");
            paginationWrapper?.classList.remove("hidden");

            // 2. Lógica de Paginación
            const totalItems = filtered.length;
            const totalPages = Math.ceil(totalItems / itemsPerPage);

            if (currentPage > totalPages) currentPage = Math.max(1, totalPages);
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

            const paginatedTechnicians = filtered.slice(startIndex, endIndex);

            // 3. Renderizar
            body.innerHTML = paginatedTechnicians.map((technician) => technicianRow(technician)).join("");

            // 4. Controles de Paginación
            if (pageStartEl) pageStartEl.textContent = String(startIndex + 1);
            if (pageEndEl) pageEndEl.textContent = String(endIndex);
            if (pageTotalEl) pageTotalEl.textContent = String(totalItems);

            if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
            if (nextPageBtn) nextPageBtn.disabled = currentPage === totalPages;

            addEvents();
        }

        // --- Eventos de Paginación ---
        prevPageBtn?.addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderTechnicians(searchInput?.value ?? "");
                document.querySelector('.overflow-y-auto')?.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        nextPageBtn?.addEventListener("click", () => {
            currentPage++;
            renderTechnicians(searchInput?.value ?? "");
            document.querySelector('.overflow-y-auto')?.scrollTo({ top: 0, behavior: 'smooth' });
        });


        function statusSwitch(technician: Technician): string {
            const active = technician.active;

            return `
                <div class="flex items-center gap-3">
                    <button
                        type="button"
                        role="switch"
                        aria-checked="${active}"
                        aria-label="${active ? "Desactivar" : "Activar"} a ${escapeHtml(technician.name)}"
                        data-action="toggle"
                        data-id="${technician.id}"
                        data-active="${active}"
                        class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full transition-colors duration-200 ease-in-out focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 disabled:cursor-wait disabled:opacity-50 ${
                active ? "bg-emerald-500" : "bg-slate-300"
            }"
                    >
                        <span
                            aria-hidden="true"
                            class="inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition-transform duration-200 ease-in-out ${
                active ? "translate-x-5" : "translate-x-0.5"
            }"
                        ></span>
                    </button>
                    <span class="w-16 text-xs font-bold whitespace-nowrap ${
                active ? "text-emerald-700" : "text-slate-500"
            }">
                        ${active ? "Activo" : "Inactivo"}
                    </span>
                </div>
            `;
        }

        function technicianRow(technician: Technician & { photo_url?: string | null; photo?: string | null }): string {
            const photoUrl = technician.photo_url || technician.photo || `${API_URL}/technicians/${technician.id}/photo`;
            const avatarColor = getAvatarColor(technician.name);

            const avatarHtml = `
                <img
                    src="${escapeHtml(photoUrl)}"
                    alt="${escapeHtml(technician.name)}"
                    class="h-10 w-10 shrink-0 rounded-full object-cover ring-2 ring-white shadow-sm"
                    onerror="this.onerror=null; this.replaceWith(Object.assign(document.createElement('span'), {className: 'flex h-10 w-10 shrink-0 items-center justify-center rounded-full ${avatarColor} text-sm font-black shadow-sm ring-2 ring-white', textContent: '${getInitials(technician.name)}'}));"
                />
            `;

            // OBTENER ARREGLO DE ESPECIALIDADES O DEFAULT
            const specialtiesArray = technician.specialties && technician.specialties.length > 0
                ? technician.specialties
                : ["General"];

            // CREAR ETIQUETAS HTML PARA CADA ESPECIALIDAD
            const badgesHtml = specialtiesArray.map(spec => `
                <div class="inline-flex items-center gap-1 rounded-md bg-orange-50 px-2 py-0.5 text-[10px] font-bold tracking-wider text-orange-600 ring-1 ring-inset ring-orange-600/20">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    ${escapeHtml(spec)}
                </div>
            `).join('');

            return `
                <tr class="group transition-colors hover:bg-slate-50">

                    <!-- TÉCNICO (FOTO + NOMBRE + ESPECIALIDAD MÚLTIPLE) -->
                    <td class="px-6 py-5">
                        <div class="flex items-center gap-4">
                            ${avatarHtml}
                            <div>
                                <div class="font-bold text-slate-800">
                                    ${escapeHtml(technician.name)}
                                </div>
                                <div class="mt-1.5 flex flex-wrap gap-1.5">
                                    ${badgesHtml}
                                </div>
                            </div>
                        </div>
                    </td>

                    <td class="px-6 py-5">
                        <div class="flex items-center gap-2 text-sm font-medium text-slate-600">
                            <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                            <span class="tabular-nums">${escapeHtml(technician.phone ?? "Sin teléfono")}</span>
                        </div>
                    </td>

                    <td class="px-6 py-5">
                        ${statusSwitch(technician)}
                    </td>

                    <td class="px-6 py-5">
                        <div class="flex items-center justify-end gap-2 opacity-80 transition-opacity group-hover:opacity-100">
                            <a
                                href="/technicians/edit?id=${technician.id}"
                                class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-slate-50 hover:text-blue-600 active:scale-95"
                                title="Editar perfil del técnico"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </a>

                            <button
                                type="button"
                                data-action="delete"
                                data-id="${technician.id}"
                                class="inline-flex items-center justify-center rounded-xl bg-white p-2 text-slate-400 shadow-sm ring-1 ring-inset ring-slate-200 transition-all hover:bg-red-50 hover:text-red-600 hover:ring-red-200 active:scale-95"
                                title="Eliminar técnico"
                            >
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </td>

                </tr>
            `;
        }

        function addEvents() {
            document.querySelectorAll<HTMLButtonElement>("[data-action='toggle']").forEach((button) => {
                button.addEventListener("click", () =>
                    toggleTechnician(
                        button,
                        button.dataset.id,
                        button.dataset.active === "true",
                    ),
                );
            });

            document.querySelectorAll<HTMLButtonElement>("[data-action='delete']").forEach((button) => {
                button.addEventListener("click", () => {
                    technicianIdToDelete = button.dataset.id || null;
                    if (technicianIdToDelete) {
                        deleteModal.showModal();
                    }
                });
            });
        }

        // Lógica del Modal
        cancelDeleteBtn?.addEventListener("click", () => {
            deleteModal.close();
            technicianIdToDelete = null;
        });

        confirmDeleteBtn?.addEventListener("click", async () => {
            if (!technicianIdToDelete) return;

            const originalText = confirmDeleteBtn.textContent || "Sí, eliminar";
            confirmDeleteBtn.textContent = "Eliminando...";
            confirmDeleteBtn.disabled = true;

            try {
                await deleteTechnician(technicianIdToDelete);
                technicians = technicians.filter((technician) => technician.id !== technicianIdToDelete);

                updateStats();
                const totalItems = technicians.length;
                const totalPages = Math.ceil(totalItems / itemsPerPage);
                if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

                renderTechnicians(searchInput?.value ?? "");
                showMessage("Técnico eliminado de la base de datos.", false);
            } catch (error) {
                showMessage(
                    error instanceof Error ? error.message : "No se pudo eliminar el técnico.",
                    true,
                );
            } finally {
                deleteModal.close();
                technicianIdToDelete = null;
                confirmDeleteBtn.textContent = originalText;
                confirmDeleteBtn.disabled = false;
            }
        });

        async function toggleTechnician(button: HTMLButtonElement, technicianId?: string, currentActive = false) {
            if (!technicianId) return;
            button.disabled = true;

            try {
                const updated = await updateTechnicianActive(technicianId, !currentActive);
                technicians = technicians.map((technician) => technician.id === updated.id ? updated : technician);

                updateStats();
                renderTechnicians(searchInput?.value ?? "");
                showMessage(`Técnico ${!currentActive ? 'activado' : 'desactivado'} correctamente.`, false);
            } catch (error) {
                button.disabled = false;
                showMessage(
                    error instanceof Error ? error.message : "No se pudo actualizar el estado.",
                    true,
                );
            }
        }

        function showMessage(text: string, isError: boolean) {
            if (!message) return;

            message.innerHTML = `
                <div class="flex items-center gap-3">
                    ${isError
                ? `<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
                : `<svg class="h-5 w-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
            }
                    <p>${text}</p>
                </div>
            `;
            message.className = isError
                ? "mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 shadow-sm"
                : "mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800 shadow-sm";
            message.classList.remove("hidden");

            setTimeout(() => {
                message.classList.add("hidden");
            }, 4000);
        }

        searchInput?.addEventListener("input", () => {
            currentPage = 1;
            renderTechnicians(searchInput.value);
        });

        loadTechnicians();
    </script>
</Layout>