---

<aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full border-r border-slate-200 bg-white transition-transform duration-300 lg:translate-x-0"
>

    <div class="flex h-full flex-col">

        <!-- Logo -->

        <div class="border-b border-slate-200 px-6 py-6">

            <h1 class="text-xl font-bold text-slate-900">
                Rutas Digitales
            </h1>

            <p class="mt-1 text-xs text-slate-500">
                Gestión técnica
            </p>

        </div>


        <!-- Navegación -->

        <nav class="flex-1 space-y-1 p-4">

            <a
                    href="/"
                    class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
            >
                🏠 Dashboard
            </a>


            <a
                    href="/routes"
                    class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
            >
                🗺️ Rutas
            </a>


            <a
                    href="/customers"
                    class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
            >
                👥 Clientes
            </a>


            <a
                    href="/technicians"
                    class="block rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100"
            >
                👨‍🔧 Técnicos
            </a>

        </nav>


        <!-- Footer -->

        <div class="border-t border-slate-200 p-4">

            <div class="rounded-xl bg-slate-50 p-4">

                <p class="text-xs font-medium text-slate-500">
                    Sistema
                </p>

                <p class="mt-1 text-sm font-semibold text-slate-700">
                    v0.1.0
                </p>

            </div>

        </div>

    </div>

</aside>