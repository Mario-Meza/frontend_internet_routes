---
// src/layouts/Layout.astro
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import MobileMenuButton from "../components/MobileMenuButton.astro";

interface Props {
    title?: string;
    hideMenu?: boolean; // <-- Agregamos esta línea para que TypeScript no marque error
}

const { title = "Rutas Digitales", hideMenu = false } = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">

<!-- BARRA LATERAL (Admin) -->
<Sidebar />

<!-- ÁREA PRINCIPAL -->
<div id="main-content" class={hideMenu ? "" : "lg:pl-64"}>

    <!-- CABECERA MÓVIL (Menú hamburguesa estilizado) -->
    <header
            id="mobile-header"
            class={`sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur-md shadow-sm lg:hidden ${hideMenu ? "hidden" : ""}`}
    >
        <div class="flex items-center justify-between px-4 py-3.5 sm:px-6">
            <div class="flex items-center gap-3.5">
                <MobileMenuButton />
                <div>
                    <p class="text-base font-black tracking-tight text-slate-900 leading-none">
                        {title}
                    </p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-orange-600">
                        Rutas Digitales
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENIDO DE LA PÁGINA -->
    <slot />

</div>

<script>
    import { protectAdminRoute } from "../utils/auth";

    const currentPath = window.location.pathname;

    // 1. Proteger rutas de administración
    if (!currentPath.startsWith("/panel") && !currentPath.startsWith("/login") && currentPath !== "/") {
        protectAdminRoute();
    }

    // 2. Controlar la visibilidad del Sidebar y Cabecera Móvil
    const sidebar = document.getElementById("sidebar");
    const mainContent = document.getElementById("main-content");
    const mobileHeader = document.getElementById("mobile-header");

    const isLogin = currentPath.startsWith("/login");
    const isPanel = currentPath.startsWith("/panel");

    if (isLogin || isPanel) {
        if (sidebar) {
            sidebar.classList.add("hidden");
            sidebar.style.display = "none";
        }
        if (mobileHeader) {
            mobileHeader.classList.add("hidden");
            mobileHeader.style.display = "none";
        }
        if (mainContent) {
            mainContent.classList.remove("lg:pl-64", "lg:ml-64");
        }
    } else {
        if (sidebar) {
            sidebar.classList.remove("hidden");
            sidebar.style.display = "";
        }
        if (mobileHeader) {
            mobileHeader.classList.remove("hidden");
            mobileHeader.style.display = "";
        }
        if (mainContent) {
            mainContent.classList.add("lg:pl-64");
        }
    }

    // 3. Evento para botones de cerrar sesión
    const logoutBtns = document.querySelectorAll(".logout-button");
    logoutBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            localStorage.removeItem("auth_token");
            localStorage.removeItem("user_role");
            window.location.href = "/login";
        });
    });
</script>
<script lang="ts">
    // JS Puro: Sin lang="ts" ni tipos
    function initWebSocket() {
        const token = localStorage.getItem('auth_token');
        const role = localStorage.getItem('user_role');

        console.log("🛠️ Inicializando WebSocket. Rol detectado:", role);

        if (token && role === 'technician') {
            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
                }).join(''));

                const decodedToken = JSON.parse(jsonPayload);

                // 1. Imprimimos el token completo en la consola por si acaso
                console.log("Token decodificado:", decodedToken);

                // 2. FIX: Buscamos primero el ID de MongoDB, ignorando el correo electrónico
                let technicianId = decodedToken._id || decodedToken.id || decodedToken.user_id;

                // Si por alguna razón el ID estaba en 'sub' y NO es un correo, lo usamos
                if (!technicianId && decodedToken.sub && !decodedToken.sub.includes('@')) {
                    technicianId = decodedToken.sub;
                }
                console.log("🆔 ID de técnico detectado:", technicianId);

                if (technicianId) {
                    const host = window.location.hostname;

                    // En JS puro podemos adjuntar variables a window directamente
                    if (window.appWebSocket) {
                        window.appWebSocket.close();
                    }

                    const wsUrl = `ws://${host}:8000/ws/dashboard/${technicianId}`;
                    console.log("🔗 Conectando a:", wsUrl);

                    window.appWebSocket = new WebSocket(wsUrl);

                    window.appWebSocket.onopen = () => {
                        console.log("🟢 Conectado exitosamente al WebSocket del Backend");
                    };

                    window.appWebSocket.onmessage = (event) => {
                        console.log("📩 Mensaje recibido:", event.data);
                        const data = JSON.parse(event.data);

                        if (data.event === "NEW_ROUTE_ASSIGNED") {
                            alert(`📢 ¡Nueva ruta asignada!`);
                            window.location.reload();
                        }
                        else if (data.event === "NEW_SERVICE_ADDED") {
                            alert(`⚠️ Se ha añadido un nuevo cliente a tu ruta actual.`);
                            window.location.reload();
                        }
                        else if (data.event === "SERVICE_DELETED") {
                            alert(`🗑️ Se ha cancelado y retirado un cliente de tu ruta.`);
                            window.location.reload();
                        }
                        else if (data.event === "ROUTE_DELETED") {
                            alert(`🚨 Tu ruta actual ha sido eliminada por la oficina.`);
                            if (window.location.pathname.includes('/panel/ruta')) {
                                window.location.href = '/panel';
                            } else {
                                window.location.reload();
                            }
                        }
                        // ---> NUEVO EVENTO DE CANCELACIÓN <---
                        else if (data.event === "ROUTE_CANCELED") {
                            alert(`🚫 La oficina ha cancelado tu ruta actual.`);
                            // Solo recargamos: tu vista panel/ruta.astro ya tiene la lógica para mostrar
                            // los servicios de color rojo y deshabilitar los botones cuando está cancelada.
                            window.location.reload();
                        }
                    };

                    window.appWebSocket.onclose = () => {
                        console.log("🔴 Conexión WebSocket cerrada.");
                    };

                    window.appWebSocket.onerror = (error) => {
                        console.error("❌ Error en WebSocket:", error);
                    };
                }
            } catch (e) {
                console.error("❌ Error procesando el token para WebSocket:", e);
            }
        } else {
            console.log("🛑 Conexión WebSocket cancelada: No hay token o el usuario no es técnico.");
        }
    }

    document.addEventListener('DOMContentLoaded', initWebSocket);
    document.addEventListener('astro:page-load', initWebSocket);
</script>
</body>
</html>