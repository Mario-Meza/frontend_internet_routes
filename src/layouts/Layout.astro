---
// src/layouts/Layout.astro
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import MobileMenuButton from "../components/MobileMenuButton.astro";

interface Props {
    title?: string;
    hideMenu?: boolean; // <-- Agregamos esta línea para que TypeScript no marque error
}

const { title = "Rutas Digitales", hideMenu = false } = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">

<!-- BARRA LATERAL (Admin) -->
<Sidebar />

<!-- ÁREA PRINCIPAL -->
<div id="main-content" class={hideMenu ? "" : "lg:pl-64"}>

    <!-- CABECERA MÓVIL (Menú hamburguesa estilizado) -->
    <header
            id="mobile-header"
            class={`sticky top-0 z-30 border-b border-slate-200/80 bg-white/90 backdrop-blur-md shadow-sm lg:hidden ${hideMenu ? "hidden" : ""}`}
    >
        <div class="flex items-center justify-between px-4 py-3.5 sm:px-6">
            <div class="flex items-center gap-3.5">
                <MobileMenuButton />
                <div>
                    <p class="text-base font-black tracking-tight text-slate-900 leading-none">
                        {title}
                    </p>
                    <p class="mt-1 text-[11px] font-bold uppercase tracking-wider text-orange-600">
                        Rutas Digitales
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTENIDO DE LA PÁGINA -->
    <slot />

</div>

<script>
    import {
        clearSession,
        decodeToken,
        getToken,
        protectAdminRoute,
        protectTechnicianRoute,
    } from "../utils/auth";
    import { getWebSocketUrl } from "../services/api";

    const currentPath = window.location.pathname;
    const isLogin = currentPath.startsWith("/login");
    const isPanel = currentPath.startsWith("/panel");

    // 1. Proteger rutas según el rol: /panel es del técnico, todo lo demás (excepto /login) del admin.
    //    (Esto solo redirige; el backend es quien valida el acceso real con el JWT.)
    if (isPanel) {
        protectTechnicianRoute();
    } else if (!isLogin) {
        protectAdminRoute();
    }

    // 2. Controlar la visibilidad del Sidebar y Cabecera Móvil
    const sidebar = document.getElementById("sidebar");
    const mainContent = document.getElementById("main-content");
    const mobileHeader = document.getElementById("mobile-header");

    if (isLogin || isPanel) {
        if (sidebar) {
            sidebar.classList.add("hidden");
            sidebar.style.display = "none";
        }
        if (mobileHeader) {
            mobileHeader.classList.add("hidden");
            mobileHeader.style.display = "none";
        }
        if (mainContent) {
            mainContent.classList.remove("lg:pl-64", "lg:ml-64");
        }
    } else {
        if (sidebar) {
            sidebar.classList.remove("hidden");
            sidebar.style.display = "";
        }
        if (mobileHeader) {
            mobileHeader.classList.remove("hidden");
            mobileHeader.style.display = "";
        }
        if (mainContent) {
            mainContent.classList.add("lg:pl-64");
        }
    }

    // 3. Evento para botones de cerrar sesión
    const logoutBtns = document.querySelectorAll(".logout-button");
    logoutBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            clearSession();
            window.location.href = "/login";
        });
    });

    // 4. WebSocket de notificaciones (solo técnicos)
    let socket: WebSocket | null = null;

    function initWebSocket() {
        const token = getToken();
        const payload = token ? decodeToken(token) : null;

        // El ID del técnico y su rol salen del JWT (el servidor vuelve a validarlos al conectar)
        if (!token || !payload || payload.role !== "technician" || !payload.id) {
            return;
        }

        socket?.close();
        socket = new WebSocket(getWebSocketUrl(payload.id, token));

        socket.onmessage = (event) => {
            let data: { event?: string };
            try {
                data = JSON.parse(event.data);
            } catch {
                return;
            }

            switch (data.event) {
                case "NEW_ROUTE_ASSIGNED":
                    alert(`📢 ¡Nueva ruta asignada!`);
                    window.location.reload();
                    break;

                case "NEW_SERVICE_ADDED":
                    alert(`⚠️ Se ha añadido un nuevo cliente a tu ruta actual.`);
                    window.location.reload();
                    break;

                case "SERVICE_DELETED":
                    alert(`🗑️ Se ha cancelado y retirado un cliente de tu ruta.`);
                    window.location.reload();
                    break;

                case "ROUTE_DELETED":
                    alert(`🚨 Tu ruta actual ha sido eliminada por la oficina.`);
                    if (window.location.pathname.includes("/panel/ruta")) {
                        window.location.href = "/panel";
                    } else {
                        window.location.reload();
                    }
                    break;

                case "ROUTE_CANCELED":
                    // Solo recargamos: panel/ruta.astro ya muestra los servicios en rojo
                    // y deshabilita los botones cuando la ruta está cancelada.
                    alert(`🚫 La oficina ha cancelado tu ruta actual.`);
                    window.location.reload();
                    break;
            }
        };

        socket.onerror = (error) => {
            console.error("❌ Error en WebSocket:", error);
        };
    }

    initWebSocket();
</script>
</body>
</html>