---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import MobileMenuButton from "../components/MobileMenuButton.astro";

interface Props {
    title?: string;
}

const {
    title = "Rutas Digitales",
} = Astro.props;
---

<!doctype html>

<html lang="es">

<head>

    <meta charset="UTF-8" />

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

</head>


<body class="min-h-screen bg-slate-100 text-slate-900">

<Sidebar />


<!-- Área principal -->

<div class="lg:pl-64">

    <!-- Header móvil -->

    <header
            class="sticky top-0 z-30 border-b border-slate-200 bg-white"
    >

        <div class="flex items-center gap-4 px-6 py-4">

            <MobileMenuButton />

            <div>

                <p class="text-sm font-semibold text-slate-900">
                    {title}
                </p>

                <p class="text-xs text-slate-500">
                    Sistema de rutas técnicas
                </p>

            </div>

        </div>

    </header>


    <slot />

</div>
<script>
    import { protectAdminRoute } from "../utils/auth";

    const currentPath = window.location.pathname;

    // 1. Proteger rutas de administración
    if (!currentPath.startsWith("/panel") && !currentPath.startsWith("/login") && currentPath !== "/") {
        protectAdminRoute();
    }

    // 2. Controlar la visibilidad del Sidebar y el Layout
    const sidebar = document.getElementById("sidebar");
    const mainContent = document.querySelector('.lg\\:pl-64') || document.querySelector('.lg\\:ml-64');

    const isLogin = currentPath.startsWith("/login");
    const isPanel = currentPath.startsWith("/panel");

    if (isLogin || isPanel) {
        // SI ES LOGIN O PANEL TÉCNICO: Ocultamos menú
        if (sidebar) {
            sidebar.classList.add("hidden");
            sidebar.style.display = 'none'; // Reforzamos ocultarlo
        }
        if (mainContent) mainContent.classList.remove("lg:pl-64", "lg:ml-64");
    } else {
        // SI ES ADMINISTRADOR (Dashboard, Rutas, Clientes...): Mostramos menú
        if (sidebar) {
            sidebar.classList.remove("hidden");
            sidebar.style.display = 'block'; // Reforzamos mostrarlo
        }
        if (mainContent) mainContent.classList.add("lg:pl-64");
    }

    // 3. Evento para botones de cerrar sesión
    const logoutBtns = document.querySelectorAll('.logout-button');
    logoutBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            localStorage.removeItem("auth_token");
            localStorage.removeItem("user_role");
            window.location.href = "/login";
        });
    });
</script>

</body>

</html>